# A local-only development database. Never commit a real password or production URL.
DATABASE_URL="postgresql://baseer_app:replace_me@127.0.0.1:5433/baseer_erp?schema=public"
BASEER_API_PORT="5200"
IDENTITY_JWT_SECRET="replace-with-a-unique-local-secret-of-at-least-32-bytes"
# The code of the private installation tenant. Server-only: never expose it
# to the browser or ask employees to enter it at sign-in.
BASEER_SYSTEM_TENANT_CODE="baseer-private"
# Optional: default access is 900 seconds and refresh is 2,592,000 seconds.
# IDENTITY_ACCESS_TOKEN_TTL_SECONDS="900"
# IDENTITY_REFRESH_TOKEN_TTL_SECONDS="2592000"

# Optional Decision Intelligence workers. Enable exactly one API/worker instance.
# The weather researcher reads its four fixed NCM pages in code; it needs no URL
# or API key. Other sources use only their source-specific approved JSON adapter,
# never a search page or browser-controlled URL.
# BASEER_CONTEXT_IMPORT_ENABLED="true"
# BASEER_CONTEXT_RESEARCH_ENABLED="true"
# BASEER_SPL_FIXTURES_DOCUMENT_URL="https://www.spl.com.sa/..."

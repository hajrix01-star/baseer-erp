# A local-only development database. Never commit a real password or production URL.
DATABASE_URL="postgresql://baseer_app:replace_me@127.0.0.1:5433/baseer_erp?schema=public"
BASEER_API_PORT="5200"
IDENTITY_JWT_SECRET="replace-with-a-unique-local-secret-of-at-least-32-bytes"
# The code of the private installation tenant. Server-only: never expose it
# to the browser or ask employees to enter it at sign-in.
BASEER_SYSTEM_TENANT_CODE="baseer-private"
# Optional: default access is 900 seconds and refresh is 2,592,000 seconds.
# IDENTITY_ACCESS_TOKEN_TTL_SECONDS="900"
# IDENTITY_REFRESH_TOKEN_TTL_SECONDS="2592000"

# Optional Decision Intelligence workers. Enable exactly one API/worker instance.
# The weather researcher reads its four fixed NCM pages in code; it needs no URL
# or API key. Other sources use only their source-specific approved JSON adapter,
# never a search page or browser-controlled URL.
# BASEER_CONTEXT_IMPORT_ENABLED="true"
# BASEER_CONTEXT_RESEARCH_ENABLED="true"
# BASEER_SPL_FIXTURES_DOCUMENT_URL="https://www.spl.com.sa/..."

# Owner daily notebook. Enable on exactly one API/worker deployment; a durable
# database lease makes accidental replica overlap safe. It creates the completed
# Riyadh business-day receipt at 12:00 by default.
# BASEER_OWNER_DAILY_BRIEF_SCHEDULER_ENABLED="true"
# BASEER_OWNER_DAILY_BRIEF_SCHEDULE_HOUR="12"
# BASEER_OWNER_DAILY_BRIEF_SCHEDULE_MINUTE="0"

# Live Basira answers for the owner notebook. The provider itself is configured
# and encrypted through Administration; never place an API key in the browser.
# AI_CREDENTIAL_ENCRYPTION_KEY="base64-encoded-32-byte-key"
# BASEER_BASIRA_OWNER_BRIEF_PILOT_ENABLED="true"
# Enables the narrow S2 campaign explanation pilot only after an approved
# provider/privacy decision. Basira receives immutable campaign evidence, not
# live tables, and it cannot publish, spend, or change Finance/Google.
# BASEER_BASIRA_MARKETING_PILOT_ENABLED="true"

# Gmail is disabled unless explicitly enabled. Use a dedicated OAuth Web client
# with the exact callback below registered in Google Cloud. These values stay
# server-only; Baseer never exposes a client secret or a mailbox token.
# BASEER_GMAIL_OAUTH_ENABLED="true"
# BASEER_GMAIL_OAUTH_CLIENT_ID="...apps.googleusercontent.com"
# BASEER_GMAIL_OAUTH_CLIENT_SECRET="..."
# BASEER_GMAIL_OAUTH_REDIRECT_URI="http://localhost:5200/v1/inbound-evidence/gmail/callback"
# BASEER_INBOUND_EVIDENCE_ENCRYPTION_KEY="base64-encoded-32-byte-key"
# BASEER_INBOUND_EVIDENCE_STORAGE_ENCRYPTION_KEY="base64-encoded-32-byte-key"
# BASEER_INBOUND_EVIDENCE_STORAGE_ROOT="storage/inbound-evidence"
# Deliberately off by default. Requires an owner-approved active AI provider
# configured in Administration; never place the provider API key here.
# BASEER_INBOUND_DOCUMENT_INTELLIGENCE_ENABLED="true"
# In production configure an antivirus/scanner endpoint. Without it, attachments
# remain encrypted but QUARANTINED and cannot be downloaded.
# BASEER_DOCUMENT_SCANNER_ENDPOINT="https://scanner.internal/scan"

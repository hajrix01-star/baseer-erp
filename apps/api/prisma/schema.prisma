model FinanceInclusiveLoan {
  id                       String                     @id @default(uuid()) @db.Uuid
  tenantId                 String                     @db.Uuid
  companyId                String                     @db.Uuid
  sourceDocumentNumber     String                     @db.VarChar(160)
  originalAmount           Decimal                    @db.Decimal(18, 4)
  openingOutstandingAmount Decimal                    @db.Decimal(18, 4)
  paidAmount               Decimal                    @default(0) @db.Decimal(18, 4)
  remainingAmount          Decimal                    @db.Decimal(18, 4)
  installmentAmount        Decimal                    @db.Decimal(18, 4)
  termMonths               Int
  firstInstallmentDueDate  DateTime                   @db.Date
  openingBusinessDate      DateTime                   @db.Date
  status                   FinanceInclusiveLoanStatus @default(ACTIVE)
  notes                    String?                    @db.VarChar(2000)
  openingJournalEntryId    String?                    @unique @db.Uuid
  createdAt                DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                   @updatedAt @db.Timestamptz(6)

  company             Company                               @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  openingJournalEntry FinanceJournalEntry?                  @relation("FinanceInclusiveLoanOpeningJournal", fields: [openingJournalEntryId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  payments            FinanceInclusiveLoanPayment[]
  installments        FinanceInclusiveLoanInstallmentPlan[]

  @@unique([id, tenantId, companyId])
  @@unique([companyId, sourceDocumentNumber])
  @@unique([openingJournalEntryId, tenantId, companyId])
  @@index([tenantId, companyId, status, firstInstallmentDueDate])
}

model FinanceInclusiveLoanPayment {
  id             String                            @id @default(uuid()) @db.Uuid
  tenantId       String                            @db.Uuid
  companyId      String                            @db.Uuid
  loanId         String                            @db.Uuid
  vaultId        String                            @db.Uuid
  amount         Decimal                           @db.Decimal(18, 4)
  businessDate   DateTime                          @db.Date
  status         FinanceInclusiveLoanPaymentStatus @default(POSTED)
  reversalOfId   String?                           @unique @db.Uuid
  journalEntryId String?                           @unique @db.Uuid
  createdAt      DateTime                          @default(now()) @db.Timestamptz(6)

  company         Company                      @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  loan            FinanceInclusiveLoan         @relation(fields: [loanId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  vault           FinanceVault                 @relation(fields: [vaultId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  reversalOf      FinanceInclusiveLoanPayment? @relation("FinanceInclusiveLoanPaymentReversal", fields: [reversalOfId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  reversalPayment FinanceInclusiveLoanPayment? @relation("FinanceInclusiveLoanPaymentReversal")
  journalEntry    FinanceJournalEntry?         @relation("FinanceInclusiveLoanPaymentJournal", fields: [journalEntryId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([reversalOfId, tenantId, companyId])
  @@unique([journalEntryId, tenantId, companyId])
  @@index([tenantId, companyId, loanId, businessDate])
}

model FinanceInclusiveLoanInstallmentPlan {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  companyId      String   @db.Uuid
  loanId         String   @db.Uuid
  installmentNo  Int
  dueDate        DateTime @db.Date
  expectedAmount Decimal  @db.Decimal(18, 4)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)


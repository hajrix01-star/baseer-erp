  mappingVersion  FinancePnlMappingVersion   @relation(fields: [mappingVersionId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  accountMappings FinancePnlAccountMapping[]

  @@unique([id, tenantId, companyId])
  @@unique([mappingVersionId, code])
  @@unique([mappingVersionId, sortOrder])
  @@index([tenantId, companyId, mappingVersionId, sortOrder])
}

/// Every included P&L account maps once to a line in the same immutable
/// policy version. Control/balance-sheet accounts cannot enter this relation.
model FinancePnlAccountMapping {
  id               String                     @id @default(uuid()) @db.Uuid
  tenantId         String                     @db.Uuid
  companyId        String                     @db.Uuid
  mappingVersionId String                     @db.Uuid
  statementLineId  String                     @db.Uuid
  accountId        String                     @db.Uuid
  presentationSign FinancePnlPresentationSign
  createdAt        DateTime                   @default(now()) @db.Timestamptz(6)

  company        Company                  @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  mappingVersion FinancePnlMappingVersion @relation(fields: [mappingVersionId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  statementLine  FinancePnlStatementLine  @relation(fields: [statementLineId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  account        FinanceAccount           @relation(fields: [accountId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([mappingVersionId, accountId])
  @@index([tenantId, companyId, mappingVersionId, statementLineId])
  @@index([tenantId, companyId, accountId])
}

/// The company-local monotonically increasing boundary assigned in the same

/// The policy is tenant/company owned and intentionally stores only schedule
/// intent. The worker implementation is deferred until the execution gate.
model BackupPolicy {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @db.Uuid
  companyId       String                @db.Uuid
  name            String                @default("default") @db.VarChar(80)
  enabled         Boolean               @default(true)
  frequency       BackupPolicyFrequency @default(MANUAL)
  scheduleJson    Json?
  retentionCount  Int                   @default(7)
  createdByUserId String                @db.Uuid
  createdAt       DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(6)

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company     @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  creator User        @relation("BackupPolicyCreator", fields: [createdByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  jobs    BackupJob[]

  @@unique([tenantId, companyId, name])
  @@unique([id, tenantId])
  @@index([tenantId, companyId, enabled])
}

/// Mutable progress is durable and therefore survives API/worker restarts.
/// The actual archive exporter is deliberately not part of this foundation.
model BackupJob {
  id                   String          @id @default(uuid()) @db.Uuid
  tenantId             String          @db.Uuid
  companyId            String          @db.Uuid
  policyId             String?         @db.Uuid
  requestedByUserId    String          @db.Uuid
  kind                 BackupJobKind
  status               BackupJobStatus @default(QUEUED)
  stage                String          @default("QUEUED") @db.VarChar(80)
  idempotencyKey       String          @db.VarChar(255)
  requestHash          String          @db.Char(64)
  correlationId        String          @db.Uuid
  progressPercent      Int             @default(0)
  checkpointJson       Json?
  recordsProcessed     Int             @default(0)
  recordsTotal         Int?
  bytesProcessed       BigInt          @default(0)
  bytesTotal           BigInt?
  attemptCount         Int             @default(0)
  workerLeaseOwnerId   String?         @db.Uuid
  workerLeaseFence     BigInt          @default(0)
  workerLeaseExpiresAt DateTime?       @db.Timestamptz(6)
  workerHeartbeatAt    DateTime?       @db.Timestamptz(6)
  lastErrorCode        String?         @db.VarChar(120)
  lastErrorMessage     String?         @db.VarChar(1000)
  queuedAt             DateTime        @default(now()) @db.Timestamptz(6)
  startedAt            DateTime?       @db.Timestamptz(6)
  completedAt          DateTime?       @db.Timestamptz(6)
  createdAt            DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(6)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company     Company            @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  policy      BackupPolicy?      @relation(fields: [policyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  requester   User               @relation("BackupJobRequester", fields: [requestedByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  artifacts   BackupArtifact[]
  auditEvents BackupAuditEvent[]

  @@unique([tenantId, companyId, requestedByUserId, kind, idempotencyKey])
  @@unique([id, tenantId])
  @@index([tenantId, companyId, status, queuedAt])
  @@index([tenantId, status, workerLeaseExpiresAt, queuedAt])
  @@index([tenantId, policyId, queuedAt])
}

model BackupArtifact {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  companyId     String               @db.Uuid
  jobId         String               @db.Uuid
  status        BackupArtifactStatus @default(PENDING)
  formatVersion String               @db.VarChar(80)
  storageKey    String?              @db.VarChar(500)
  filename      String?              @db.VarChar(255)
  sha256        String?              @db.Char(64)
  byteSize      BigInt?
  verifiedAt    DateTime?            @db.Timestamptz(6)
  expiresAt     DateTime?            @db.Timestamptz(6)
  createdAt     DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(6)

  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company   @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  job     BackupJob @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([jobId])
  @@unique([id, tenantId])
  @@index([tenantId, companyId, status, createdAt])
}

/// Append-only application evidence. The migration blocks UPDATE and DELETE;
/// event hashes give later auditor tooling a deterministic chain to verify.
model BackupAuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  companyId     String   @db.Uuid
  jobId         String?  @db.Uuid
  actorUserId   String?  @db.Uuid
  action        String   @db.VarChar(120)
  correlationId String   @db.Uuid
  previousHash  String?  @db.Char(64)
  eventHash     String   @db.Char(64)
  metadataJson  Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  tenant  Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company    @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  job     BackupJob? @relation(fields: [jobId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actor   User?      @relation(fields: [actorUserId, tenantId], references: [id, tenantId], onDelete: NoAction)

  @@unique([tenantId, eventHash])
  @@index([tenantId, companyId, createdAt])
  @@index([tenantId, jobId, createdAt])
}

/// Snapshot-bound migration control plane. It records technical lineage only,
/// never source credentials or unredacted business payloads.
model LegacyMigrationRun {
  id                String                   @id @default(uuid()) @db.Uuid
  tenantId          String                   @db.Uuid
  sourceSystem      String                   @db.VarChar(80)
  sourceFingerprint String                   @db.Char(64)
  transformVersion  String                   @db.VarChar(80)
  status            LegacyMigrationRunStatus @default(DISCOVERY)
  initiatedByUserId String                   @db.Uuid
  startedAt         DateTime                 @default(now()) @db.Timestamptz(6)
  completedAt       DateTime?                @db.Timestamptz(6)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(6)

  tenant                  Tenant                                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  initiatedBy             User                                    @relation("LegacyMigrationRunCreator", fields: [initiatedByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  companyMaps             LegacyMigrationCompanyMap[]
  recordMaps              LegacyMigrationRecordMap[]
  exceptions              LegacyMigrationException[]
  reviewActions           LegacyMigrationReviewAction[]
  counterpartyResolutions LegacyMigrationCounterpartyResolution[]
  counterpartyCandidates  LegacyMigrationCounterpartyCandidate[]

  @@unique([tenantId, sourceSystem, sourceFingerprint, transformVersion])
  @@unique([id, tenantId])
  @@index([tenantId, status, startedAt])
}

/// Source-company to target-company decisions are append-only. Target companies
/// remain archived until a separately signed reconciliation and Go decision.
model LegacyMigrationCompanyMap {
  id              String                         @id @default(uuid()) @db.Uuid
  runId           String                         @db.Uuid
  tenantId        String                         @db.Uuid
  sourceCompanyId String                         @db.VarChar(120)
  targetCompanyId String                         @db.Uuid
  state           LegacyMigrationCompanyMapState @default(PLANNED)
  createdAt       DateTime                       @default(now()) @db.Timestamptz(6)

  run           LegacyMigrationRun @relation(fields: [runId, tenantId], references: [id, tenantId], onDelete: Restrict)
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  targetCompany Company            @relation(fields: [targetCompanyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([runId, sourceCompanyId])
  @@unique([runId, targetCompanyId])
  @@index([tenantId, targetCompanyId])
}

/// Append-only source-to-target lineage. Legacy IDs never become Baseer IDs.
model LegacyMigrationRecordMap {
  id               String                        @id @default(uuid()) @db.Uuid
  runId            String                        @db.Uuid
  tenantId         String                        @db.Uuid
  targetCompanyId  String                        @db.Uuid
  sourceCompanyId  String                        @db.VarChar(120)
  sourceEntity     String                        @db.VarChar(120)
  sourceId         String                        @db.VarChar(160)
  targetEntity     String                        @db.VarChar(120)
  targetId         String                        @db.VarChar(160)
  transformVersion String                        @db.VarChar(80)
  sourceChecksum   String                        @db.Char(64)
  state            LegacyMigrationRecordMapState @default(PLANNED)
  createdAt        DateTime                      @default(now()) @db.Timestamptz(6)

  run           LegacyMigrationRun @relation(fields: [runId, tenantId], references: [id, tenantId], onDelete: Restrict)
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  targetCompany Company            @relation(fields: [targetCompanyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([runId, sourceEntity, sourceId])
  @@unique([runId, targetEntity, targetId])
  @@index([tenantId, targetCompanyId, sourceEntity])
  @@index([tenantId, sourceCompanyId, sourceEntity])
}

/// Immutable preservation of a source text when the operational target either
/// has no note field or its business note must remain distinct from migration
/// metadata.  It carries no financial amount, journal instruction or mutable
/// source payload.
model NoorixSourceAnnotation {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  targetCompanyId String   @db.Uuid
  sourceCompanyId String   @db.VarChar(120)
  sourceEntity    String   @db.VarChar(120)
  sourceId        String   @db.VarChar(160)
  sourceChecksum  String   @db.Char(64)
  targetEntity    String?  @db.VarChar(120)
  targetId        String?  @db.VarChar(160)
  field           String   @db.VarChar(120)
  exactText       String   @db.Text
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [targetCompanyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, targetCompanyId, sourceEntity, sourceId, field])
  @@index([tenantId, targetCompanyId, targetEntity, targetId])
  @@index([tenantId, targetCompanyId, sourceEntity, sourceId])
}

/// Immutable intake metadata. Workbook bytes stay in controlled file storage
/// when that gate is enabled; this table stores only technical fingerprints.
model NurixExcelStagingPackage {
  id                String                         @id @default(uuid()) @db.Uuid
  tenantId          String                         @db.Uuid
  targetCompanyId   String                         @db.Uuid
  sourceCompanyId   String                         @db.VarChar(120)
  templateVersion   String                         @db.VarChar(80)
  workbookSha256    String                         @db.Char(64)
  sourceFingerprint String?                        @db.Char(64)
  storageReference  String?                        @db.VarChar(500)
  encryptionIv      String?                        @db.VarChar(40)
  storedByteSize    BigInt?
  status            NurixExcelStagingPackageStatus @default(RECEIVED)
  createdAt         DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                       @updatedAt @db.Timestamptz(6)

  tenant               Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company              Company                         @relation(fields: [targetCompanyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  batches              NurixExcelStagingBatch[]
  rows                 NurixExcelStagingRow[]
  masterDataExecutions NurixExcelMasterDataExecution[]
  financialExecutions  NurixExcelFinancialExecution[]

  @@unique([id, tenantId])
  @@unique([tenantId, targetCompanyId, workbookSha256])
  @@index([tenantId, targetCompanyId, status, createdAt])
}

/// A checkpointable parse/validation batch. It cannot carry financial payloads.
model NurixExcelStagingBatch {
  id           String                       @id @default(uuid()) @db.Uuid
  packageId    String                       @db.Uuid
  tenantId     String                       @db.Uuid
  sequence     Int
  status       NurixExcelStagingBatchStatus @default(PENDING)
  rowsDeclared Int                          @default(0)
  rowsAccepted Int                          @default(0)
  rowsRejected Int                          @default(0)
  createdAt    DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                     @updatedAt @db.Timestamptz(6)

  package NurixExcelStagingPackage @relation(fields: [packageId, tenantId], references: [id, tenantId], onDelete: Restrict)
  tenant  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rows    NurixExcelStagingRow[]

  @@unique([id, tenantId])
  @@unique([packageId, sequence])
  @@index([tenantId, packageId, status, sequence])
}

/// One canonical source-row receipt. Hashes make resume/idempotency decisions
/// without retaining raw financial or employee payloads in the control plane.
model NurixExcelStagingRow {
  id             String                     @id @default(uuid()) @db.Uuid
  packageId      String                     @db.Uuid
  batchId        String                     @db.Uuid
  tenantId       String                     @db.Uuid
  sheet          String                     @db.VarChar(80)
  sourceId       String                     @db.VarChar(160)
  sourceChecksum String                     @db.Char(64)
  status         NurixExcelStagingRowStatus
  code           String                     @db.VarChar(120)
  createdAt      DateTime                   @default(now()) @db.Timestamptz(6)

  package NurixExcelStagingPackage @relation(fields: [packageId, tenantId], references: [id, tenantId], onDelete: Restrict)
  batch   NurixExcelStagingBatch   @relation(fields: [batchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  tenant  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([packageId, sheet, sourceId])
  @@index([tenantId, packageId, status, sheet])
  @@index([tenantId, sourceChecksum])
}

/// The durable control plane for Excel master-data waves. It deliberately
/// has no financial-document relationship or financial payload.
model NurixExcelMasterDataExecution {
  id                String                              @id @default(uuid()) @db.Uuid
  packageId         String                              @db.Uuid
  tenantId          String                              @db.Uuid
  targetCompanyId   String                              @db.Uuid
  status            NurixExcelMasterDataExecutionStatus @default(PENDING)
  waveSequence      Int                                 @default(0)
  reason            String?                             @db.VarChar(500)
  requestedByUserId String                              @db.Uuid
  leaseToken        String?                             @db.Uuid
  leaseExpiresAt    DateTime?                           @db.Timestamptz(6)
  createdAt         DateTime                            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                            @updatedAt @db.Timestamptz(6)

  package NurixExcelStagingPackage   @relation(fields: [packageId, tenantId], references: [id, tenantId], onDelete: Restrict)
  tenant  Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company                    @relation(fields: [targetCompanyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  items   NurixExcelMasterDataItem[]

  @@unique([id, tenantId])
  @@unique([packageId, tenantId])
  @@index([tenantId, targetCompanyId, status, updatedAt])
}

/// An immutable technical receipt for one source master row. Sensitive raw
/// cells stay encrypted in the workbook; this table retains only keys,
/// checksum, target reference and outcome required for safe resume.
model NurixExcelMasterDataItem {
  id             String                         @id @default(uuid()) @db.Uuid
  executionId    String                         @db.Uuid
  tenantId       String                         @db.Uuid
  entity         String                         @db.VarChar(40)
  sourceId       String                         @db.VarChar(160)
  sourceChecksum String                         @db.Char(64)
  status         NurixExcelMasterDataItemStatus @default(PENDING)
  targetId       String?                        @db.Uuid
  code           String?                        @db.VarChar(120)
  createdAt      DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime                       @updatedAt @db.Timestamptz(6)

  execution NurixExcelMasterDataExecution @relation(fields: [executionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  tenant    Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([executionId, entity, sourceId])
  @@index([tenantId, executionId, status, entity, sourceId])
}

/// Financial execution is intentionally independent from master-data waves.
/// It cannot store invoice cells or create postings by itself; it supplies the
/// durable, tenant-scoped approval and resume boundary for a future writer.
model NurixExcelFinancialExecution {
  id                   String                            @id @default(uuid()) @db.Uuid
  packageId            String                            @db.Uuid
  tenantId             String                            @db.Uuid
  targetCompanyId      String                            @db.Uuid
  transformVersion     String                            @db.VarChar(80)
  financialPlanSha256  String                            @db.Char(64)
  status               NurixExcelFinancialExecutionStatus @default(PENDING)
  reason               String?                           @db.VarChar(500)
  requestedByUserId    String                            @db.Uuid
  approvedByUserId     String?                           @db.Uuid
  approvedAt           DateTime?                         @db.Timestamptz(6)
  leaseToken           String?                           @db.Uuid
  leaseExpiresAt       DateTime?                         @db.Timestamptz(6)
  waveSequence         Int                               @default(0)
  createdAt            DateTime                          @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                          @updatedAt @db.Timestamptz(6)

  package     NurixExcelStagingPackage @relation(fields: [packageId, tenantId], references: [id, tenantId], onDelete: Restrict)
  tenant      Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company     Company                  @relation(fields: [targetCompanyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  requester   User                     @relation("NurixExcelFinancialExecutionRequester", fields: [requestedByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  approver    User?                    @relation("NurixExcelFinancialExecutionApprover", fields: [approvedByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  waves       NurixExcelFinancialWave[]
  items       NurixExcelFinancialItem[]
  sourceMaps  NurixExcelFinancialSourceMap[]
  receipts    NurixExcelFinancialReceipt[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, targetCompanyId])
  @@unique([packageId, tenantId, transformVersion])
  @@index([tenantId, targetCompanyId, status, updatedAt])
  @@index([tenantId, packageId, status])
}

/// A bounded wave lease permits safe resume after an interrupted financial
/// worker. Financial facts are deliberately not related here.
model NurixExcelFinancialWave {
  id                 String                        @id @default(uuid()) @db.Uuid
  executionId        String                        @db.Uuid
  tenantId           String                        @db.Uuid
  targetCompanyId    String                        @db.Uuid
  sequence           Int
  status             NurixExcelFinancialWaveStatus @default(PENDING)
  plannedItems       Int                           @default(0)
  postedItems        Int                           @default(0)
  reusedItems        Int                           @default(0)
  reviewItems        Int                           @default(0)
  failedItems        Int                           @default(0)
  leaseToken         String?                       @db.Uuid
  leaseExpiresAt     DateTime?                     @db.Timestamptz(6)
  committedAt        DateTime?                     @db.Timestamptz(6)
  reconciliationHash String?                       @db.Char(64)
  createdAt          DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                      @updatedAt @db.Timestamptz(6)

  execution NurixExcelFinancialExecution @relation(fields: [executionId, tenantId, targetCompanyId], references: [id, tenantId, targetCompanyId], onDelete: Restrict)
  tenant    Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company   Company                      @relation(fields: [targetCompanyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  items     NurixExcelFinancialItem[]
  receipts  NurixExcelFinancialReceipt[]

  @@unique([id, tenantId])
  @@unique([id, tenantId, targetCompanyId])
  @@unique([executionId, sequence])
  @@index([tenantId, targetCompanyId, status, updatedAt])
  @@index([tenantId, executionId, status, sequence])
}

/// One item per exact source record and transform. The operation key is a
/// deterministic writer idempotency key; it never contains source payload.
model NurixExcelFinancialItem {
  id              String                      @id @default(uuid()) @db.Uuid
  executionId     String                      @db.Uuid
  waveId          String                      @db.Uuid
  tenantId        String                      @db.Uuid
  targetCompanyId String                      @db.Uuid
  sourceSheet     String                      @db.VarChar(80)
  sourceEntity    String                      @db.VarChar(120)
  sourceId        String                      @db.VarChar(160)
  sourceChecksum  String                      @db.Char(64)
  operationKey    String                      @db.Char(64)
  status          NurixExcelFinancialItemStatus @default(PENDING)
  targetEntity    String?                     @db.VarChar(120)
  targetId        String?                     @db.VarChar(160)
  resultCode      String?                     @db.VarChar(120)
  createdAt       DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                    @updatedAt @db.Timestamptz(6)

  execution NurixExcelFinancialExecution @relation(fields: [executionId, tenantId, targetCompanyId], references: [id, tenantId, targetCompanyId], onDelete: Restrict)
  wave      NurixExcelFinancialWave      @relation(fields: [waveId, tenantId, targetCompanyId], references: [id, tenantId, targetCompanyId], onDelete: Restrict)
  tenant    Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company   Company                      @relation(fields: [targetCompanyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([executionId, sourceEntity, sourceId])
  @@unique([executionId, operationKey])
  @@index([tenantId, targetCompanyId, status, sourceEntity, sourceId])
  @@index([tenantId, waveId, status])
}

/// Immutable source-to-target lineage. A source identity can map once per
/// execution, which prevents a resumed writer from creating it twice.
model NurixExcelFinancialSourceMap {
  id              String                           @id @default(uuid()) @db.Uuid
  executionId     String                           @db.Uuid
  tenantId        String                           @db.Uuid
  targetCompanyId String                           @db.Uuid
  sourceEntity    String                           @db.VarChar(120)
  sourceId        String                           @db.VarChar(160)
  sourceChecksum  String                           @db.Char(64)
  targetEntity    String                           @db.VarChar(120)
  targetId        String                           @db.VarChar(160)
  state           NurixExcelFinancialSourceMapState @default(PLANNED)
  createdAt       DateTime                         @default(now()) @db.Timestamptz(6)

  execution NurixExcelFinancialExecution @relation(fields: [executionId, tenantId, targetCompanyId], references: [id, tenantId, targetCompanyId], onDelete: Restrict)
  tenant    Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company   Company                      @relation(fields: [targetCompanyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([executionId, sourceEntity, sourceId])
  @@index([tenantId, targetCompanyId, targetEntity, targetId])
  @@index([tenantId, executionId, state])
}

/// Append-only technical proof for a financial wave. The JSON summary is
/// limited to reconciliation counts/totals and never stores raw source rows.
model NurixExcelFinancialReceipt {
  id              String                         @id @default(uuid()) @db.Uuid
  executionId     String                         @db.Uuid
  waveId          String                         @db.Uuid
  tenantId        String                         @db.Uuid
  targetCompanyId String                         @db.Uuid
  sequence        Int
  kind            NurixExcelFinancialReceiptKind
  receiptSha256   String                         @db.Char(64)
  summaryJson     Json
  createdByUserId String                         @db.Uuid
  createdAt       DateTime                       @default(now()) @db.Timestamptz(6)

  execution NurixExcelFinancialExecution @relation(fields: [executionId, tenantId, targetCompanyId], references: [id, tenantId, targetCompanyId], onDelete: Restrict)
  wave      NurixExcelFinancialWave      @relation(fields: [waveId, tenantId, targetCompanyId], references: [id, tenantId, targetCompanyId], onDelete: Restrict)
  tenant    Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company   Company                      @relation(fields: [targetCompanyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  creator   User                         @relation("NurixExcelFinancialReceiptCreator", fields: [createdByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([executionId, sequence])
  @@index([tenantId, targetCompanyId, createdAt])
  @@index([tenantId, waveId, kind, createdAt])
}

/// Immutable historical payroll header. It is intentionally isolated from
/// HrPayrollRun, journals, payments, and employee financial movements: Noorix
/// approval evidence must not become a current Baseer financial obligation.
model NurixHistoricalPayrollEvidence {
  id                              String                               @id @default(uuid()) @db.Uuid
  tenantId                        String                               @db.Uuid
  companyId                       String                               @db.Uuid
  executionId                     String                               @db.Uuid
  sourceCompanyId                 String                               @db.VarChar(120)
  sourceRunId                     String                               @db.VarChar(160)
  sourceChecksum                  String                               @db.Char(64)
  sourceRunNumber                 String                               @db.VarChar(80)
  payrollMonth                    DateTime                             @db.Date
  sourceAccruedAt                 DateTime                             @db.Timestamptz(6)
  sourceStatus                    String                               @db.VarChar(40)
  employeeCount                   Int
  grossAmount                     Decimal                              @db.Decimal(18, 4)
  deductionsAmount                Decimal                              @db.Decimal(18, 4)
  appliedAdvancesAmount           Decimal                              @db.Decimal(18, 4)
  sourceAdvancesAmount            Decimal                              @db.Decimal(18, 4)
  advanceCarryoverEvidenceAmount  Decimal                              @db.Decimal(18, 4)
  netAmount                       Decimal                              @db.Decimal(18, 4)
  paymentEvidenceKind             NurixHistoricalPayrollPaymentEvidenceKind @default(NONE)
  paymentEvidenceAmount           Decimal?                             @db.Decimal(18, 4)
  paymentEvidenceAt               DateTime?                            @db.Timestamptz(6)
  sourceInvoiceEvidence           NurixHistoricalPayrollAccountingEvidenceAvailability @default(NONE)
  sourceJournalEvidence           NurixHistoricalPayrollAccountingEvidenceAvailability @default(NONE)
  status                          NurixHistoricalPayrollEvidenceStatus @default(EVIDENCE_ONLY)
  notes                           String?                              @db.VarChar(1000)
  createdByUserId                 String                               @db.Uuid
  createdAt                       DateTime                             @default(now()) @db.Timestamptz(6)

  lines              NurixHistoricalPayrollLineEvidence[]
  accountingEvidence NurixHistoricalPayrollAccountingEvidence[]

  @@unique([id, tenantId])
  @@unique([tenantId, executionId, sourceRunId])
  @@unique([id, tenantId, companyId, executionId])
  @@index([tenantId, companyId, payrollMonth])
  @@index([tenantId, companyId, status, createdAt])
}

/// Immutable historical payroll source line. employeeId is optional because
/// it is a lineage reference only; it never licenses a payroll or debt write.
model NurixHistoricalPayrollLineEvidence {
  id                         String                          @id @default(uuid()) @db.Uuid
  tenantId                   String                          @db.Uuid
  companyId                  String                          @db.Uuid
  executionId                String                          @db.Uuid
  runEvidenceId              String                          @db.Uuid
  sourceItemId               String                          @db.VarChar(160)
  sourceChecksum             String                          @db.Char(64)
  employeeSourceId           String                          @db.VarChar(160)
  employeeId                 String?                         @db.Uuid
  grossSalary                Decimal                         @db.Decimal(18, 4)
  allowancesAdd              Decimal                         @db.Decimal(18, 4)
  deductionsAmount           Decimal                         @db.Decimal(18, 4)
  sourceAdvancesAmount       Decimal                         @db.Decimal(18, 4)
  appliedAdvancesAmount      Decimal                         @db.Decimal(18, 4)
  advanceCarryoverEvidence   Decimal                         @db.Decimal(18, 4)
  netSalary                  Decimal                         @db.Decimal(18, 4)
  createdAt                  DateTime                        @default(now()) @db.Timestamptz(6)

  run NurixHistoricalPayrollEvidence @relation(fields: [runEvidenceId, tenantId, companyId, executionId], references: [id, tenantId, companyId, executionId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, executionId, sourceItemId])
  @@index([tenantId, companyId, runEvidenceId])
  @@index([tenantId, companyId, employeeId])
}

/// Source-only invoice/journal/vault-allocation proof for a historical payroll
/// header. It has no relation to Baseer operational finance documents.
model NurixHistoricalPayrollAccountingEvidence {
  id              String                                      @id @db.Uuid
  tenantId        String                                      @db.Uuid
  companyId       String                                      @db.Uuid
  executionId     String                                      @db.Uuid
  runEvidenceId   String                                      @db.Uuid
  evidenceKind    NurixHistoricalPayrollAccountingEvidenceKind
  sourceRecordId  String                                      @db.VarChar(160)
  sourceChecksum  String                                      @db.Char(64)
  sourceNumber    String?                                     @db.VarChar(160)
  sourceDate      DateTime?                                   @db.Timestamptz(6)
  vaultSourceId   String?                                     @db.VarChar(160)
  amount          Decimal?                                    @db.Decimal(18, 4)
  createdAt       DateTime                                    @default(now()) @db.Timestamptz(6)

  run NurixHistoricalPayrollEvidence @relation(fields: [runEvidenceId, tenantId, companyId, executionId], references: [id, tenantId, companyId, executionId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, executionId, evidenceKind, sourceRecordId])
  @@index([tenantId, companyId, runEvidenceId, evidenceKind])
}

/// A safe exception ledger: codes and technical references only, never source
/// rows, passwords, storage keys, files, or unredacted PII.
model LegacyMigrationException {
  id              String                           @id @default(uuid()) @db.Uuid
  runId           String                           @db.Uuid
  tenantId        String                           @db.Uuid
  sourceCompanyId String?                          @db.VarChar(120)
  sourceEntity    String?                          @db.VarChar(120)
  sourceId        String?                          @db.VarChar(160)
  severity        LegacyMigrationExceptionSeverity
  code            String                           @db.VarChar(120)
  message         String                           @db.VarChar(500)
  createdAt       DateTime                         @default(now()) @db.Timestamptz(6)

  run    LegacyMigrationRun @relation(fields: [runId, tenantId], references: [id, tenantId], onDelete: Restrict)
  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  reviewActions LegacyMigrationReviewAction[]

  @@unique([id, tenantId])
  @@index([tenantId, runId, severity, createdAt])
}

/// Human attestations are append-only. Their compact snapshot hash proves
/// exactly which safe aggregate was reviewed without persisting source rows.
model LegacyMigrationReviewAction {
  id                   String                          @id @default(uuid()) @db.Uuid
  runId                String                          @db.Uuid
  tenantId             String                          @db.Uuid
  exceptionId          String?                         @db.Uuid
  action               LegacyMigrationReviewActionKind
  actionKey            String                          @db.VarChar(120)
  reason               String                          @db.VarChar(500)
  reviewSnapshotSha256 String                          @db.Char(64)
  createdByUserId      String                          @db.Uuid
  createdAt            DateTime                        @default(now()) @db.Timestamptz(6)

  run       LegacyMigrationRun        @relation(fields: [runId, tenantId], references: [id, tenantId], onDelete: Restrict)
  exception LegacyMigrationException? @relation(fields: [exceptionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  tenant    Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy User                      @relation("LegacyMigrationReviewActionCreator", fields: [createdByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([runId, action, actionKey])
  @@index([tenantId, runId, createdAt])
  @@index([tenantId, exceptionId, createdAt])
}

/// Immutable, tenant-scoped owner briefing receipt. A scheduled job writes at
/// most one snapshot per completed Riyadh business date; historical reads must
/// never silently change when source financial data is corrected later.
model OwnerDailyBriefSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  reportDate    DateTime @db.Date
  receiptJson   Json
  receiptSha256 String   @db.Char(64)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, reportDate])
  @@index([tenantId, reportDate])
}

model DocumentSerialCounter {
  tenantId     String   @db.Uuid
  companyId    String   @db.Uuid
  series       String   @db.VarChar(80)
  businessDate DateTime @db.Date
  lastValue    BigInt   @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([tenantId, companyId, series, businessDate])
}

model FileMetadata {
  id                     String             @id @db.Uuid
  tenantId               String             @db.Uuid
  companyId              String             @db.Uuid
  sourceType             String             @db.VarChar(80)
  sourceId               String             @db.Uuid
  purpose                String             @db.VarChar(80)
  version                Int
  status                 FileMetadataStatus @default(RESERVED)
  displayName            String             @db.VarChar(240)
  declaredMimeType       String             @db.VarChar(127)
  declaredByteSize       BigInt
  declaredSha256         String             @db.Char(64)
  storageReference       String             @unique @db.VarChar(255)
  replacesFileMetadataId String?            @db.Uuid
  supersededAt           DateTime?          @db.Timestamptz(6)
  createdByUserId        String             @db.Uuid
  createdAt              DateTime           @default(now()) @db.Timestamptz(6)

  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company              Company                 @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy            User                    @relation("FileMetadataCreator", fields: [createdByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  replaces             FileMetadata?           @relation("FileMetadataVersionLineage", fields: [replacesFileMetadataId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  supersededBy         FileMetadata[]          @relation("FileMetadataVersionLineage")
  employeeDocumentBlob HrEmployeeDocumentBlob?

  @@unique([id, tenantId, companyId])
  @@unique([tenantId, companyId, sourceType, sourceId, purpose, version])
  @@index([tenantId, companyId, sourceType, sourceId, purpose, status])
  @@index([tenantId, companyId, declaredSha256])
}

model CompanyFinanceProfile {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @db.Uuid
  companyId              String   @unique @db.Uuid
  baseSeedVersion        Int      @default(1)
  accountingMode         String   @default("management_cash") @db.VarChar(40)
  vatAccountingEnabled   Boolean  @default(false)
  vatRateBasisPoints     Int      @default(1500)
  /// All current finance amounts are implicitly in this single company
  /// currency. Foreign currency, FX revaluation and consolidation are not
  /// supported by the R0-A/R1 reporting policy.
  functionalCurrencyCode String   @default("SAR") @db.Char(3)
  initializedAt          DateTime @default(now()) @db.Timestamptz(6)
  createdAt              DateTime @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @db.Timestamptz(6)

  company Company @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([companyId, tenantId])
  @@index([tenantId, companyId])
}

model FinanceAccount {
  id        String               @id @default(uuid()) @db.Uuid
  tenantId  String               @db.Uuid
  companyId String               @db.Uuid
  code      String               @db.VarChar(80)
  nameAr    String               @db.VarChar(160)
  nameEn    String               @db.VarChar(160)
  type      FinanceAccountType
  systemKey String?              @db.VarChar(80)
  isSystem  Boolean              @default(false)
  status    FinanceAccountStatus @default(ACTIVE)
  createdAt DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt DateTime             @updatedAt @db.Timestamptz(6)

  company            Company                    @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  categories         FinanceCategory[]
  vaults             FinanceVault[]
  journalLines       FinanceJournalLine[]
  pnlAccountMappings FinancePnlAccountMapping[]

  @@unique([id, tenantId, companyId])
  @@unique([companyId, code])
  @@unique([companyId, systemKey])
  @@index([tenantId, companyId, status])
}

/// Company-owned effective-dated P&L mapping policy. It is intentionally
/// separate from FinanceCategory because categories can be operationally
/// edited without restating accounting presentation.
model FinancePnlMappingVersion {
  id               String                         @id @default(uuid()) @db.Uuid
  tenantId         String                         @db.Uuid
  companyId        String                         @db.Uuid
  versionNumber    Int
  status           FinancePnlMappingVersionStatus @default(DRAFT)
  policyVersion    String                         @db.VarChar(80)
  effectiveFrom    DateTime                       @db.Date
  effectiveTo      DateTime?                      @db.Date
  approvedAt       DateTime?                      @db.Timestamptz(6)
  approvedByUserId String?                        @db.Uuid
  checksum         String?                        @db.Char(64)
  createdByUserId  String                         @db.Uuid
  createdAt        DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                       @updatedAt @db.Timestamptz(6)

  company         Company                    @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  statementLines  FinancePnlStatementLine[]
  accountMappings FinancePnlAccountMapping[]

  @@unique([id, tenantId, companyId])
  @@unique([companyId, versionNumber])
  @@index([tenantId, companyId, status, effectiveFrom])
}

/// A line is version-local, so renaming, ordering or changing its nature is a
/// new policy version rather than a reinterpretation of an old P&L.
model FinancePnlStatementLine {
  id                 String                       @id @default(uuid()) @db.Uuid
  tenantId           String                       @db.Uuid
  companyId          String                       @db.Uuid
  mappingVersionId   String                       @db.Uuid
  code               String                       @db.VarChar(80)
  nameAr             String                       @db.VarChar(160)
  nameEn             String                       @db.VarChar(160)
  presentationNature FinancePnlPresentationNature
  sortOrder          Int
  isSubtotal         Boolean                      @default(false)
  createdAt          DateTime                     @default(now()) @db.Timestamptz(6)

  company         Company                    @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  mappingVersion  FinancePnlMappingVersion   @relation(fields: [mappingVersionId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  accountMappings FinancePnlAccountMapping[]

  @@unique([id, tenantId, companyId])
  @@unique([mappingVersionId, code])
  @@unique([mappingVersionId, sortOrder])
  @@index([tenantId, companyId, mappingVersionId, sortOrder])
}

/// Every included P&L account maps once to a line in the same immutable
/// policy version. Control/balance-sheet accounts cannot enter this relation.
model FinancePnlAccountMapping {
  id               String                     @id @default(uuid()) @db.Uuid
  tenantId         String                     @db.Uuid
  companyId        String                     @db.Uuid
  mappingVersionId String                     @db.Uuid
  statementLineId  String                     @db.Uuid
  accountId        String                     @db.Uuid
  presentationSign FinancePnlPresentationSign
  createdAt        DateTime                   @default(now()) @db.Timestamptz(6)

  company        Company                  @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  mappingVersion FinancePnlMappingVersion @relation(fields: [mappingVersionId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  statementLine  FinancePnlStatementLine  @relation(fields: [statementLineId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  account        FinanceAccount           @relation(fields: [accountId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([mappingVersionId, accountId])
  @@index([tenantId, companyId, mappingVersionId, statementLineId])
  @@index([tenantId, companyId, accountId])
}

/// The company-local monotonically increasing boundary assigned in the same
/// transaction that seals a journal entry or its reversal.
model FinanceLedgerRevision {
  tenantId        String   @db.Uuid
  companyId       String   @db.Uuid
  currentRevision BigInt   @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  company Company @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([tenantId, companyId])
  @@unique([companyId, tenantId])
}

/// Immutable server-side report snapshot metadata. R0-B stores the source
/// boundary only; report rows and HTTP/UI delivery start in later gates.
model ReportRun {
  id                            String          @id @default(uuid()) @db.Uuid
  tenantId                      String          @db.Uuid
  companyId                     String          @db.Uuid
  reportCode                    String          @db.VarChar(80)
  definitionVersion             String          @db.VarChar(80)
  canonicalOptionsJson          Json
  economicAsOfDate              DateTime        @db.Date
  ledgerRevision                BigInt
  eligibleEntryPredicateVersion String          @db.VarChar(80)
  projectionWatermarkJson       Json?
  sourceCoverageJson            Json
  accountMappingVersionId       String?         @db.Uuid
  accountMappingChecksum        String?         @db.Char(64)
  checksum                      String          @db.Char(64)
  status                        ReportRunStatus @default(READY)
  expiresAt                     DateTime        @db.Timestamptz(6)
  outputJobId                   String?         @db.Uuid
  createdByUserId               String          @db.Uuid
  createdAt                     DateTime        @default(now()) @db.Timestamptz(6)

  company                   Company                    @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy                 User                       @relation(fields: [createdByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  documents                 ReportDocument[]
  decisionEvidenceSnapshots DecisionEvidenceSnapshot[]

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, reportCode, createdAt])
  @@index([tenantId, companyId, status, expiresAt])
  @@index([tenantId, companyId, ledgerRevision])
}

/// Code-owned definitions make an analytical number meaningful across time.
/// Values remain in domain-specific projections; this is never a fact table.
model DecisionMetricDefinition {
  id                String                     @id @default(uuid()) @db.Uuid
  tenantId          String                     @db.Uuid
  companyId         String                     @db.Uuid
  metricCode        String                     @db.VarChar(120)
  definitionVersion String                     @db.VarChar(80)
  comparisonCode    String                     @db.VarChar(80)
  descriptionAr     String                     @db.VarChar(500)
  status            DecisionContextEventStatus @default(PUBLISHED)
  createdAt         DateTime                   @default(now()) @db.Timestamptz(6)

  company Company @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([companyId, metricCode, definitionVersion])
  @@index([tenantId, companyId, metricCode, status])
}

/// A company explicitly opts into commercial sales-change alerts. The policy
/// is disabled by default so the platform never invents a business threshold.
model DecisionSalesChangePolicy {
  id                              String   @id @default(uuid()) @db.Uuid
  tenantId                        String   @db.Uuid
  companyId                       String   @db.Uuid
  enabled                         Boolean  @default(false)
  comparisonPolicyCode            String   @default("PREVIOUS_EQUAL_PERIOD") @db.VarChar(80)
  comparisonPolicyVersion         String   @default("previous_equal_period.v1") @db.VarChar(80)
  decreaseThresholdBasisPoints    Int?
  increaseThresholdBasisPoints    Int?
  minimumBaselineAmount           Decimal? @db.Decimal(18, 4)
  minimumAbsoluteDifferenceAmount Decimal? @db.Decimal(18, 4)
  cooldownHours                   Int?
  updatedByUserId                 String?  @db.Uuid
  createdAt                       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                       DateTime @updatedAt @db.Timestamptz(6)

  company Company @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([companyId, tenantId])
  @@index([tenantId, companyId, enabled])
}

/// Rule identity is versioned and auditable. Its deterministic implementation
/// remains code-owned; a tenant policy may only enable an approved version.
model DecisionRuleDefinition {
  id          String                     @id @default(uuid()) @db.Uuid
  tenantId    String                     @db.Uuid
  companyId   String                     @db.Uuid
  ruleCode    String                     @db.VarChar(120)
  ruleVersion String                     @db.VarChar(80)
  status      DecisionContextEventStatus @default(PUBLISHED)
  createdAt   DateTime                   @default(now()) @db.Timestamptz(6)

  company Company @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([companyId, ruleCode, ruleVersion])
  @@index([tenantId, companyId, ruleCode, status])
}

/// Approved source configuration for automated public context imports. The
/// source itself never makes a financial or operational fact.
model DecisionContextSource {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  sourceCode    String   @db.VarChar(80)
  displayNameAr String   @db.VarChar(160)
  sourceUrl     String   @db.VarChar(1000)
  scheduleCode  String   @db.VarChar(80)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  importRuns         DecisionContextImportRun[]
  researchRuns       DecisionContextResearchRun[]
  researchCandidates DecisionContextCandidate[]
  globalEvents       DecisionGlobalContextEvent[]

  @@unique([id, tenantId])
  @@unique([tenantId, sourceCode])
}

/// Every public-context pull has an immutable operational receipt. Failed or
/// unverifiable source documents never replace the previously published event.
model DecisionContextImportRun {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  sourceId         String    @db.Uuid
  triggerCode      String    @db.VarChar(80)
  status           String    @db.VarChar(40)
  documentChecksum String?   @db.Char(64)
  receivedEvents   Int       @default(0)
  publishedEvents  Int       @default(0)
  reviewEvents     Int       @default(0)
  diagnosticsJson  Json
  startedAt        DateTime  @default(now()) @db.Timestamptz(6)
  finishedAt       DateTime? @db.Timestamptz(6)

  source DecisionContextSource @relation(fields: [sourceId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, sourceId, startedAt])
}

/// Operational receipt for a scheduled context-research pull. It is separate
/// from an import run because research only proposes candidates; it does not
/// publish a context event.
model DecisionContextResearchRun {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @db.Uuid
  sourceId            String    @db.Uuid
  triggerCode         String    @db.VarChar(80)
  status              String    @db.VarChar(40)
  documentChecksum    String?   @db.Char(64)
  receivedCandidates  Int       @default(0)
  pendingCandidates   Int       @default(0)
  duplicateCandidates Int       @default(0)
  diagnosticsJson     Json
  startedAt           DateTime  @default(now()) @db.Timestamptz(6)
  finishedAt          DateTime? @db.Timestamptz(6)

  source     DecisionContextSource      @relation(fields: [sourceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  candidates DecisionContextCandidate[]

  @@unique([id, tenantId])
  @@index([tenantId, sourceId, startedAt])
}

/// A source-backed event suggestion. Candidates cannot appear in the timeline
/// or be read by Basira as context until they have been explicitly approved.
model DecisionContextCandidate {
  id                String                         @id @default(uuid()) @db.Uuid
  tenantId          String                         @db.Uuid
  sourceId          String                         @db.Uuid
  researchRunId     String                         @db.Uuid
  externalKey       String                         @db.VarChar(240)
  eventKind         String                         @db.VarChar(80)
  titleAr           String                         @db.VarChar(240)
  startsOn          DateTime                       @db.Date
  endsOn            DateTime                       @db.Date
  scope             DecisionContextScope           @default(TENANT_GLOBAL)
  locationCode      String?                        @db.VarChar(80)
  locationLabelAr   String?                        @db.VarChar(160)
  relevanceReasonAr String?                        @db.VarChar(500)
  sourceUpdatedAt   DateTime?                      @db.Timestamptz(6)
  sourceChecksum    String                         @db.Char(64)
  payloadJson       Json
  status            DecisionContextCandidateStatus @default(PENDING_REVIEW)
  resolutionJson    Json?
  publishedEventId  String?                        @db.Uuid
  resolvedByUserId  String?                        @db.Uuid
  resolvedAt        DateTime?                      @db.Timestamptz(6)
  createdAt         DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                       @updatedAt @db.Timestamptz(6)

  source         DecisionContextSource       @relation(fields: [sourceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  researchRun    DecisionContextResearchRun  @relation(fields: [researchRunId, tenantId], references: [id, tenantId], onDelete: Restrict)
  publishedEvent DecisionGlobalContextEvent? @relation(fields: [publishedEventId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, sourceId, externalKey])
  @@index([tenantId, status, startsOn, endsOn])
  @@index([tenantId, sourceId, researchRunId])
}

/// Global events are tenant-scoped catalog entries. A company never edits
/// them; imports create immutable revisions and unresolved changes stay reviewable.
model DecisionGlobalContextEvent {
  id              String                     @id @default(uuid()) @db.Uuid
  tenantId        String                     @db.Uuid
  sourceId        String                     @db.Uuid
  externalKey     String                     @db.VarChar(240)
  eventKind       String                     @db.VarChar(80)
  scope           DecisionContextScope       @default(TENANT_GLOBAL)
  locationCode    String?                    @db.VarChar(80)
  locationLabelAr String?                    @db.VarChar(160)
  status          DecisionContextEventStatus @default(PUBLISHED)
  currentRevision Int                        @default(1)
  createdAt       DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                   @updatedAt @db.Timestamptz(6)

  revisions          DecisionGlobalContextEventRevision[]
  reviewActions      DecisionGlobalContextReviewAction[]
  researchCandidates DecisionContextCandidate[]
  source             DecisionContextSource                @relation(fields: [sourceId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([tenantId, sourceId, externalKey])
  @@index([tenantId, status, eventKind])
  @@index([tenantId, scope, locationCode, status])
}

model DecisionGlobalContextEventRevision {
  id                 String                     @id @default(uuid()) @db.Uuid
  tenantId           String                     @db.Uuid
  eventId            String                     @db.Uuid
  revision           Int
  titleAr            String                     @db.VarChar(240)
  startsOn           DateTime                   @db.Date
  endsOn             DateTime                   @db.Date
  sourceUpdatedAt    DateTime?                  @db.Timestamptz(6)
  sourceChecksum     String                     @db.Char(64)
  importReceipt      Json
  verificationStatus DecisionVerificationStatus @default(SYSTEM_RECONCILED)
  status             DecisionContextEventStatus @default(PUBLISHED)
  createdAt          DateTime                   @default(now()) @db.Timestamptz(6)

  event                         DecisionGlobalContextEvent     @relation(fields: [eventId, tenantId], references: [id, tenantId], onDelete: Restrict)
  marketingCampaignContextLinks MarketingCampaignContextLink[]

  @@unique([id, tenantId])
  @@unique([eventId, revision])
  @@index([tenantId, startsOn, endsOn, status])
}

/// A human decision about an imported change. The imported revision remains
/// immutable; approval publishes an immutable successor and dismissal leaves
/// the last published revision in force.
model DecisionGlobalContextReviewAction {
  id              String                          @id @default(uuid()) @db.Uuid
  tenantId        String                          @db.Uuid
  eventId         String                          @db.Uuid
  revision        Int
  action          DecisionContextReviewActionKind
  reason          String                          @db.VarChar(500)
  createdByUserId String                          @db.Uuid
  createdAt       DateTime                        @default(now()) @db.Timestamptz(6)

  event DecisionGlobalContextEvent @relation(fields: [eventId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@unique([eventId, revision])
  @@index([tenantId, createdAt])
}

/// Company events are recorded context, not a mutation of financial facts.
model DecisionCompanyContextEvent {
  id                 String                     @id @default(uuid()) @db.Uuid
  tenantId           String                     @db.Uuid
  companyId          String                     @db.Uuid
  eventKind          String                     @db.VarChar(80)
  titleAr            String                     @db.VarChar(240)
  startsOn           DateTime                   @db.Date
  endsOn             DateTime                   @db.Date
  verificationStatus DecisionVerificationStatus @default(HUMAN_CONFIRMED)
  status             DecisionContextEventStatus @default(PUBLISHED)
  sourceReference    String?                    @db.VarChar(500)
  createdByUserId    String                     @db.Uuid
  createdAt          DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @db.Timestamptz(6)

  company                       Company                        @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  marketingCampaignContextLinks MarketingCampaignContextLink[]

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, startsOn, endsOn, status])
}

model DecisionEvaluationRun {
  id             String                    @id @default(uuid()) @db.Uuid
  tenantId       String                    @db.Uuid
  companyId      String                    @db.Uuid
  ruleCode       String                    @db.VarChar(120)
  ruleVersion    String                    @db.VarChar(80)
  periodFrom     DateTime                  @db.Date
  periodTo       DateTime                  @db.Date
  dataQuality    DecisionDataQualityStatus
  inputsChecksum String                    @db.Char(64)
  outcomeJson    Json
  createdAt      DateTime                  @default(now()) @db.Timestamptz(6)

  company Company @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([companyId, ruleCode, ruleVersion, periodFrom, periodTo, inputsChecksum])
  @@index([tenantId, companyId, createdAt])
}

/// Immutable proof captured only for decisions, alerts, retained analyses and
/// auditable AI answers. Corrections create a superseding snapshot.
model DecisionEvidenceSnapshot {
  id                   String                     @id @default(uuid()) @db.Uuid
  tenantId             String                     @db.Uuid
  companyId            String                     @db.Uuid
  sourceReportRunId    String?                    @db.Uuid
  supersedesSnapshotId String?                    @db.Uuid
  evidenceKind         DecisionEvidenceKind
  verificationStatus   DecisionVerificationStatus
  periodFrom           DateTime                   @db.Date
  periodTo             DateTime                   @db.Date
  timezone             String                     @default("Asia/Riyadh") @db.VarChar(64)
  payloadJson          Json
  checksum             String                     @db.Char(64)
  createdByUserId      String?                    @db.Uuid
  createdAt            DateTime                   @default(now()) @db.Timestamptz(6)

  company             Company                    @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  sourceReportRun     ReportRun?                 @relation(fields: [sourceReportRunId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  supersedes          DecisionEvidenceSnapshot?  @relation("DecisionEvidenceSupersedes", fields: [supersedesSnapshotId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  replacements        DecisionEvidenceSnapshot[] @relation("DecisionEvidenceSupersedes")
  alerts              DecisionAlert[]
  aiExecutionReceipts AiExecutionReceipt[]
  aiInterpretations   AiInterpretation[]

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, createdAt])
  @@index([tenantId, companyId, sourceReportRunId])
}

model DecisionAlert {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @db.Uuid
  companyId          String              @db.Uuid
  evaluationRunId    String              @db.Uuid
  evidenceSnapshotId String              @db.Uuid
  ruleCode           String              @db.VarChar(120)
  ruleVersion        String              @db.VarChar(80)
  status             DecisionAlertStatus @default(OPEN)
  titleAr            String              @db.VarChar(240)
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  acknowledgedAt     DateTime?           @db.Timestamptz(6)
  closedAt           DateTime?           @db.Timestamptz(6)

  company          Company                  @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  evidenceSnapshot DecisionEvidenceSnapshot @relation(fields: [evidenceSnapshotId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  actions          DecisionAlertAction[]
  feedback         DecisionFeedback[]

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, status, createdAt])
  @@index([tenantId, companyId, ruleCode, createdAt])
}

/// Append-only human lifecycle record. It preserves the reason behind an
/// acknowledgement or closure without mutating the immutable evidence.
model DecisionAlertAction {
  id              String                  @id @default(uuid()) @db.Uuid
  tenantId        String                  @db.Uuid
  companyId       String                  @db.Uuid
  alertId         String                  @db.Uuid
  action          DecisionAlertActionKind
  reason          String                  @db.VarChar(500)
  createdByUserId String                  @db.Uuid
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)

  company Company       @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  alert   DecisionAlert @relation(fields: [alertId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, alertId, createdAt])
}

model DecisionFeedback {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  companyId       String   @db.Uuid
  alertId         String   @db.Uuid
  kind            String   @db.VarChar(80)
  note            String?  @db.VarChar(2000)
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  company Company       @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  alert   DecisionAlert @relation(fields: [alertId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, alertId, createdAt])
}

/// Owner-only central configuration for the Inbound Evidence Hub. Labels are
/// tenant-scoped deliberately: one owner mailbox may contain evidence for
/// several companies, while no company user can query this module.
model InboundEvidenceLabel {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  nameAr          String   @db.VarChar(80)
  nameEn          String?  @db.VarChar(80)
  nameKey         String   @db.VarChar(120)
  colorHex        String   @db.Char(7)
  sortOrder       Int      @default(100)
  systemKey       String?  @db.VarChar(80)
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  tenant        Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  rules         InboundEvidenceRule[]
  messageLabels InboundEvidenceMessageLabel[]

  @@unique([id, tenantId])
  @@unique([tenantId, nameKey])
  @@unique([tenantId, systemKey])
  @@index([tenantId, sortOrder])
}

/// A rule is an owner-authored, declarative Label action. It never calls a
/// provider or performs a financial command; it will be applied only after a
/// governed connector imports an evidence record in a later gate.
model InboundEvidenceRule {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @db.Uuid
  labelId             String   @db.Uuid
  name                String   @db.VarChar(120)
  enabled             Boolean  @default(true)
  priority            Int      @default(100)
  senderContains      String?  @db.VarChar(240)
  subjectContains     String?  @db.VarChar(240)
  attachmentCondition String   @default("ANY") @db.VarChar(16)
  createdByUserId     String   @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)

  tenant Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  label  InboundEvidenceLabel @relation(fields: [labelId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, enabled, priority])
  @@index([tenantId, labelId])
}

/// Tenant-level idempotency is intentionally separate from company financial
/// receipts: the central mailbox has no selected company and cannot post.
model InboundEvidenceCommandReceipt {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  actorUserId    String   @db.Uuid
  operation      String   @db.VarChar(120)
  idempotencyKey String   @db.VarChar(255)
  requestHash    String   @db.Char(64)
  responseJson   Json
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, actorUserId, operation, idempotencyKey])
  @@index([tenantId, expiresAt])
}

/// One encrypted Gmail mailbox connection for the tenant-owner evidence hub.
/// Credentials never leave the server and are kept outside ordinary audit data.
model InboundEvidenceGmailConnection {
  id                   String                               @id @default(uuid()) @db.Uuid
  tenantId             String                               @unique @db.Uuid
  status               InboundEvidenceGmailConnectionStatus @default(NOT_CONNECTED)
  mailboxEmail         String?                              @db.VarChar(320)
  credentialCiphertext String?                              @db.Text
  credentialIv         String?                              @db.VarChar(64)
  credentialTag        String?                              @db.VarChar(64)
  credentialKeyVersion Int?
  accessTokenExpiresAt DateTime?                            @db.Timestamptz(6)
  gmailHistoryId       String?                              @db.VarChar(80)
  lastSyncedAt         DateTime?                            @db.Timestamptz(6)
  lastErrorCode        String?                              @db.VarChar(80)
  createdByUserId      String?                              @db.Uuid
  updatedByUserId      String?                              @db.Uuid
  createdAt            DateTime                             @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                             @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, status])
}

/// Single-use PKCE/nonce material for an owner-initiated Gmail consent flow.
model InboundEvidenceGmailOAuthState {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  initiatedByUserId String    @db.Uuid
  stateHash         String    @unique @db.Char(64)
  nonceHash         String    @db.Char(64)
  verifierEncrypted String    @db.Text
  verifierIv        String    @db.VarChar(64)
  verifierTag       String    @db.VarChar(64)
  expiresAt         DateTime  @db.Timestamptz(6)
  consumedAt        DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, expiresAt])
}

/// Imported mail metadata. Message bodies and provider attachments are not
/// trusted instructions or financial truth; they remain evidence only.
model InboundEvidenceMessage {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  gmailMessageId String    @db.VarChar(120)
  gmailThreadId  String?   @db.VarChar(120)
  sender         String?   @db.VarChar(600)
  subject        String?   @db.VarChar(998)
  snippet        String?   @db.Text
  receivedAt     DateTime? @db.Timestamptz(6)
  hasAttachments Boolean   @default(false)
  rawChecksum    String    @db.Char(64)
  importedAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  tenant      Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  attachments InboundEvidenceAttachment[]
  labels      InboundEvidenceMessageLabel[]

  @@unique([tenantId, gmailMessageId])
  @@unique([id, tenantId])
  @@index([tenantId, receivedAt])
}

/// Encrypted local copy of an attachment downloaded from Gmail. The original
/// source reference and checksum make re-download and review auditable.
model InboundEvidenceAttachment {
  id                String                          @id @default(uuid()) @db.Uuid
  tenantId          String                          @db.Uuid
  messageId         String                          @db.Uuid
  gmailAttachmentId String                          @db.VarChar(180)
  gmailPartId       String                          @db.VarChar(80)
  fileName          String                          @db.VarChar(500)
  mimeType          String                          @db.VarChar(160)
  byteSize          BigInt                          @db.BigInt
  status            InboundEvidenceAttachmentStatus
  sha256            String?                         @db.Char(64)
  storageReference  String?                         @db.VarChar(500)
  encryptionIv      String?                         @db.VarChar(64)
  scannerName       String?                         @db.VarChar(120)
  scannerResult     String?                         @db.VarChar(240)
  retentionUntil    DateTime?                       @db.Timestamptz(6)
  downloadedAt      DateTime?                       @db.Timestamptz(6)
  createdAt         DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                        @updatedAt @db.Timestamptz(6)

  tenant   Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  message  InboundEvidenceMessage            @relation(fields: [messageId, tenantId], references: [id, tenantId], onDelete: Restrict)
  analyses InboundEvidenceDocumentAnalysis[]

  @@unique([tenantId, messageId, gmailAttachmentId])
  @@unique([id, tenantId])
  @@index([tenantId, messageId])
  @@index([tenantId, status, retentionUntil])
}

/// Immutable, versioned output of the visual document-intelligence skill.
/// It stores only validated structured findings and provenance — never a raw
/// provider transcript, prompt, or provider credential.
model InboundEvidenceDocumentAnalysis {
  id                   String                        @id @default(uuid()) @db.Uuid
  tenantId             String                        @db.Uuid
  attachmentId         String                        @db.Uuid
  supersedesId         String?                       @db.Uuid
  status               InboundEvidenceAnalysisStatus
  sourceSha256         String                        @db.Char(64)
  skillKey             String                        @db.VarChar(120)
  skillVersion         Int
  policyVersion        Int
  provider             AiProviderKind
  model                String                        @db.VarChar(160)
  configurationVersion Int
  promptVersion        Int
  schemaVersion        Int
  resultJson           Json
  validationJson       Json
  resultChecksum       String                        @db.Char(64)
  requestId            String                        @db.VarChar(120)
  createdByUserId      String                        @db.Uuid
  createdAt            DateTime                      @default(now()) @db.Timestamptz(6)

  tenant     Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Restrict)

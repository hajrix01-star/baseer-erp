/// A durable, encrypted explanation. Its exact reuse key is intentionally not
/// unique: an expired interpretation is replaced by a new immutable row. A
/// partial unique PENDING run index performs the single-flight coordination.
model AiInterpretation {
  id                       String                      @id @default(uuid()) @db.Uuid
  tenantId                 String                      @db.Uuid
  companyId                String                      @db.Uuid
  subjectKind              AiInterpretationSubjectKind
  subjectId                String                      @db.Uuid
  evidenceSnapshotId       String                      @db.Uuid
  evidenceChecksum         String                      @db.Char(64)
  reuseKey                 String                      @db.Char(64)
  skillKey                 String                      @db.VarChar(120)
  skillVersion             Int
  policyVersion            Int
  promptVersion            Int
  language                 String                      @db.VarChar(2)
  systemIdentityVersion    Int?
  companyContextDigest     String                      @db.Char(64)
  modelProfileDigest       String                      @db.Char(64)
  providerSnapshot         AiProviderKind
  modelSnapshot            String                      @db.VarChar(160)
  sourceExecutionReceiptId String                      @db.Uuid
  encryptedOutput          String
  outputIv                 String                      @db.VarChar(64)
  outputTag                String                      @db.VarChar(64)
  outputKeyVersion         Int
  outputChecksum           String                      @db.Char(64)
  expiresAt                DateTime?                   @db.Timestamptz(6)
  createdByUserId          String                      @db.Uuid
  createdAt                DateTime                    @default(now()) @db.Timestamptz(6)

  company                Company                     @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  evidenceSnapshot       DecisionEvidenceSnapshot    @relation(fields: [evidenceSnapshotId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  sourceExecutionReceipt AiExecutionReceipt          @relation("AiInterpretationSourceReceipt", fields: [sourceExecutionReceiptId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  placements             AiInterpretationPlacement[]
  runs                   AiInterpretationRun[]
  humanInsights          AiHumanInsight[]

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, reuseKey, createdAt])
  @@index([tenantId, companyId, subjectKind, subjectId, createdAt])
  @@index([tenantId, companyId, evidenceSnapshotId, createdAt])
}

/// A short lease that prevents two manual requests for the same exact input
/// from calling the provider concurrently. It may transition operationally;
/// it never contains the model output.
model AiInterpretationRun {
  id               String                    @id @default(uuid()) @db.Uuid
  tenantId         String                    @db.Uuid
  companyId        String                    @db.Uuid
  reuseKey         String                    @db.Char(64)
  status           AiInterpretationRunStatus @default(PENDING)
  leaseExpiresAt   DateTime                  @db.Timestamptz(6)
  claimedByUserId  String                    @db.Uuid
  interpretationId String?                   @db.Uuid
  safeFailureCode  String?                   @db.VarChar(120)
  createdAt        DateTime                  @default(now()) @db.Timestamptz(6)
  completedAt      DateTime?                 @db.Timestamptz(6)

  company           Company              @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  interpretation    AiInterpretation?    @relation(fields: [interpretationId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  budgetReservation AiBudgetReservation?

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, reuseKey, status, leaseExpiresAt])
}

/// A code-owned price revision. It contains no tenant data and is never
/// editable through the product UI. The runtime fails closed when a selected
/// provider/model has no current price revision.
model AiModelPriceRevision {
  id                       String         @id @default(uuid()) @db.Uuid
  provider                 AiProviderKind
  model                    String         @db.VarChar(160)
  version                  Int
  effectiveFrom            DateTime       @db.Timestamptz(6)
  inputUsdPerMillion       Decimal        @db.Decimal(18, 8)
  cachedInputUsdPerMillion Decimal        @db.Decimal(18, 8)
  outputUsdPerMillion      Decimal        @db.Decimal(18, 8)
  sourceReference          String         @db.VarChar(500)
  createdAt                DateTime       @default(now()) @db.Timestamptz(6)

  budgetReservations  AiBudgetReservation[]
  usageLedgerEntries  AiUsageLedger[]
  aiExecutionReceipts AiExecutionReceipt[]

  @@unique([provider, model, version])
  @@index([provider, model, effectiveFrom])
}

/// One provider-call budget reservation per operational interpretation run.
/// Reused, blocked, and deterministic responses never create this row.
model AiBudgetReservation {
  id                      String                    @id @default(uuid()) @db.Uuid
  tenantId                String                    @db.Uuid
  companyId               String                    @db.Uuid
  providerConfigurationId String                    @db.Uuid
  skillActivationId       String                    @db.Uuid
  interpretationRunId     String                    @db.Uuid
  modelPriceRevisionId    String                    @db.Uuid
  dayStartAt              DateTime                  @db.Timestamptz(6)
  status                  AiBudgetReservationStatus @default(RESERVED)
  inputTokenEstimate      Int
  maxOutputTokens         Int
  estimatedCostUsd        Decimal                   @db.Decimal(18, 8)
  chargeCostUsd           Decimal                   @db.Decimal(18, 8)
  actualCostUsd           Decimal?                  @db.Decimal(18, 8)
  expiresAt               DateTime                  @db.Timestamptz(6)
  settledAt               DateTime?                 @db.Timestamptz(6)
  releasedAt              DateTime?                 @db.Timestamptz(6)
  releaseReason           String?                   @db.VarChar(120)
  createdAt               DateTime                  @default(now()) @db.Timestamptz(6)

  company               Company                 @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  providerConfiguration AiProviderConfiguration @relation(fields: [providerConfigurationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  skillActivation       AiSkillActivation       @relation(fields: [skillActivationId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  interpretationRun     AiInterpretationRun     @relation(fields: [interpretationRunId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  modelPriceRevision    AiModelPriceRevision    @relation(fields: [modelPriceRevisionId], references: [id], onDelete: Restrict)
  ledgerEntries         AiUsageLedger[]

  @@unique([id, tenantId, companyId])
  @@unique([interpretationRunId, tenantId, companyId])
  @@index([tenantId, providerConfigurationId, dayStartAt, status])
  @@index([tenantId, companyId, skillActivationId, dayStartAt, status])
}

/// Immutable metering entries. Monetary values are USD because model prices
/// are published in USD; presentation may convert separately with a dated FX
/// source, never during limit enforcement.
model AiUsageLedger {
  id                      String            @id @default(uuid()) @db.Uuid
  tenantId                String            @db.Uuid
  companyId               String            @db.Uuid
  reservationId           String            @db.Uuid
  executionReceiptId      String?           @db.Uuid
  providerConfigurationId String            @db.Uuid
  skillActivationId       String            @db.Uuid
  modelPriceRevisionId    String            @db.Uuid
  kind                    AiUsageLedgerKind
  inputTokens             Int?
  cachedInputTokens       Int?
  outputTokens            Int?
  reasoningTokens         Int?
  estimatedCostUsd        Decimal           @db.Decimal(18, 8)
  actualCostUsd           Decimal?          @db.Decimal(18, 8)
  safeReasonCode          String?           @db.VarChar(120)
  createdAt               DateTime          @default(now()) @db.Timestamptz(6)

  company               Company                 @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)

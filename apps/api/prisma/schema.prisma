  toneInstructions   String                  @db.VarChar(2000)
  safetyInstructions String                  @db.VarChar(4000)
  policyReference    String?                 @db.VarChar(160)
  createdAt          DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(6)

  company           Company              @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  executionReceipts AiExecutionReceipt[]

  @@unique([id, tenantId, companyId])
  @@unique([companyId, version])
  @@index([tenantId, companyId, status])
}

model AiExecutionReceipt {
  id                      String             @id @default(uuid()) @db.Uuid
  tenantId                String             @db.Uuid
  companyId               String             @db.Uuid
  providerConfigurationId String?            @db.Uuid
  identityId              String?            @db.Uuid
  systemIdentityId        String?            @db.Uuid
  moduleKey               String             @db.VarChar(80)
  capability              String             @db.VarChar(120)
  skillKey                String?            @db.VarChar(120)
  skillVersion            Int?
  policyVersion           Int?
  outcome                 AiExecutionOutcome
  providerSnapshot        AiProviderKind?
  modelSnapshot           String?            @db.VarChar(160)
  configurationVersion    Int?
  identityVersion         Int?
  systemIdentityVersion   Int?
  inputCharacters         Int                @default(0)
  outputCharacters        Int                @default(0)
  safeErrorCode           String?            @db.VarChar(120)
  requestId               String             @db.VarChar(120)
  createdAt               DateTime           @default(now()) @db.Timestamptz(6)

  company               Company                  @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  providerConfiguration AiProviderConfiguration? @relation(fields: [providerConfigurationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  identity              AiCompanyIdentity?       @relation(fields: [identityId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  systemIdentity        AiSystemIdentity?        @relation(fields: [systemIdentityId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, createdAt])
  @@index([tenantId, companyId, moduleKey, capability, createdAt])
  @@index([tenantId, companyId, skillKey, createdAt])
  @@index([tenantId, systemIdentityId, createdAt])
}

model AiSystemIdentity {
  id                 String                  @id @default(uuid()) @db.Uuid
  tenantId           String                  @db.Uuid
  version            Int
  status             AiCompanyIdentityStatus @default(ACTIVE)
  assistantNameAr    String                  @db.VarChar(80)
  assistantNameEn    String                  @db.VarChar(80)

/// P1 owns only an internal campaign register. Provider facts, OAuth tokens,
/// Google locations and external publishing belong to later, separate gates.
model MarketingCampaign {
  id                  String                    @id @default(uuid()) @db.Uuid
  tenantId            String                    @db.Uuid
  companyId           String                    @db.Uuid
  titleAr             String                    @db.VarChar(160)
  titleEn             String?                   @db.VarChar(160)
  platform            MarketingCampaignPlatform @default(MANUAL)
  externalReference   String?                   @db.VarChar(160)
  startsOn            DateTime?                 @db.Date
  endsOn              DateTime?                 @db.Date
  status              MarketingCampaignStatus   @default(DRAFT)
  stoppedOn           DateTime?                 @db.Date
  stoppedReason       String?                   @db.VarChar(500)
  objective           String?                   @db.VarChar(500)
  notes               String?                   @db.VarChar(2000)
  plannedCost         Decimal?                  @db.Decimal(18, 4)
  plannedCurrencyCode String?                   @db.Char(3)
  createdByUserId     String                    @db.Uuid
  createdAt           DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                  @updatedAt @db.Timestamptz(6)

  company          Company                             @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  financialLinks   MarketingCampaignFinancialLink[]
  contextLinks     MarketingCampaignContextLink[]
  analysisFeedback MarketingCampaignAnalysisFeedback[]

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, status, startsOn])
  @@index([tenantId, companyId, platform, createdAt])
}

/// Structured human feedback about a retained campaign explanation. This is
/// training/evaluation evidence only: it never changes the campaign, facts,
/// comparison policy, or any financial record.
model MarketingCampaignAnalysisFeedback {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  companyId          String   @db.Uuid
  campaignId         String   @db.Uuid
  evidenceSnapshotId String   @db.Uuid
  kind               String   @db.VarChar(80)
  note               String?  @db.VarChar(1000)
  createdByUserId    String   @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  company  Company           @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  campaign MarketingCampaign @relation(fields: [campaignId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, campaignId, createdAt])
  @@index([tenantId, companyId, evidenceSnapshotId, createdAt])
}

/// A one-way, company-scoped reference to an existing posted Finance document.
/// Marketing never changes the document or copies it into a new monetary truth.
model MarketingCampaignFinancialLink {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @db.Uuid
  companyId           String   @db.Uuid
  campaignId          String   @db.Uuid
  financialDocumentId String   @db.Uuid
  createdByUserId     String   @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(6)

  company           Company                @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  campaign          MarketingCampaign      @relation(fields: [campaignId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  financialDocument FinanceOutflowDocument @relation(fields: [financialDocumentId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([financialDocumentId, tenantId, companyId])
  @@index([tenantId, companyId, campaignId, createdAt])
}

/// A campaign may explicitly cite a published global-event revision or a
/// published company event. The link is context only, never causal evidence.
model MarketingCampaignContextLink {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @db.Uuid
  companyId               String   @db.Uuid
  campaignId              String   @db.Uuid
  globalContextRevisionId String?  @db.Uuid
  companyContextEventId   String?  @db.Uuid
  createdByUserId         String   @db.Uuid
  createdAt               DateTime @default(now()) @db.Timestamptz(6)

  company               Company                             @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  campaign              MarketingCampaign                   @relation(fields: [campaignId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  globalContextRevision DecisionGlobalContextEventRevision? @relation(fields: [globalContextRevisionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  companyContextEvent   DecisionCompanyContextEvent?        @relation(fields: [companyContextEventId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([campaignId, globalContextRevisionId])
  @@unique([campaignId, companyContextEventId])
  @@index([tenantId, companyId, campaignId, createdAt])
}

/// A company-owned planning target for a calendar month. It is a target only:

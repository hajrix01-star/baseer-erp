  companyId       String   @db.Uuid
  currentRevision BigInt   @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  company Company @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([tenantId, companyId])
  @@unique([companyId, tenantId])
}

/// Immutable server-side report snapshot metadata. R0-B stores the source
/// boundary only; report rows and HTTP/UI delivery start in later gates.
model ReportRun {
  id                            String          @id @default(uuid()) @db.Uuid
  tenantId                      String          @db.Uuid
  companyId                     String          @db.Uuid
  reportCode                    String          @db.VarChar(80)
  definitionVersion             String          @db.VarChar(80)
  canonicalOptionsJson          Json
  economicAsOfDate              DateTime        @db.Date
  ledgerRevision                BigInt
  eligibleEntryPredicateVersion String          @db.VarChar(80)
  projectionWatermarkJson       Json?
  sourceCoverageJson            Json
  accountMappingVersionId       String?         @db.Uuid
  accountMappingChecksum        String?         @db.Char(64)
  checksum                      String          @db.Char(64)
  status                        ReportRunStatus @default(READY)
  expiresAt                     DateTime        @db.Timestamptz(6)
  outputJobId                   String?         @db.Uuid
  createdByUserId               String          @db.Uuid
  createdAt                     DateTime        @default(now()) @db.Timestamptz(6)

  company   Company @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy User    @relation(fields: [createdByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  documents ReportDocument[]

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, reportCode, createdAt])
  @@index([tenantId, companyId, status, expiresAt])
  @@index([tenantId, companyId, ledgerRevision])
}

/// A user-retained, immutable rendering snapshot of a report run. A document
/// is created only by an explicit action; merely viewing a report never writes
/// one. Its JSON payload is the source for later print and Excel rendering.
model ReportDocument {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  companyId        String   @db.Uuid
  reportRunId      String   @db.Uuid
  reportCode       String   @db.VarChar(80)
  locale           String   @db.VarChar(2)
  titleAr          String   @db.VarChar(240)
  titleEn          String   @db.VarChar(240)
  snapshotJson     Json
  snapshotChecksum String   @db.Char(64)
  createdByUserId  String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company   Company   @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reportRun ReportRun @relation(fields: [reportRunId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  createdBy User     @relation("ReportDocumentCreator", fields: [createdByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([reportRunId, createdByUserId, locale])
  @@index([tenantId, companyId, createdByUserId, createdAt])
  @@index([tenantId, companyId, reportCode, createdAt])
}

/// Immutable event read-model written atomically with an actual external
/// collection/payment and its sealed journal entry. Reversals append an
/// opposite event; they never alter the original event.
model FinanceCashPerformanceEvent {
  id                         String                          @id @default(uuid()) @db.Uuid
  tenantId                   String                          @db.Uuid
  companyId                  String                          @db.Uuid
  kind                       FinanceCashPerformanceEventKind
  direction                  FinanceCashPerformanceDirection
  businessDate               DateTime                        @db.Date
  grossAmount                Decimal                         @db.Decimal(18, 4)
  netAmount                  Decimal                         @db.Decimal(18, 4)
  vatAmount                  Decimal                         @db.Decimal(18, 4)
  vatBreakdownKnown          Boolean                         @default(true)
  categoryCodeSnapshot       String?                         @db.VarChar(80)
  categoryNameArSnapshot     String?                         @db.VarChar(160)
  categoryNameEnSnapshot     String?                         @db.VarChar(160)
  categoryKindSnapshot       FinanceCategoryKind?
  settlementDestinationsJson Json?
  sourceType                 String                          @db.VarChar(80)
  sourceId                   String                          @db.Uuid
  sourceJournalEntryId       String                          @db.Uuid
  ledgerRevision             BigInt
  reversalOfEventId          String?                         @unique @db.Uuid
  createdByUserId            String                          @db.Uuid
  createdAt                  DateTime                        @default(now()) @db.Timestamptz(6)

  company            Company                      @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  sourceJournalEntry FinanceJournalEntry          @relation("FinanceCashPerformanceEventJournal", fields: [sourceJournalEntryId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  reversalOfEvent    FinanceCashPerformanceEvent? @relation("FinanceCashPerformanceEventReversal", fields: [reversalOfEventId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  reversalEvent      FinanceCashPerformanceEvent? @relation("FinanceCashPerformanceEventReversal")

  @@unique([id, tenantId, companyId])
  @@unique([sourceJournalEntryId, tenantId, companyId])
  @@unique([reversalOfEventId, tenantId, companyId])
  @@index([tenantId, companyId, businessDate, kind, id])
  @@index([tenantId, companyId, ledgerRevision, businessDate, id])
  @@index([tenantId, companyId, sourceType, sourceId])
}

/// Immutable owner-approved boundary for the source-backed personal cash

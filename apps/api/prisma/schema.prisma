  amount          Decimal  @db.Decimal(18, 4)
  createdByUserId String   @db.Uuid
  updatedByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  company Company @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([companyId, periodMonth])
  @@index([tenantId, companyId, periodMonth])
}

/// Company-scoped, audited readiness state for a future Google connection.
/// The later OAuth gate adds a separate encrypted credential vault and account
/// mapping; those sensitive concepts deliberately do not exist in this model.
model MarketingProviderConnection {
  id                     String                            @id @default(uuid()) @db.Uuid
  tenantId               String                            @db.Uuid
  companyId              String                            @db.Uuid
  provider               MarketingProvider
  status                 MarketingProviderConnectionStatus @default(NOT_CONNECTED)
  setupRequestedAt       DateTime?                         @db.Timestamptz(6)
  setupRequestedByUserId String?                           @db.Uuid
  createdAt              DateTime                          @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                          @updatedAt @db.Timestamptz(6)

  company Company @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([tenantId, companyId, provider])
  @@index([tenantId, companyId, status])
}

/// One short-lived, single-use OAuth attempt. It is company-scoped and stores
/// only an encrypted PKCE verifier; no Google access or refresh token belongs
/// in this table.
model MarketingProviderOAuthState {
  id                String            @id @default(uuid()) @db.Uuid
  tenantId          String            @db.Uuid
  companyId         String            @db.Uuid
  provider          MarketingProvider
  initiatedByUserId String            @db.Uuid
  stateHash         String            @unique @db.VarChar(64)
  verifierEncrypted String            @db.Text
  verifierIv        String            @db.VarChar(64)
  verifierTag       String            @db.VarChar(64)
  expiresAt         DateTime          @db.Timestamptz(6)
  consumedAt        DateTime?         @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)

  @@index([tenantId, companyId, provider, expiresAt])
}

/// A company chooses the future handling of Google review ratings here. This
/// row has no provider identifiers, review content, credential or publishing
/// authority; a provider connection must independently prove consent before a
/// configured automatic action can ever run.
model MarketingReputationReplyPolicy {
  id                  String                                   @id @default(uuid()) @db.Uuid
  tenantId            String                                   @db.Uuid
  companyId           String                                   @db.Uuid
  automationStatus    MarketingReputationReplyAutomationStatus @default(DISABLED)
  authoringMethod     MarketingReputationReplyAuthoringMethod  @default(TEMPLATE)
  tone                MarketingReputationReplyTone             @default(WARM)
  languageMode        MarketingReputationReplyLanguageMode     @default(MATCH_REVIEW)
  autoFourFiveEnabled Boolean                                  @default(true)
  autoThreeIfSafe     Boolean                                  @default(true)
  signature           String?                                  @db.VarChar(160)
  revision            Int                                      @default(1)
  updatedByUserId     String                                   @db.Uuid
  createdAt           DateTime                                 @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                                 @updatedAt @db.Timestamptz(6)

  company Company @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([companyId, tenantId])
  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, automationStatus])
}

/// A user-retained, immutable rendering snapshot of a report run. A document
/// is created only by an explicit action; merely viewing a report never writes
/// one. Its JSON payload is the source for later print and Excel rendering.
model ReportDocument {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  companyId        String   @db.Uuid
  reportRunId      String   @db.Uuid
  reportCode       String   @db.VarChar(80)
  locale           String   @db.VarChar(2)
  titleAr          String   @db.VarChar(240)
  titleEn          String   @db.VarChar(240)
  snapshotJson     Json
  snapshotChecksum String   @db.Char(64)
  createdByUserId  String   @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company   Company   @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  reportRun ReportRun @relation(fields: [reportRunId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  createdBy User      @relation("ReportDocumentCreator", fields: [createdByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([reportRunId, createdByUserId, locale])
  @@index([tenantId, companyId, createdByUserId, createdAt])
  @@index([tenantId, companyId, reportCode, createdAt])
}

/// A quarterly VAT planning workspace. It is deliberately separate from the

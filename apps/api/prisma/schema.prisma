  supersedes InboundEvidenceDocumentAnalysis?  @relation("InboundEvidenceAnalysisSupersession", fields: [supersedesId, tenantId], references: [id, tenantId], onDelete: Restrict)
  successors InboundEvidenceDocumentAnalysis[] @relation("InboundEvidenceAnalysisSupersession")

  @@unique([id, tenantId])
  @@index([tenantId, attachmentId, createdAt])
  @@index([tenantId, sourceSha256, createdAt])
}

/// A mail item may be given several internal Labels. Gmail itself is read-only
/// in this connector and is never changed by this mapping.
model InboundEvidenceMessageLabel {
  tenantId  String   @db.Uuid
  messageId String   @db.Uuid
  labelId   String   @db.Uuid
  appliedBy String   @db.VarChar(24)
  appliedAt DateTime @default(now()) @db.Timestamptz(6)

  message InboundEvidenceMessage @relation(fields: [messageId, tenantId], references: [id, tenantId], onDelete: Cascade)
  label   InboundEvidenceLabel   @relation(fields: [labelId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([tenantId, messageId, labelId])
  @@index([tenantId, labelId])

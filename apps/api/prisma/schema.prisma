  reason             String?                                     @db.VarChar(1000)
  createdByUserId    String                                      @db.Uuid
  createdAt          DateTime                                    @default(now()) @db.Timestamptz(6)

  company   Company                           @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  deduction HrEmployeeAdministrativeDeduction @relation(fields: [deductionId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, deductionId, businessDate, id])
}

/// Effective-dated compensation is the sole source used to prepare a payroll
/// draft. A payroll line snapshots it on approval so a later salary change can
/// never rewrite a historical run.
model HrEmployeeCompensationProfile {
  id                   String               @id @default(uuid()) @db.Uuid
  tenantId             String               @db.Uuid
  companyId            String               @db.Uuid
  employeeId           String               @db.Uuid
  policyVersionId      String?              @db.Uuid
  effectiveFrom        DateTime             @db.Date
  effectiveTo          DateTime?            @db.Date
  monthlyGross         Decimal              @db.Decimal(18, 4)
  compensationMethod   HrCompensationMethod @default(FIXED_MONTHLY)
  foodAllowance        Decimal              @default(0) @db.Decimal(18, 4)
  housingAllowance     Decimal              @default(0) @db.Decimal(18, 4)
  transportAllowance   Decimal              @default(0) @db.Decimal(18, 4)
  otherAllowance       Decimal              @default(0) @db.Decimal(18, 4)
  scheduledHoursPerDay Int?
  scheduledWorkDays    Int?
  notes                String?              @db.VarChar(1000)
  createdByUserId      String               @db.Uuid
  createdAt            DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(6)

  company       Company                      @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  employee      HrEmployee                   @relation(fields: [employeeId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  policyVersion HrCompensationPolicyVersion? @relation("HrCompensationProfilePolicyVersion", fields: [policyVersionId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([companyId, employeeId, effectiveFrom])
  @@index([tenantId, companyId, employeeId, effectiveFrom])
}

/// Company-owned policy container. It does not contain employee amounts or a
/// client-supplied formula; those remain separate employee agreements.
model HrCompensationPolicy {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  companyId       String   @db.Uuid
  code            String   @db.VarChar(80)
  nameAr          String   @db.VarChar(160)
  nameEn          String?  @db.VarChar(160)
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)

  company  Company                       @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  versions HrCompensationPolicyVersion[]

  @@unique([id, tenantId, companyId])
  @@unique([companyId, code])
  @@index([tenantId, companyId, code])
}

/// Effective-dated, approved company policy revision. Historic versions are
/// never edited; approval closes only a preceding future/current interval.
model HrCompensationPolicyVersion {
  id               String                            @id @default(uuid()) @db.Uuid
  tenantId         String                            @db.Uuid
  companyId        String                            @db.Uuid
  policyId         String                            @db.Uuid
  versionNumber    Int
  effectiveFrom    DateTime                          @db.Date
  effectiveTo      DateTime?                         @db.Date
  status           HrCompensationPolicyVersionStatus @default(DRAFT)
  formulaCode      HrCompensationFormulaCode         @default(STANDARD_MONTHLY_V1)
  approvedByUserId String?                           @db.Uuid
  approvedAt       DateTime?                         @db.Timestamptz(6)
  createdByUserId  String                            @db.Uuid
  createdAt        DateTime                          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                          @updatedAt @db.Timestamptz(6)

  company              Company                         @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  policy               HrCompensationPolicy            @relation(fields: [policyId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  compensationProfiles HrEmployeeCompensationProfile[] @relation("HrCompensationProfilePolicyVersion")
  payrollLines         HrPayrollLine[]                 @relation("HrPayrollLinePolicyVersion")

  @@unique([id, tenantId, companyId])
  @@unique([policyId, versionNumber])
  @@unique([policyId, effectiveFrom])
  @@index([tenantId, companyId, policyId, status, effectiveFrom])
}

model HrPayrollRun {
  id                            String             @id @default(uuid()) @db.Uuid
  tenantId                      String             @db.Uuid
  companyId                     String             @db.Uuid
  runNumber                     String             @db.VarChar(80)
  payrollMonth                  DateTime           @db.Date
  businessDate                  DateTime           @db.Date
  status                        HrPayrollRunStatus @default(DRAFT)
  employeeCount                 Int                @default(0)
  grossAmount                   Decimal            @default(0) @db.Decimal(18, 4)
  advanceSettlementAmount       Decimal            @default(0) @db.Decimal(18, 4)
  administrativeDeductionAmount Decimal            @default(0) @db.Decimal(18, 4)
  netPayableAmount              Decimal            @default(0) @db.Decimal(18, 4)
  paidAmount                    Decimal            @default(0) @db.Decimal(18, 4)
  notes                         String?            @db.VarChar(2000)
  accrualJournalEntryId         String?            @db.Uuid
  approvedAt                    DateTime?          @db.Timestamptz(6)
  reversedAt                    DateTime?          @db.Timestamptz(6)
  reversalReason                String?            @db.VarChar(1000)
  createdByUserId               String             @db.Uuid
  createdAt                     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt                     DateTime           @updatedAt @db.Timestamptz(6)

  company        Company              @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  accrualJournal FinanceJournalEntry? @relation("HrPayrollAccrualJournal", fields: [accrualJournalEntryId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  lines          HrPayrollLine[]
  payments       HrPayrollPayment[]

  @@unique([id, tenantId, companyId])
  // The database enforces one *active* run per company/month with a partial
  // unique index. A reversed run stays immutable as audit history and must not
  // prevent a newly calculated replacement run for the same month.
  @@unique([companyId, runNumber])
  @@unique([accrualJournalEntryId, tenantId, companyId])
  @@index([tenantId, companyId, payrollMonth, status, id])
  @@index([tenantId, companyId, status, payrollMonth, id])
}


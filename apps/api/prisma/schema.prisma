  edges   OperationsItemConversionEdge[]
  recipeLines OperationsRecipeLine[] @relation("OperationsRecipeLineConversionVersion")
  purchaseRequestLines OperationsPurchaseRequestLine[] @relation("OperationsPurchaseRequestLineConversionVersion")
  purchaseReceiptLines OperationsPurchaseReceiptLine[] @relation("OperationsPurchaseReceiptLineConversionVersion")

  @@unique([id, tenantId, companyId])
  @@unique([itemId, version])

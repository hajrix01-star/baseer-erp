}

/// A personnel service is operational until its associated cost is issued.
/// The financial document is immutable and is never recreated by editing this record.
/// Blob lifecycle is independent of FileMetadata's reservation workflow. The
/// local storage reference is never returned to clients.
model HrEmployeeDocumentBlob {
  id               String               @id @db.Uuid
  tenantId         String               @db.Uuid
  companyId        String               @db.Uuid
  fileMetadataId   String               @unique @db.Uuid
  status           HrDocumentBlobStatus @default(STAGED)
  storageReference String               @unique @db.VarChar(255)
  encryptionIv     String               @db.Char(24)
  mimeType         String               @db.VarChar(127)
  byteSize         BigInt
  sha256           String               @db.Char(64)
  scannerName      String?              @db.VarChar(80)
  scannerResult    String?              @db.VarChar(160)
  scannedAt        DateTime?            @db.Timestamptz(6)
  revokedAt        DateTime?            @db.Timestamptz(6)
  createdByUserId  String               @db.Uuid
  createdAt        DateTime             @default(now()) @db.Timestamptz(6)

  company      Company                     @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  fileMetadata FileMetadata                @relation(fields: [fileMetadataId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  versions     HrEmployeeDocumentVersion[]

  @@unique([id, tenantId, companyId])
  @@unique([fileMetadataId, tenantId, companyId])
  @@index([tenantId, companyId, status, createdAt])
}


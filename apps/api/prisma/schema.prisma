model AiCompanyIdentity {
  id                 String                  @id @default(uuid()) @db.Uuid
  tenantId           String                  @db.Uuid
  companyId          String                  @db.Uuid
  version            Int
  status             AiCompanyIdentityStatus @default(ACTIVE)
  displayNameAr      String                  @db.VarChar(160)
  displayNameEn      String                  @db.VarChar(160)

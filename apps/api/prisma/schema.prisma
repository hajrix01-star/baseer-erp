  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @db.Uuid
  companyId              String    @db.Uuid
  year                   Int
  quarter                Int
  vatRateBasisPoints     Int
  salesTaxableAmount     Decimal   @default(0) @db.Decimal(18, 4)
  outputVatAmount        Decimal   @default(0) @db.Decimal(18, 4)
  purchasesTaxableAmount Decimal   @default(0) @db.Decimal(18, 4)
  inputVatAmount         Decimal   @default(0) @db.Decimal(18, 4)
  priorAdjustments       Decimal   @default(0) @db.Decimal(18, 4)
  balanceCarried         Decimal   @default(0) @db.Decimal(18, 4)
  paymentTarget          Decimal?  @db.Decimal(18, 4)
  notes                  String?   @db.VarChar(1000)

  executionReceipt      AiExecutionReceipt?     @relation(fields: [executionReceiptId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  providerConfiguration AiProviderConfiguration @relation(fields: [providerConfigurationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  skillActivation       AiSkillActivation       @relation(fields: [skillActivationId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  modelPriceRevision    AiModelPriceRevision    @relation(fields: [modelPriceRevisionId], references: [id], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, createdAt])
  @@index([tenantId, providerConfigurationId, createdAt])
  @@index([tenantId, companyId, skillActivationId, createdAt])
}

/// A placement only points to a shared explanation. Removing a placement can
/// never delete or mutate the explanation itself.
model AiInterpretationPlacement {
  id               String                        @id @default(uuid()) @db.Uuid
  tenantId         String                        @db.Uuid
  companyId        String                        @db.Uuid
  interpretationId String                        @db.Uuid

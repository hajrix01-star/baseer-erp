/// Employee master data is company-scoped and intentionally separate from a
/// sign-in user. An employee never receives platform access by being created.
model HrEmployee {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  companyId      String           @db.Uuid
  employeeNumber String           @db.VarChar(80)
  nameAr         String           @db.VarChar(160)
  nameEn         String?          @db.VarChar(160)
  jobTitle       String?          @db.VarChar(160)
  phone          String?          @db.VarChar(30)
  email          String?          @db.VarChar(254)
  iqamaNumber    String?          @db.VarChar(160)
  workSchedule   String?          @db.VarChar(160)
  hireDate       DateTime         @db.Date
  status         HrEmployeeStatus @default(ACTIVE)
  terminatedAt   DateTime?        @db.Date
  statusEffectiveAt DateTime?     @db.Date
  statusReason   String?          @db.VarChar(240)
  notes          String?          @db.VarChar(2000)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)

  company                       Company                                @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  services                      HrEmployeeService[]
  financialMovements            HrEmployeeFinancialMovement[]
  advances                      HrEmployeeAdvance[]
  administrativeDeductions      HrEmployeeAdministrativeDeduction[]
  compensationProfiles          HrEmployeeCompensationProfile[]
  promotions                    HrEmployeePromotion[]
  leaves                        HrEmployeeLeave[]
  payrollLines                  HrPayrollLine[]
  finalSettlements              HrFinalSettlement[]
  documents                     HrEmployeeDocument[]
  letters                       HrEmployeeLetter[]
  attendanceCredential          AttendanceEmployeeCredential?
  attendanceEvents              AttendanceEvent[]
  attendanceWorkSessions        AttendanceWorkSession[]
  attendanceScheduleAssignments AttendanceEmployeeScheduleAssignment[]
  attendanceWeeklyAdjustments   AttendanceEmployeeWeeklyAdjustment[]
  attendanceScheduleExceptions  AttendanceScheduleException[]
  attendanceRosterEntries       AttendanceRosterEntry[]
  workTerms                     HrEmployeeWorkTerms[]

  @@unique([id, tenantId, companyId])
  @@unique([companyId, employeeNumber])
  @@index([tenantId, companyId, status, nameAr])
  @@index([tenantId, companyId, employeeNumber, id])
  @@index([tenantId, companyId, status, employeeNumber, id], map: "HrEmployee_status_number_id_idx")
}

/// Authentication material for the employee-facing PWA.  It deliberately has
/// no User, AppSession, device, biometric, or raw-PIN relationship.
model AttendanceEmployeeCredential {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  companyId      String    @db.Uuid
  employeeId     String    @db.Uuid
  pinHash        String    @db.VarChar(100)
  pinLookupHash  String    @db.Char(64)
  pinCiphertext  String?   @db.Text
  failedAttempts Int       @default(0)
  lockedUntil    DateTime? @db.Timestamptz(6)
  rotatedAt      DateTime  @default(now()) @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  company  Company    @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  employee HrEmployee @relation(fields: [employeeId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Cascade)

  @@unique([id, tenantId, companyId])
  @@unique([companyId, employeeId])
  @@unique([employeeId, tenantId, companyId])
  @@unique([companyId, pinLookupHash])
  @@index([tenantId, companyId, employeeId])
}

model AttendanceBranch {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  companyId         String   @db.Uuid
  nameAr            String   @db.VarChar(160)
  nameEn            String?  @db.VarChar(160)
  latitude          Decimal  @db.Decimal(10, 7)
  longitude         Decimal  @db.Decimal(10, 7)
  radiusMeters      Int      @default(100)
  maxAccuracyMeters Int      @default(75)
  qrValiditySeconds Int      @default(45)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  company      Company                 @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  events       AttendanceEvent[]
  workSessions AttendanceWorkSession[]

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, isActive])
}

enum AttendanceEventType {
  CHECK_IN
  CHECK_OUT
  ADMIN_CHECK_OUT
}

enum AttendanceWorkSessionStatus {
  OPEN
  CLOSED
}

/// A named reusable schedule is never deleted once assigned.  Its operational
/// time rules live in immutable, effective-dated versions below.
enum AttendanceScheduleTemplateStatus {
  ACTIVE
  ARCHIVED
}

/// Employee-specific weekly overrides deliberately use actual periods rather
/// than a percentage so a "half day" is unambiguous for split/overnight work.
enum AttendanceWeeklyAdjustmentKind {
  FULL_REST
  CUSTOM_PERIODS
}

/// A dated exception is a request and approval record, not a silent rewrite of
/// either the employee schedule or immutable attendance evidence.
enum AttendanceScheduleExceptionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A roster is an explicit manager-owned plan. Drafts can change freely;
/// approved plans are immutable operational history, while permanent plans
/// are applied as future effective-dated employee schedule records.
enum AttendanceRosterPlanStatus {
  DRAFT
  APPROVED
  APPLIED
}

enum AttendanceRosterApprovalMode {
  WEEK
  TEMPORARY
  PERMANENT
}

model AttendanceRosterPlan {
  id               String                        @id @default(uuid()) @db.Uuid
  tenantId         String                        @db.Uuid
  companyId        String                        @db.Uuid
  weekStart        DateTime                      @db.Date
  status           AttendanceRosterPlanStatus    @default(DRAFT)
  approvalMode     AttendanceRosterApprovalMode?
  effectiveFrom    DateTime?                     @db.Date
  effectiveUntil   DateTime?                     @db.Date
  revision         Int                           @default(1)
  createdByUserId  String                        @db.Uuid
  approvedByUserId String?                       @db.Uuid
  approvedAt       DateTime?                     @db.Timestamptz(6)
  createdAt        DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                      @updatedAt @db.Timestamptz(6)

  company     Company                      @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  entries     AttendanceRosterEntry[]
  peakPeriods AttendanceRosterPeakPeriod[]

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, weekStart, status, updatedAt])
  @@index([tenantId, companyId, status, effectiveFrom, effectiveUntil, approvedAt])
}

/// Peak-demand windows are operational planning guidance only. They never
/// alter attendance evidence, working hours, overtime, or payroll.
model AttendanceRosterPeakPeriod {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  companyId    String   @db.Uuid
  planId       String   @db.Uuid
  businessDate DateTime @db.Date
  startMinute  Int
  endMinute    Int
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  company Company              @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  plan    AttendanceRosterPlan @relation(fields: [planId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Cascade)

  @@unique([id, tenantId, companyId])
  @@unique([planId, businessDate, startMinute, endMinute])
  @@index([tenantId, companyId, businessDate])
}

model AttendanceRosterEntry {
  id           String                         @id @default(uuid()) @db.Uuid
  tenantId     String                         @db.Uuid
  companyId    String                         @db.Uuid
  planId       String                         @db.Uuid
  employeeId   String                         @db.Uuid
  businessDate DateTime                       @db.Date
  kind         AttendanceWeeklyAdjustmentKind
  createdAt    DateTime                       @default(now()) @db.Timestamptz(6)

  company  Company                       @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  plan     AttendanceRosterPlan          @relation(fields: [planId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Cascade)
  employee HrEmployee                    @relation(fields: [employeeId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  periods  AttendanceRosterEntryPeriod[]

  @@unique([id, tenantId, companyId])
  @@unique([planId, employeeId, businessDate])
  @@index([tenantId, companyId, employeeId, businessDate])
}

model AttendanceRosterEntryPeriod {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  companyId   String   @db.Uuid
  entryId     String   @db.Uuid
  startMinute Int
  endMinute   Int
  endsNextDay Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  company Company               @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  entry   AttendanceRosterEntry @relation(fields: [entryId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Cascade)

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, entryId, startMinute])
}

model AttendanceScheduleTemplate {
  id         String                           @id @default(uuid()) @db.Uuid
  tenantId   String                           @db.Uuid
  companyId  String                           @db.Uuid
  nameAr     String                           @db.VarChar(160)
  nameEn     String?                          @db.VarChar(160)
  status     AttendanceScheduleTemplateStatus @default(ACTIVE)
  archivedAt DateTime?                        @db.Timestamptz(6)
  createdAt  DateTime                         @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime                         @updatedAt @db.Timestamptz(6)

  company     Company                                @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  versions    AttendanceScheduleTemplateVersion[]
  assignments AttendanceEmployeeScheduleAssignment[]

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, status, nameAr])
}

/// The row and its periods are append-only snapshots.  A later version takes
/// effect from its own date, so historical reporting remains reproducible.
model AttendanceScheduleTemplateVersion {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  companyId       String   @db.Uuid
  templateId      String   @db.Uuid
  versionNumber   Int
  effectiveFrom   DateTime @db.Date
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  company  Company                    @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  template AttendanceScheduleTemplate @relation(fields: [templateId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  periods  AttendanceSchedulePeriod[]

  @@unique([id, tenantId, companyId])
  @@unique([templateId, versionNumber])
  @@unique([templateId, effectiveFrom])
  @@index([tenantId, companyId, templateId, effectiveFrom])
}

/// ISO weekday: 1 Monday through 7 Sunday. `endsNextDay` is explicit so
/// 15:00-03:00 is a single overnight work period rather than an ambiguous day.
model AttendanceSchedulePeriod {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  companyId   String   @db.Uuid
  versionId   String   @db.Uuid
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  endsNextDay Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  company Company                           @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  version AttendanceScheduleTemplateVersion @relation(fields: [versionId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Cascade)

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, versionId, dayOfWeek, startMinute])
}

/// Adding a new row changes an employee's template only from its effective
/// date.  Historic assignments are immutable and never deleted.
model AttendanceEmployeeScheduleAssignment {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  companyId       String   @db.Uuid
  employeeId      String   @db.Uuid
  templateId      String   @db.Uuid
  effectiveFrom   DateTime @db.Date
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  company  Company                    @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  employee HrEmployee                 @relation(fields: [employeeId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  template AttendanceScheduleTemplate @relation(fields: [templateId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([employeeId, effectiveFrom])
  @@index([tenantId, companyId, employeeId, effectiveFrom])
}

/// Per-employee recurring weekly rest/partial-day adjustment.  A subsequent
/// row with the same weekday and a later effective date supersedes it only for
/// future business dates.
model AttendanceEmployeeWeeklyAdjustment {
  id              String                         @id @default(uuid()) @db.Uuid
  tenantId        String                         @db.Uuid
  companyId       String                         @db.Uuid
  employeeId      String                         @db.Uuid
  dayOfWeek       Int
  effectiveFrom   DateTime                       @db.Date
  kind            AttendanceWeeklyAdjustmentKind
  createdByUserId String                         @db.Uuid
  createdAt       DateTime                       @default(now()) @db.Timestamptz(6)

  company  Company                                    @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  employee HrEmployee                                 @relation(fields: [employeeId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  periods  AttendanceEmployeeWeeklyAdjustmentPeriod[]

  @@unique([id, tenantId, companyId])
  @@unique([employeeId, dayOfWeek, effectiveFrom])
  @@index([tenantId, companyId, employeeId, dayOfWeek, effectiveFrom])
}

model AttendanceEmployeeWeeklyAdjustmentPeriod {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  companyId    String   @db.Uuid
  adjustmentId String   @db.Uuid
  startMinute  Int
  endMinute    Int
  endsNextDay  Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  company    Company                            @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  adjustment AttendanceEmployeeWeeklyAdjustment @relation(fields: [adjustmentId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Cascade)

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, adjustmentId, startMinute])
}

model AttendanceScheduleException {
  id                String                            @id @default(uuid()) @db.Uuid
  tenantId          String                            @db.Uuid
  companyId         String                            @db.Uuid
  employeeId        String                            @db.Uuid
  businessDate      DateTime                          @db.Date
  kind              AttendanceWeeklyAdjustmentKind
  status            AttendanceScheduleExceptionStatus @default(PENDING)
  reason            String                            @db.VarChar(2000)
  requestedByUserId String                            @db.Uuid
  decidedByUserId   String?                           @db.Uuid
  decidedAt         DateTime?                         @db.Timestamptz(6)
  decisionNote      String?                           @db.VarChar(2000)
  createdAt         DateTime                          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                          @updatedAt @db.Timestamptz(6)

  company  Company                             @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  employee HrEmployee                          @relation(fields: [employeeId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  periods  AttendanceScheduleExceptionPeriod[]

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, employeeId, businessDate, status])
}

model AttendanceScheduleExceptionPeriod {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  companyId   String   @db.Uuid
  exceptionId String   @db.Uuid
  startMinute Int
  endMinute   Int
  endsNextDay Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  company   Company                     @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  exception AttendanceScheduleException @relation(fields: [exceptionId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Cascade)

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, exceptionId, startMinute])
}

/// Immutable evidence from an attendance operation. Coordinates remain here
/// for authorised review and are never copied into generic audit payloads.
model AttendanceEvent {
  id             String              @id @default(uuid()) @db.Uuid
  tenantId       String              @db.Uuid
  companyId      String              @db.Uuid
  branchId       String              @db.Uuid
  employeeId     String              @db.Uuid
  sessionId      String              @db.Uuid
  eventType      AttendanceEventType
  /// The operational workday is owned by the server and keeps an overnight
  /// checkout attached to the business date on which the work session started.
  businessDate   DateTime            @db.Date
  occurredAt     DateTime            @default(now()) @db.Timestamptz(6)
  latitude       Decimal?            @db.Decimal(10, 7)
  longitude      Decimal?            @db.Decimal(10, 7)
  accuracyMeters Decimal?            @db.Decimal(10, 2)
  qrTokenHash    String              @db.Char(64)
  requestKey     String              @db.VarChar(255)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)

  company  Company               @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  branch   AttendanceBranch      @relation(fields: [branchId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  employee HrEmployee            @relation(fields: [employeeId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  session  AttendanceWorkSession @relation(fields: [sessionId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([companyId, requestKey])
  @@index([tenantId, companyId, employeeId, occurredAt])
}

/// A kiosk QR is shared between employees during its short validity window,
/// but an individual employee may consume that exact signed challenge once.
/// This preserves kiosk throughput while stopping repeated scans of the same
/// photographed/current QR by the same attendance identity.
model AttendanceQrScanUse {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  companyId   String   @db.Uuid
  employeeId  String   @db.Uuid
  qrTokenHash String   @db.Char(64)
  expiresAt   DateTime @db.Timestamptz(6)
  usedAt      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([companyId, employeeId, qrTokenHash])
  @@index([tenantId, companyId, expiresAt])
}

model AttendanceWorkSession {
  id           String                      @id @default(uuid()) @db.Uuid
  tenantId     String                      @db.Uuid
  companyId    String                      @db.Uuid
  branchId     String                      @db.Uuid
  employeeId   String                      @db.Uuid
  status       AttendanceWorkSessionStatus @default(OPEN)
  businessDate DateTime                    @db.Date
  checkInAt    DateTime                    @db.Timestamptz(6)
  checkOutAt   DateTime?                   @db.Timestamptz(6)
  /// Administrative checkout preserves the employee's original check-in and
  /// records the responsible actor, reason, and server-recorded action time.
  adminClosedByUserId String?              @db.Uuid
  adminCloseReason   String?               @db.VarChar(2000)
  adminClosedAt      DateTime?             @db.Timestamptz(6)
  createdAt    DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                    @updatedAt @db.Timestamptz(6)

  company  Company           @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  branch   AttendanceBranch  @relation(fields: [branchId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  employee HrEmployee        @relation(fields: [employeeId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  events   AttendanceEvent[]

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, employeeId, status])
  @@index([tenantId, companyId, businessDate, employeeId])
  @@index([tenantId, companyId, employeeId, businessDate])
}

/// Effective-dated contractual work hours. Attendance schedules decide when
/// work occurs; this agreement remains the employee-file source of the daily
/// contracted minutes and is never silently changed by attendance planning.
model HrEmployeeWorkTerms {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  companyId         String    @db.Uuid
  employeeId        String    @db.Uuid
  effectiveFrom     DateTime  @db.Date
  effectiveTo       DateTime? @db.Date
  workMinutesPerDay Int
  notes             String?   @db.VarChar(1000)
  createdByUserId   String    @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(6)

  company      Company         @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  employee     HrEmployee      @relation(fields: [employeeId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  payrollLines HrPayrollLine[]

  @@unique([id, tenantId, companyId])
  @@unique([id, tenantId, companyId, employeeId])
  @@unique([companyId, employeeId, effectiveFrom])
  @@index([tenantId, companyId, employeeId, effectiveFrom])
}

/// An immutable, operational career-history event. Compensation remains in
/// HrEmployeeCompensationProfile so a promotion can never rewrite payroll
/// snapshots or post a financial entry by itself.
model HrEmployeePromotion {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  companyId         String   @db.Uuid
  employeeId        String   @db.Uuid
  effectiveDate     DateTime @db.Date
  previousJobTitle  String?  @db.VarChar(160)

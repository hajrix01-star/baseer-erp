  unit    OperationsUnit @relation("OperationsItemUnitUnit", fields: [unitId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([itemId, unitId])
  @@index([tenantId, companyId, itemId])
}

model OperationsItemConversionVersion {
  id          String                            @id @default(uuid()) @db.Uuid
  tenantId    String                            @db.Uuid
  companyId   String                            @db.Uuid
  itemId      String                            @db.Uuid

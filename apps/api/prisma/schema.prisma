  company Company                    @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  request OperationsPurchaseRequest? @relation(fields: [requestId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  receipt OperationsPurchaseReceipt? @relation(fields: [receiptId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([companyId, eventNumber])
  @@index([tenantId, companyId, effectiveAt])
}

model OperationsInventoryBalance {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  companyId         String   @db.Uuid
  rawMaterialItemId String   @db.Uuid
  baseQuantity      Decimal  @default(0) @db.Decimal(24, 8)
  totalValue        Decimal  @default(0) @db.Decimal(18, 4)
  weightedUnitCost  Decimal  @default(0) @db.Decimal(26, 12)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  company     Company        @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  rawMaterial OperationsItem @relation(fields: [rawMaterialItemId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([companyId, rawMaterialItemId])
  @@unique([rawMaterialItemId, tenantId, companyId])
  @@index([tenantId, companyId, rawMaterialItemId])
}

model OperationsInventoryMovement {
  id                                String                          @id @default(uuid()) @db.Uuid
  tenantId                          String                          @db.Uuid
  companyId                         String                          @db.Uuid
  rawMaterialItemId                 String                          @db.Uuid
  receiptId                         String?                         @db.Uuid
  internalRegistrationConsumptionId String?                         @db.Uuid
  movementNumber                    String                          @db.VarChar(80)
  movementType                      OperationsInventoryMovementType
  baseQuantityDelta                 Decimal                         @db.Decimal(24, 8)
  valueDelta                        Decimal                         @db.Decimal(18, 4)
  quantityAfter                     Decimal                         @db.Decimal(24, 8)
  valueAfter                        Decimal                         @db.Decimal(18, 4)
  weightedUnitCostAfter             Decimal                         @db.Decimal(26, 12)
  businessDate                      DateTime                        @db.Date
  effectiveAt                       DateTime                        @default(now()) @db.Timestamptz(6)
  createdByUserId                   String                          @db.Uuid

  company                         Company                                    @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  rawMaterial                     OperationsItem                             @relation(fields: [rawMaterialItemId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  receipt                         OperationsPurchaseReceipt?                 @relation(fields: [receiptId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  internalRegistrationConsumption OperationsInternalRegistrationConsumption? @relation(fields: [internalRegistrationConsumptionId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([companyId, movementNumber])
  @@unique([internalRegistrationConsumptionId], map: "OperationsInventoryMovement_internalConsumption_single_key")
  @@unique([internalRegistrationConsumptionId, tenantId, companyId], map: "OperationsInventoryMovement_internalConsumption_tenant_key")
  @@index([tenantId, companyId, rawMaterialItemId, effectiveAt])
}

  @@index([tenantId, companyId, rawMaterialItemId])
}

model OperationsPurchaseRequest {
  id                   String                          @id @default(uuid()) @db.Uuid
  tenantId             String                          @db.Uuid
  companyId            String                          @db.Uuid
  requestNumber        String                          @db.VarChar(80)
  executionKind        OperationsPurchaseExecutionKind
  plannedPaymentChannel OperationsPurchasePaymentChannel
  status               OperationsPurchaseRequestStatus @default(PENDING_RECEIPT)
  businessDate         DateTime                        @db.Date
  custodyFundingAmount Decimal?                        @db.Decimal(18, 4)
  representativeName   String?                         @db.VarChar(160)
  notes                String?                         @db.VarChar(1000)
  requestedByUserId    String                          @db.Uuid
  requestedAt          DateTime                        @default(now()) @db.Timestamptz(6)
  receivedAt           DateTime?                       @db.Timestamptz(6)
  cancelledAt          DateTime?                       @db.Timestamptz(6)
  cancelledByUserId    String?                         @db.Uuid
  cancellationReason   String?                         @db.VarChar(1000)
  createdAt            DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                        @updatedAt @db.Timestamptz(6)

  company       Company                         @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  lines         OperationsPurchaseRequestLine[]
  receipts      OperationsPurchaseReceipt[]
  custodyEvents OperationsCustodyEvent[]

  @@unique([id, tenantId, companyId])
  @@unique([companyId, requestNumber])
  @@index([tenantId, companyId, status, businessDate])
}

model OperationsPurchaseRequestLine {
  id                String                     @id @default(uuid()) @db.Uuid
  tenantId          String                     @db.Uuid
  companyId         String                     @db.Uuid
  requestId         String                     @db.Uuid
  lineNumber        Int
  rawMaterialItemId String                     @db.Uuid
  requestedUnitId   String                     @db.Uuid
  requestedQuantity Decimal                    @db.Decimal(24, 8)
  baseUnitId        String                     @db.Uuid
  conversionVersionId String?                  @db.Uuid
  requestedBaseQuantity Decimal                 @db.Decimal(24, 8)
  quotedUnitPrice   Decimal?                   @db.Decimal(18, 4)
  quotedLineTotal   Decimal?                   @db.Decimal(18, 4)

  company       Company                         @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  request       OperationsPurchaseRequest       @relation(fields: [requestId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  rawMaterial   OperationsItem                  @relation(fields: [rawMaterialItemId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  requestedUnit OperationsUnit                  @relation("OperationsRequestLineUnit", fields: [requestedUnitId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  baseUnit      OperationsUnit                  @relation("OperationsRequestLineBaseUnit", fields: [baseUnitId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  conversionVersion OperationsItemConversionVersion? @relation("OperationsPurchaseRequestLineConversionVersion", fields: [conversionVersionId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  receiptLines  OperationsPurchaseReceiptLine[]

  @@unique([requestId, lineNumber])
  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, rawMaterialItemId])
}

model OperationsPurchaseReceipt {
  id               String                          @id @default(uuid()) @db.Uuid
  tenantId         String                          @db.Uuid
  companyId        String                          @db.Uuid
  requestId        String                          @db.Uuid
  receiptNumber    String                          @db.VarChar(80)
  receiptSequence  Int
  actualPaymentChannel OperationsPurchasePaymentChannel
  paymentReference String? @db.VarChar(160)
  businessDate     DateTime                        @db.Date
  status           OperationsPurchaseReceiptStatus @default(POSTED)
  notes            String?                         @db.VarChar(1000)
  receivedByUserId String                          @db.Uuid
  receivedAt       DateTime                        @default(now()) @db.Timestamptz(6)
  reversedAt       DateTime?                       @db.Timestamptz(6)
  reversedByUserId String?                         @db.Uuid
  reversalReason   String?                         @db.VarChar(1000)
  createdAt        DateTime                        @default(now()) @db.Timestamptz(6)

  company       Company                         @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  request       OperationsPurchaseRequest       @relation(fields: [requestId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  lines         OperationsPurchaseReceiptLine[]
  custodyEvents OperationsCustodyEvent[]
  inventoryMovements OperationsInventoryMovement[]

  @@unique([id, tenantId, companyId])
  @@unique([companyId, receiptNumber])
  @@unique([requestId, receiptSequence])
  @@index([tenantId, companyId, businessDate, status])
}

model OperationsPurchaseReceiptLine {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  companyId         String   @db.Uuid
  receiptId         String   @db.Uuid
  requestLineId     String?  @db.Uuid
  rawMaterialItemId String   @db.Uuid
  receivedUnitId    String   @db.Uuid
  receivedQuantity  Decimal  @db.Decimal(24, 8)
  actualUnitPrice   Decimal  @db.Decimal(18, 4)
  lineTotal         Decimal  @db.Decimal(18, 4)
  baseUnitId        String   @db.Uuid
  conversionVersionId String? @db.Uuid
  baseQuantity      Decimal  @db.Decimal(24, 8)
  baseUnitCost      Decimal  @db.Decimal(24, 12)

  company      Company                         @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  receipt      OperationsPurchaseReceipt       @relation(fields: [receiptId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  requestLine  OperationsPurchaseRequestLine?  @relation(fields: [requestLineId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  rawMaterial  OperationsItem                  @relation(fields: [rawMaterialItemId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  receivedUnit OperationsUnit                  @relation("OperationsReceiptReceivedUnit", fields: [receivedUnitId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  baseUnit     OperationsUnit                  @relation("OperationsReceiptBaseUnit", fields: [baseUnitId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  conversionVersion OperationsItemConversionVersion? @relation("OperationsPurchaseReceiptLineConversionVersion", fields: [conversionVersionId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@index([tenantId, companyId, rawMaterialItemId])
}

model OperationsCustodyProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @db.Uuid
  companyId           String   @db.Uuid
  representativeName  String   @db.VarChar(160)
  representativePhone String?  @db.VarChar(32)
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)

  company Company @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([companyId])
  @@unique([companyId, tenantId])
}

model OperationsCustodyEvent {
  id              String                    @id @default(uuid()) @db.Uuid
  tenantId        String                    @db.Uuid
  companyId       String                    @db.Uuid
  requestId       String?                   @db.Uuid
  receiptId       String?                   @db.Uuid
  eventNumber     String                    @db.VarChar(80)
  eventType       OperationsCustodyEventType
  amountDelta     Decimal                   @db.Decimal(18, 4)
  balanceAfter    Decimal                   @db.Decimal(18, 4)
  businessDate    DateTime                  @db.Date
  effectiveAt     DateTime                  @default(now()) @db.Timestamptz(6)
  notes           String?                   @db.VarChar(1000)
  createdByUserId String                    @db.Uuid

  company Company                     @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  request OperationsPurchaseRequest?  @relation(fields: [requestId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  receipt OperationsPurchaseReceipt?  @relation(fields: [receiptId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([companyId, eventNumber])
  @@index([tenantId, companyId, effectiveAt])
}

model OperationsInventoryBalance {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  companyId         String   @db.Uuid
  rawMaterialItemId String   @db.Uuid
  baseQuantity      Decimal  @default(0) @db.Decimal(24, 8)
  totalValue        Decimal  @default(0) @db.Decimal(18, 4)
  weightedUnitCost  Decimal  @default(0) @db.Decimal(26, 12)
  updatedAt         DateTime @updatedAt @db.Timestamptz(6)

  company     Company         @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  rawMaterial OperationsItem  @relation(fields: [rawMaterialItemId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([companyId, rawMaterialItemId])
  @@unique([rawMaterialItemId, tenantId, companyId])
  @@index([tenantId, companyId, rawMaterialItemId])
}

model OperationsInventoryMovement {
  id                    String                         @id @default(uuid()) @db.Uuid
  tenantId              String                         @db.Uuid
  companyId             String                         @db.Uuid
  rawMaterialItemId     String                         @db.Uuid
  receiptId             String?                        @db.Uuid
  movementNumber        String                         @db.VarChar(80)
  movementType          OperationsInventoryMovementType
  baseQuantityDelta     Decimal                        @db.Decimal(24, 8)
  valueDelta            Decimal                        @db.Decimal(18, 4)
  quantityAfter         Decimal                        @db.Decimal(24, 8)
  valueAfter            Decimal                        @db.Decimal(18, 4)
  weightedUnitCostAfter Decimal                        @db.Decimal(26, 12)
  businessDate          DateTime                       @db.Date
  effectiveAt           DateTime                       @default(now()) @db.Timestamptz(6)
  createdByUserId       String                         @db.Uuid

  company     Company                    @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  rawMaterial OperationsItem             @relation(fields: [rawMaterialItemId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  receipt     OperationsPurchaseReceipt? @relation(fields: [receiptId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)


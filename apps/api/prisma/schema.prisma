generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum CompanyStatus {
  ACTIVE
  ARCHIVED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum IdempotencyReceiptStatus {
  IN_PROGRESS
  COMPLETED
}

enum FileMetadataStatus {
  RESERVED
  SUPERSEDED
}

enum FinanceAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum FinanceAccountStatus {
  ACTIVE
  ARCHIVED
}

enum FinanceCategoryKind {
  PURCHASE
  EXPENSE
  SALE
}

enum FinanceCategoryStatus {
  ACTIVE
  ARCHIVED
}

enum FinanceSupplierStatus {
  ACTIVE
  ARCHIVED
}

enum FinanceSupplierType {
  PURCHASE
  EXPENSE
}

enum FinanceFiscalPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum FinanceVaultType {
  CASH
  BANK
  APP
}

enum FinanceVaultPaymentMethod {
  CASH
  BANK_TRANSFER
  BANK_CARD
  BANK_PAYMENT
  APP
}

enum FinanceVaultStatus {
  ACTIVE
  ARCHIVED
}

/// A control observation, not an accounting source. Differences remain visible
/// for investigation and never change a vault or ledger balance automatically.
enum FinanceVaultReconciliationKind {
  BANK_RECONCILIATION
  CASH_COUNT
}

enum FinanceVaultReconciliationStatus {
  MATCHED
  VARIANCE
}

enum FinanceSupplierDueStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum FinanceSupplierDuePaymentStatus {
  POSTED
  REVERSED
}

enum FinanceJournalEntryStatus {
  POSTED
  REVERSED
}

/// A version is drafted and approved as an immutable accounting-policy
/// snapshot. A later policy replaces it; it never rewrites the prior version.
enum FinancePnlMappingVersionStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

/// The future P&L is deliberately presented by nature, not inferred from a
/// mutable operational category or from cash movement.
enum FinancePnlPresentationNature {
  REVENUE
  COST_OF_SALES
  OPERATING_INCOME
  OPERATING_EXPENSE
  INVESTING
  FINANCING
  INCOME_TAX
  DISCONTINUED_OPERATIONS
}

/// Determines the sign of a mapped account within its statement line. This
/// remains explicit even when the account's normal balance is obvious.
enum FinancePnlPresentationSign {
  CREDIT_NATURE
  DEBIT_NATURE
}

/// A run is immutable evidence of the source boundary used by a report.
/// Expiry only controls operational availability; it never permits rewriting.
enum ReportRunStatus {
  READY
  EXPIRED
}

/// A cash-performance event is a source-backed management fact, never a
/// substitute for the ledger or the formal P&L account mapping.
enum FinanceCashPerformanceEventKind {
  SALES_COLLECTION
  PURCHASE_PAYMENT
  OPERATING_EXPENSE_PAYMENT
  VAT_PAYMENT
  VAT_REFUND
}

enum FinanceCashPerformanceDirection {
  INFLOW
  OUTFLOW
}


enum FinanceVatSettlementKind {
  PAYMENT
  REFUND
}

enum FinanceVatSettlementStatus {
  POSTED
  REVERSED
}

enum FinanceOperationalDayStatus {
  OPEN
  CLOSED
  PARTIAL
}

enum FinanceOperationalDaySource {
  MANUAL
  HOLIDAY
  MIGRATION
}

enum FinanceDailySalesClosingScope {
  MORNING
  EVENING
  ALL
}

enum FinanceDailySalesClosingStatus {
  POSTED
  REVERSED
}

enum FinanceDailySalesDataStatus {
  RECORDED
  PENDING
  CLOSED
}

enum FinanceRecurringExpenseStatus {
  ACTIVE
  ARCHIVED
}

enum FinanceOutflowDocumentKind {
  PURCHASE
  EXPENSE
}

enum FinanceOutflowDocumentStatus {
  POSTED
  CANCELLED
}

enum FinanceOutflowSettlementKind {
  PAID
  PAYABLE
}

enum FinanceInclusiveLoanStatus {
  ACTIVE
  SETTLED
  ARCHIVED
}

enum FinanceInclusiveLoanPaymentStatus {
  POSTED
  REVERSED
}

enum HrEmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  ARCHIVED
}

/// Leave is an operational HR record. It never posts a financial entry or
/// changes compensation; a return only records the employee's actual first
/// working day back.
enum HrEmployeeLeaveType {
  ANNUAL
  SICK
  UNPAID
  OTHER
}

enum HrEmployeeLeaveStatus {
  APPROVED
  RETURNED
}

enum HrEmployeeServiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

/// Operational compliance state. It is deliberately separate from the
/// financial-document state above: a service may be costed and still remain
/// the employee's currently active compliance record.
enum HrEmployeeServiceComplianceStatus {
  ACTIVE
  RENEWED
  CANCELLED
}

enum HrEmployeeFinancialMovementType {
  SERVICE_COST
  PAYROLL_ACCRUAL
  PAYROLL_PAYMENT
  ADVANCE_ISSUED
  ADVANCE_SETTLEMENT
  FINAL_SETTLEMENT_ACCRUAL
  FINAL_SETTLEMENT_PAYMENT
}

enum HrFinalSettlementStatus {
  DRAFT
  APPROVED
  PARTIALLY_PAID
  PAID
  REVERSED
  CANCELLED
}

enum HrFinalSettlementReason {
  EMPLOYER_TERMINATION
  RESIGNATION
  ARTICLE_80
  ARTICLE_81
  FORCE_MAJEURE
  MATERNITY
  OTHER_LEGAL_REVIEW
}

enum HrFinalSettlementReasonVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum HrFinalSettlementRecoveryType {
  ADVANCE
  ADMINISTRATIVE_DEDUCTION
}

/// An employee advance is an asset until it is repaid or settled through an
/// approved payroll. It is deliberately not a disciplinary deduction.
enum HrEmployeeAdvanceStatus {
  ISSUED
  PARTIALLY_SETTLED
  SETTLED
  REVERSED
}

enum HrEmployeeAdvanceSettlementSource {
  PAYROLL
  FINAL_SETTLEMENT
  MANUAL_RECEIPT
}

/// A payroll-only deduction that never represents repayment of an advance.
enum HrEmployeeAdministrativeDeductionStatus {
  OPEN
  PARTIALLY_APPLIED
  APPLIED
  DEFERRED
  CANCELLED
}

enum HrEmployeeAdministrativeDeductionActionType {
  CREATED
  DEFERRED
  CANCELLED
  APPLIED
  REVERSED
}

/// Payroll is intentionally lifecycle-based: a draft has no financial effect,
/// approval posts the accrued entitlement, and payments settle the payable.
enum HrPayrollRunStatus {
  DRAFT
  APPROVED
  PARTIALLY_PAID
  PAID
  REVERSED
}

/// Fixed monthly salary, or an agreement whose single total includes overtime.
enum HrCompensationMethod {
  FIXED_MONTHLY
  INCLUSIVE_OVERTIME
}

/// V1 pays a full monthly agreement only. New hires in the payroll month need
/// an explicit operator inclusion and are recorded as such on the line.
enum HrPayrollLineEligibilityCode {
  FULL_MONTH_V1
  FULL_MONTH_ON_LEAVE_EXCEPTION_V1
  PRORATED_NEW_HIRE_V1
}

/// Server-owned payroll calculation treatment snapshot for a line. It is
/// distinct from the company compensation-policy version referenced by it.
enum HrPayrollCalculationFormulaCode {
  FULL_MONTH_V1
  PRORATED_NEW_HIRE_V1
}

enum HrDocumentBlobStatus {
  STAGED
  READY
  QUARANTINED
  REVOKED
}

enum HrEmployeeDocumentType {
  NATIONAL_ID
  IQAMA
  PASSPORT
  EMPLOYMENT_CONTRACT
  MEDICAL_INSURANCE
  HEALTH_CERTIFICATE
  QUALIFICATION
  OTHER
}

enum HrEmployeeDocumentStatus {
  ACTIVE
  REVOKED
}

enum HrEmployeeLetterType {
  SALARY_CERTIFICATE
  SERVICE_CERTIFICATE
}

enum HrEmployeeLetterStatus {
  ISSUED
  REVOKED
}

/// Formula selection is server-owned. Legal-calculation catalogues are outside
/// V1; a policy version only authorises a stable internal formula revision.
enum HrCompensationFormulaCode {
  STANDARD_MONTHLY_V1
}

enum HrCompensationPolicyVersionStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum AiProviderKind {
  OPENAI_COMPATIBLE
  ANTHROPIC
  GOOGLE_GENERATIVE_AI
}

enum AiProviderConfigurationStatus {
  ACTIVE
  DISABLED
}

enum AiCompanyIdentityStatus {
  ACTIVE
  ARCHIVED
}

enum AiExecutionOutcome {
  SUCCEEDED
  FAILED
  BLOCKED
}

enum OperationsUnitDimension {
  COUNT
  MASS
  VOLUME
  PACKAGE
}

enum OperationsItemKind {
  RAW_MATERIAL
  MENU_PRODUCT
}

enum OperationsItemStatus {
  ACTIVE
  ARCHIVED
}

enum OperationsConversionVersionStatus {
  PUBLISHED
  SUPERSEDED
}

enum OperationsAssetWarrantyStatus {
  ACTIVE
  ARCHIVED
}

enum OperationsRecipeVersionStatus {
  PUBLISHED
  SUPERSEDED
}

enum OperationsPurchaseExecutionKind {
  LOCAL
  DELEGATED
}

enum OperationsPurchasePaymentChannel {
  CUSTODY
  CASH
  BANK_TRANSFER
}

enum OperationsPurchaseRequestStatus {
  PENDING_RECEIPT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  REVERSED
}

enum OperationsPurchaseReceiptStatus {
  POSTED
  REVERSED
}

enum OperationsCustodyEventType {
  FUNDING
  PURCHASE
  RETURN
  REVERSAL
}

enum OperationsInventoryMovementType {
  RECEIPT
  REVERSAL
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(160)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  users                     User[]
  companies                 Company[]
  roles                     Role[]
  sessions                  AppSession[]
  audits                    AuditEvent[]
  idempotencyReceipts       IdempotencyReceipt[]
  documentSerialCounters    DocumentSerialCounter[]
  fileMetadata              FileMetadata[]
  reportDocuments           ReportDocument[]
  administrationAssignments TenantAdministrationAssignment[]
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  tenantId          String     @db.Uuid
  loginNormalized   String     @db.VarChar(254)
  nameAr            String     @db.VarChar(160)
  nameEn            String     @db.VarChar(160)
  preferredLanguage String     @default("ar") @db.VarChar(2)
  avatarKind        String     @default("INITIALS") @db.VarChar(16)
  passwordHash      String     @db.VarChar(255)
  status            UserStatus @default(ACTIVE)
  sessionVersion    Int        @default(0)
  createdAt         DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(6)

  tenant                             Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships                        CompanyMembership[]
  sessions                           AppSession[]
  auditEvents                        AuditEvent[]
  idempotencyReceipts                IdempotencyReceipt[]
  createdFileMetadata                FileMetadata[]                   @relation("FileMetadataCreator")
  createdJournalEntries              FinanceJournalEntry[]
  createdReportRuns                  ReportRun[]
  createdReportDocuments             ReportDocument[] @relation("ReportDocumentCreator")
  cashPerformanceCoverageActivations FinanceCashPerformanceCoverage[] @relation("FinanceCashPerformanceCoverageActivator")
  cashPerformanceHistoricalImports   FinanceCashPerformanceHistoricalImport[] @relation("FinanceCashPerformanceHistoricalImportCreator")
  tenantAdministrationAssignments    TenantAdministrationAssignment[]

  @@unique([tenantId, loginNormalized])
  @@unique([id, tenantId])
  @@index([tenantId, status])
}

model Company {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  nameAr           String        @db.VarChar(160)
  nameEn           String        @db.VarChar(160)
  businessTimezone String        @default("Asia/Riyadh") @db.VarChar(64)
  status           CompanyStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)

  tenant                                   Tenant                                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships                              CompanyMembership[]
  audits                                   AuditEvent[]
  idempotencyReceipts                      IdempotencyReceipt[]
  documentSerialCounters                   DocumentSerialCounter[]
  fileMetadata                             FileMetadata[]
  financeProfile                           CompanyFinanceProfile?
  financeAccounts                          FinanceAccount[]
  financeCategories                        FinanceCategory[]
  financeSuppliers                         FinanceSupplier[]
  financeFiscalPeriods                     FinanceFiscalPeriod[]
  financeVaults                            FinanceVault[]
  financeVaultReconciliations              FinanceVaultReconciliation[]
  financeSupplierDues                      FinanceSupplierDue[]
  financeSupplierDuePayments               FinanceSupplierDuePayment[]
  financeJournalEntries                    FinanceJournalEntry[]
  financeJournalLines                      FinanceJournalLine[]
  recurringExpenseProfiles                 FinanceRecurringExpenseProfile[]
  recurringExpenseCoverages                FinanceRecurringExpenseCoverage[]
  inclusiveLoans                           FinanceInclusiveLoan[]
  inclusiveLoanPayments                    FinanceInclusiveLoanPayment[]
  inclusiveLoanInstallments                FinanceInclusiveLoanInstallmentPlan[]
  operationalDays                          FinanceOperationalDay[]
  dailySalesClosings                       FinanceDailySalesClosing[]
  dailySalesAllocations                    FinanceDailySalesAllocation[]
  dailyFinancialSummaries                  FinanceDailyFinancialSummary[]
  dailySalesChannelSummaries               FinanceDailySalesChannelSummary[]
  outflowDocuments                         FinanceOutflowDocument[]
  outflowBatches                           FinanceOutflowBatch[]
  pnlMappingVersions                       FinancePnlMappingVersion[]
  pnlStatementLines                        FinancePnlStatementLine[]
  pnlAccountMappings                       FinancePnlAccountMapping[]
  ledgerRevision                           FinanceLedgerRevision?
  reportRuns                               ReportRun[]
  reportDocuments                          ReportDocument[]
  cashPerformanceEvents                    FinanceCashPerformanceEvent[]
  cashPerformanceCoverage                  FinanceCashPerformanceCoverage?
  cashPerformanceHistoricalImports         FinanceCashPerformanceHistoricalImport[]
  vatSettlements                           FinanceVatSettlement[]
  hrEmployees                              HrEmployee[]
  hrEmployeeServices                       HrEmployeeService[]
  hrEmployeeFinancialMovements             HrEmployeeFinancialMovement[]
  hrEmployeeAdvances                       HrEmployeeAdvance[]
  hrEmployeeAdvanceAllocations             HrEmployeeAdvancePayoutAllocation[]
  hrEmployeeAdvanceSettlements             HrEmployeeAdvanceSettlement[]
  hrEmployeeAdvanceDeferrals               HrEmployeeAdvanceDeferral[]
  hrEmployeeAdministrativeDeductions       HrEmployeeAdministrativeDeduction[]
  hrEmployeeAdministrativeDeductionActions HrEmployeeAdministrativeDeductionAction[]
  hrEmployeeCompensationProfiles           HrEmployeeCompensationProfile[]
  hrEmployeePromotions                     HrEmployeePromotion[]
  hrCompensationPolicies                   HrCompensationPolicy[]
  hrCompensationPolicyVersions             HrCompensationPolicyVersion[]
  hrEmployeeLeaves                         HrEmployeeLeave[]
  hrPayrollRuns                            HrPayrollRun[]
  hrPayrollLines                           HrPayrollLine[]
  hrPayrollAdvanceApplications             HrPayrollAdvanceApplication[]
  hrPayrollDeductionApplications           HrPayrollAdministrativeDeductionApplication[]
  hrPayrollPayments                        HrPayrollPayment[]
  hrPayrollPaymentAllocations              HrPayrollPaymentAllocation[]
  hrEmployeeDocumentBlobs                  HrEmployeeDocumentBlob[]
  hrEmployeeDocuments                      HrEmployeeDocument[]
  hrEmployeeLetters                        HrEmployeeLetter[]
  hrFinalSettlements                       HrFinalSettlement[]
  aiCompanyIdentities                      AiCompanyIdentity[]
  aiExecutionReceipts                      AiExecutionReceipt[]
  operationsSections                       OperationsSection[]
  operationsUnits                          OperationsUnit[]
  operationsItems                          OperationsItem[]
  operationsItemUnits                      OperationsItemUnit[]
  operationsConversionVersions             OperationsItemConversionVersion[]
  operationsConversionEdges                OperationsItemConversionEdge[]
  operationsRecipeVersions                 OperationsRecipeVersion[]
  operationsRecipeLines                    OperationsRecipeLine[]
  operationsPurchaseRequests               OperationsPurchaseRequest[]
  operationsPurchaseRequestLines           OperationsPurchaseRequestLine[]
  operationsPurchaseReceipts               OperationsPurchaseReceipt[]
  operationsPurchaseReceiptLines           OperationsPurchaseReceiptLine[]
  operationsCustodyProfile                 OperationsCustodyProfile?
  operationsCustodyEvents                  OperationsCustodyEvent[]
  operationsInventoryBalances              OperationsInventoryBalance[]
  operationsInventoryMovements             OperationsInventoryMovement[]
  operationsInternalRegistrations          OperationsInternalRegistration[]
  operationsInternalRegistrationLines      OperationsInternalRegistrationLine[]
  operationsAssetWarrantyAssets            OperationsAssetWarrantyAsset[]
  operationsAssetWarrantyLines             OperationsAssetWarrantyLine[]
  branding                                 CompanyBranding?

  @@unique([id, tenantId])
  @@index([tenantId, status])
}

model TenantAdministrationAssignment {
  tenantId                 String    @db.Uuid
  userId                   String    @db.Uuid
  isOwner                  Boolean   @default(false)
  ownerActivationTokenHash String?   @db.VarChar(255)
  ownerActivationExpiresAt DateTime? @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([tenantId, userId])
  @@index([tenantId, isOwner])
}

model CompanyBranding {
  tenantId           String   @db.Uuid
  companyId          String   @unique @db.Uuid
  logoFileMetadataId String?  @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  company Company @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([tenantId, companyId])
  @@unique([companyId, tenantId])
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  code      String   @db.VarChar(80)
  nameAr    String   @db.VarChar(160)
  nameEn    String   @db.VarChar(160)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  grants      RolePermission[]
  memberships CompanyMembership[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
}

model RolePermission {
  tenantId       String @db.Uuid
  roleId         String @db.Uuid
  permissionCode String @db.VarChar(120)

  role Role @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@index([tenantId, permissionCode])
}

model CompanyMembership {
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  companyId String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user    User    @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)
  company Company @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  role    Role    @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([userId, companyId])
  @@index([tenantId, companyId])
  @@index([tenantId, roleId])
}

model AppSession {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  userId           String        @db.Uuid
  refreshTokenHash String        @db.VarChar(255)
  sessionVersion   Int
  status           SessionStatus @default(ACTIVE)
  expiresAt        DateTime      @db.Timestamptz(6)
  revokedAt        DateTime?     @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, userId, status])
  @@index([expiresAt])
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  companyId   String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(120)
  entityType  String   @db.VarChar(120)
  entityId    String   @db.VarChar(120)
  requestId   String   @db.VarChar(120)
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company? @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actor   User?    @relation(fields: [actorUserId, tenantId], references: [id, tenantId], onDelete: NoAction)

  @@index([tenantId, companyId, createdAt])
  @@index([tenantId, actorUserId, createdAt])
}

model IdempotencyReceipt {
  id              String                   @id @default(uuid()) @db.Uuid
  tenantId        String                   @db.Uuid
  companyId       String                   @db.Uuid
  actorUserId     String                   @db.Uuid
  operation       String                   @db.VarChar(160)
  idempotencyKey  String                   @db.VarChar(255)
  requestHash     String                   @db.Char(64)
  status          IdempotencyReceiptStatus @default(IN_PROGRESS)
  responseStatus  Int?
  responseHeaders Json?
  responseBody    Json?
  createdAt       DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(6)
  expiresAt       DateTime                 @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actor   User    @relation(fields: [actorUserId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, companyId, actorUserId, operation, idempotencyKey])
  @@index([tenantId, companyId, expiresAt])
}

model DocumentSerialCounter {
  tenantId     String   @db.Uuid
  companyId    String   @db.Uuid
  series       String   @db.VarChar(80)
  businessDate DateTime @db.Date
  lastValue    BigInt   @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([tenantId, companyId, series, businessDate])
}

model FileMetadata {
  id                     String             @id @db.Uuid
  tenantId               String             @db.Uuid
  companyId              String             @db.Uuid
  sourceType             String             @db.VarChar(80)
  sourceId               String             @db.Uuid
  purpose                String             @db.VarChar(80)
  version                Int
  status                 FileMetadataStatus @default(RESERVED)
  displayName            String             @db.VarChar(240)
  declaredMimeType       String             @db.VarChar(127)
  declaredByteSize       BigInt
  declaredSha256         String             @db.Char(64)
  storageReference       String             @unique @db.VarChar(255)
  replacesFileMetadataId String?            @db.Uuid
  supersededAt           DateTime?          @db.Timestamptz(6)
  createdByUserId        String             @db.Uuid
  createdAt              DateTime           @default(now()) @db.Timestamptz(6)

  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company              Company                 @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy            User                    @relation("FileMetadataCreator", fields: [createdByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  replaces             FileMetadata?           @relation("FileMetadataVersionLineage", fields: [replacesFileMetadataId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  supersededBy         FileMetadata[]          @relation("FileMetadataVersionLineage")
  employeeDocumentBlob HrEmployeeDocumentBlob?

  @@unique([id, tenantId, companyId])
  @@unique([tenantId, companyId, sourceType, sourceId, purpose, version])
  @@index([tenantId, companyId, sourceType, sourceId, purpose, status])
  @@index([tenantId, companyId, declaredSha256])
}

model CompanyFinanceProfile {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @db.Uuid
  companyId              String   @unique @db.Uuid
  baseSeedVersion        Int      @default(1)
  accountingMode         String   @default("management_cash") @db.VarChar(40)
  vatAccountingEnabled   Boolean  @default(false)
  vatRateBasisPoints     Int      @default(1500)
  /// All current finance amounts are implicitly in this single company
  /// currency. Foreign currency, FX revaluation and consolidation are not
  /// supported by the R0-A/R1 reporting policy.
  functionalCurrencyCode String   @default("SAR") @db.Char(3)
  initializedAt          DateTime @default(now()) @db.Timestamptz(6)

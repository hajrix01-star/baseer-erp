  id                  String                                  @id @default(uuid()) @db.Uuid
  tenantId            String                                  @db.Uuid
  companyId           String                                  @db.Uuid
  employeeId          String                                  @db.Uuid
  deductionNumber     String                                  @db.VarChar(80)

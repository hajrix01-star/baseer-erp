/// Company-owned effective-dated P&L mapping policy. It is intentionally
/// separate from FinanceCategory because categories can be operationally
/// edited without restating accounting presentation.
model FinancePnlMappingVersion {
  id               String                         @id @default(uuid()) @db.Uuid
  tenantId         String                         @db.Uuid
  companyId        String                         @db.Uuid
  versionNumber    Int
  status           FinancePnlMappingVersionStatus @default(DRAFT)
  policyVersion    String                         @db.VarChar(80)
  effectiveFrom    DateTime                       @db.Date
  effectiveTo      DateTime?                      @db.Date
  approvedAt       DateTime?                      @db.Timestamptz(6)
  approvedByUserId String?                        @db.Uuid
  checksum         String?                        @db.Char(64)
  createdByUserId  String                         @db.Uuid
  createdAt        DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                       @updatedAt @db.Timestamptz(6)

  company         Company                    @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  statementLines  FinancePnlStatementLine[]
  accountMappings FinancePnlAccountMapping[]

  @@unique([id, tenantId, companyId])
  @@unique([companyId, versionNumber])
  @@index([tenantId, companyId, status, effectiveFrom])
}

/// A line is version-local, so renaming, ordering or changing its nature is a
/// new policy version rather than a reinterpretation of an old P&L.
model FinancePnlStatementLine {
  id                 String                       @id @default(uuid()) @db.Uuid
  tenantId           String                       @db.Uuid
  companyId          String                       @db.Uuid
  mappingVersionId   String                       @db.Uuid
  code               String                       @db.VarChar(80)
  nameAr             String                       @db.VarChar(160)
  nameEn             String                       @db.VarChar(160)

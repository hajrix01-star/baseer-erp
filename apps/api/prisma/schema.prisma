  company       Company                 @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  recipeVersion OperationsRecipeVersion @relation(fields: [recipeVersionId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  rawMaterial   OperationsItem          @relation("OperationsRecipeIngredient", fields: [rawMaterialItemId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  unit          OperationsUnit          @relation("OperationsRecipeLineUnit", fields: [unitId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  financeVaultId String?              @db.Uuid
  financeVault   FinanceVault?        @relation(fields: [financeVaultId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([loanId, installmentNo])
  @@index([tenantId, companyId, loanId, dueDate])
  @@index([tenantId, companyId, financeVaultId])
}


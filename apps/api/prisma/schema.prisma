generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum CompanyStatus {
  ACTIVE
  ARCHIVED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum IdempotencyReceiptStatus {
  IN_PROGRESS
  COMPLETED
}

/// Company archive work is durable. A worker added in the next gate owns every
/// transition after QUEUED; HTTP requests only create and observe these jobs.
enum BackupJobKind {
  COMPANY_ARCHIVE_EXPORT
}

enum BackupJobStatus {
  QUEUED
  PRECHECK
  CONSISTENT_SNAPSHOT
  EXPORT_DATA
  EXPORT_ATTACHMENTS
  PACKAGE_COMPRESS_ENCRYPT
  VERIFY_HASHES
  PUBLISHED
  FAILED
  CANCELLED
}

enum BackupArtifactStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum BackupPolicyFrequency {
  MANUAL
  DAILY
  WEEKLY
  MONTHLY
}

/// Snapshot-bound migration control, never an application import endpoint.
enum LegacyMigrationRunStatus {
  DISCOVERY
  DRY_RUN
  READY_TO_STAGE
  STAGED
  RECONCILED
  FAILED
  CANCELLED
}

enum LegacyMigrationCompanyMapState {
  PLANNED
  APPROVED
}

enum LegacyMigrationRecordMapState {
  PLANNED
  STAGED
  RECONCILED
  EXCLUDED
}

enum LegacyMigrationExceptionSeverity {
  BLOCKER
  REVIEW
  WARNING
}

/// Durable, non-financial intake states for an Excel migration package.
enum NurixExcelStagingPackageStatus {
  RECEIVED
  PARSED
  QUARANTINED
  READY_FOR_RECONCILIATION
  FAILED
}

enum NurixExcelStagingBatchStatus {
  PENDING
  PARSED
  VALIDATED
  QUARANTINED
  FAILED
}

enum NurixExcelStagingRowStatus {
  ACCEPTED
  QUARANTINED
  REJECTED
  SKIPPED
}

/// Lease-backed, non-financial master-data execution states. A failed or
/// interrupted worker can be resumed from its durable item receipts.
enum NurixExcelMasterDataExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// A source master row is never overwritten. An existing Baseer record is
/// either reused when compatible or held for owner review.
enum NurixExcelMasterDataItemStatus {
  PENDING
  CREATED
  REUSED
  REVIEW_REQUIRED
}

/// Financial migration has a separate, approval-gated control plane. Its
/// records retain technical lineage and reconciliation evidence only; a
/// future writer must still create financial facts in its own transaction.
enum NurixExcelFinancialExecutionStatus {
  PENDING
  READY_FOR_APPROVAL
  APPROVED
  RUNNING
  RECONCILING
  COMPLETED
  FAILED
  CANCELLED
}

/// Each committed financial wave is a bounded resume checkpoint.
enum NurixExcelFinancialWaveStatus {
  PENDING
  RUNNING
  COMMITTED
  FAILED
  CANCELLED
}

/// An item receipt is immutable source lineage, never a financial payload.
enum NurixExcelFinancialItemStatus {
  PENDING
  PLANNED
  POSTED
  REUSED
  REVIEW_REQUIRED
  FAILED
  EXCLUDED
}

/// Source-to-target maps are the idempotency boundary for a financial writer.
enum NurixExcelFinancialSourceMapState {
  PLANNED
  APPLIED
  REUSED
  REVERSED
}

enum NurixExcelFinancialReceiptKind {
  DRY_RUN
  WAVE_COMMITTED
  RECONCILIATION
  FAILURE
  CANCELLATION
}

/// A Noorix payroll snapshot is historical evidence, never a Baseer payroll
/// lifecycle state. No value in this enum may be approved, paid, posted, or
/// converted into an employee balance by a financial service.
enum NurixHistoricalPayrollEvidenceStatus {
  EVIDENCE_ONLY
  REVIEW_REQUIRED
}

/// This is evidence about the Noorix source only. It is deliberately not a
/// Baseer payment state and cannot unlock payroll payment or journal posting.
enum NurixHistoricalPayrollPaymentEvidenceKind {
  NONE
  AMOUNT_ONLY
}

/// Availability is a source-evidence statement, never a target financial
/// state. A missing Noorix invoice or journal is explicitly preserved as NONE.
enum NurixHistoricalPayrollAccountingEvidenceAvailability {
  NONE
  PRESENT
}

enum NurixHistoricalPayrollAccountingEvidenceKind {
  PAYROLL_INVOICE
  JOURNAL_ENTRY
  VAULT_ALLOCATION
}

/// A human review record is immutable. It can attest to technically direct
/// candidate maps or acknowledge a blocker, but never changes a source map.
enum LegacyMigrationReviewActionKind {
  APPROVE_DIRECT_CANDIDATES
  APPROVE_COMPANY_MAPS
  ACKNOWLEDGE_EXCEPTION
}

/// A source supplier may be resolved to a tenant-wide counterparty identity
/// before its company-specific FinanceSupplier record is ever created.
enum LegacyMigrationCounterpartyResolutionKind {
  EXPLICIT_ALIAS
  MANUAL
}

/// Minimal source-facing staging queue for an owner to review a supplier
/// identity. It never represents an imported FinanceSupplier or a balance.
enum LegacyMigrationCounterpartyCandidateKind {
  EXPLICIT_ALIAS
  REVIEW_REQUIRED
}

enum FileMetadataStatus {

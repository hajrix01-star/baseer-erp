model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(160)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  users                                  User[]
  companies                              Company[]
  roles                                  Role[]
  sessions                               AppSession[]
  audits                                 AuditEvent[]
  idempotencyReceipts                    IdempotencyReceipt[]
  documentSerialCounters                 DocumentSerialCounter[]
  fileMetadata                           FileMetadata[]
  reportDocuments                        ReportDocument[]
  administrationAssignments              TenantAdministrationAssignment[]
  inboundEvidenceLabels                  InboundEvidenceLabel[]
  inboundEvidenceRules                   InboundEvidenceRule[]
  inboundEvidenceCommands                InboundEvidenceCommandReceipt[]
  inboundEvidenceGmailConnection         InboundEvidenceGmailConnection?
  inboundEvidenceOAuthStates             InboundEvidenceGmailOAuthState[]
  inboundEvidenceMessages                InboundEvidenceMessage[]
  inboundEvidenceAttachments             InboundEvidenceAttachment[]
  inboundEvidenceDocumentAnalyses        InboundEvidenceDocumentAnalysis[]
  ownerDailyBriefSnapshots               OwnerDailyBriefSnapshot[]
  backupPolicies                         BackupPolicy[]
  backupJobs                             BackupJob[]
  backupArtifacts                        BackupArtifact[]
  backupAuditEvents                      BackupAuditEvent[]
  legacyMigrationRuns                    LegacyMigrationRun[]
  legacyMigrationCompanyMaps             LegacyMigrationCompanyMap[]
  legacyMigrationRecordMaps              LegacyMigrationRecordMap[]
  legacyMigrationExceptions              LegacyMigrationException[]
  legacyMigrationReviewActions           LegacyMigrationReviewAction[]
  legacyMigrationCounterpartyResolutions LegacyMigrationCounterpartyResolution[]
  legacyMigrationCounterpartyCandidates  LegacyMigrationCounterpartyCandidate[]
  nurixExcelStagingPackages              NurixExcelStagingPackage[]
  nurixExcelStagingBatches               NurixExcelStagingBatch[]
  nurixExcelStagingRows                  NurixExcelStagingRow[]
  nurixExcelMasterDataExecutions         NurixExcelMasterDataExecution[]
  nurixExcelMasterDataItems              NurixExcelMasterDataItem[]
  nurixExcelFinancialExecutions          NurixExcelFinancialExecution[]
  nurixExcelFinancialWaves               NurixExcelFinancialWave[]
  nurixExcelFinancialItems               NurixExcelFinancialItem[]
  nurixExcelFinancialSourceMaps          NurixExcelFinancialSourceMap[]
  nurixExcelFinancialReceipts            NurixExcelFinancialReceipt[]
  noorixSourceAnnotations                NoorixSourceAnnotation[]
  financeCounterpartyIdentities          FinanceCounterpartyIdentity[]
  financeCounterpartyAliases             FinanceCounterpartyAlias[]
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  tenantId          String     @db.Uuid
  loginNormalized   String     @db.VarChar(254)
  nameAr            String     @db.VarChar(160)
  nameEn            String     @db.VarChar(160)
  preferredLanguage String     @default("ar") @db.VarChar(2)
  avatarKind        String     @default("INITIALS") @db.VarChar(16)
  passwordHash      String     @db.VarChar(255)
  status            UserStatus @default(ACTIVE)
  sessionVersion    Int        @default(0)
  createdAt         DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(6)

  tenant                             Tenant                                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships                        CompanyMembership[]
  sessions                           AppSession[]
  auditEvents                        AuditEvent[]
  idempotencyReceipts                IdempotencyReceipt[]
  createdFileMetadata                FileMetadata[]                           @relation("FileMetadataCreator")
  createdJournalEntries              FinanceJournalEntry[]
  outflowDocumentRevisions           FinanceOutflowDocumentRevision[]
  createdReportRuns                  ReportRun[]
  createdReportDocuments             ReportDocument[]                         @relation("ReportDocumentCreator")
  createdVatSimulations              VatSimulation[]                          @relation("VatSimulationCreator")
  updatedVatSimulations              VatSimulation[]                          @relation("VatSimulationUpdater")
  cashPerformanceCoverageActivations FinanceCashPerformanceCoverage[]         @relation("FinanceCashPerformanceCoverageActivator")
  cashPerformanceHistoricalImports   FinanceCashPerformanceHistoricalImport[] @relation("FinanceCashPerformanceHistoricalImportCreator")
  tenantAdministrationAssignments    TenantAdministrationAssignment[]
  approvedAiCompanyContexts          AiCompanyContext[]                       @relation("AiCompanyContextApprover")
  approvedAiSkillActivations         AiSkillActivation[]                      @relation("AiSkillActivationApprover")
  suspendedAiSkillActivations        AiSkillActivation[]                      @relation("AiSkillActivationSuspender")
  aiEvaluationFeedback               AiEvaluationFeedback[]
  aiSkillEvaluationRuns              AiSkillEvaluationRun[]
  requestedBackupJobs                BackupJob[]                              @relation("BackupJobRequester")
  createdBackupPolicies              BackupPolicy[]                           @relation("BackupPolicyCreator")
  backupAuditEvents                  BackupAuditEvent[]
  initiatedLegacyMigrationRuns       LegacyMigrationRun[]                     @relation("LegacyMigrationRunCreator")
  legacyMigrationReviewActions       LegacyMigrationReviewAction[]            @relation("LegacyMigrationReviewActionCreator")
  requestedNurixExcelFinancialExecutions NurixExcelFinancialExecution[]       @relation("NurixExcelFinancialExecutionRequester")
  approvedNurixExcelFinancialExecutions  NurixExcelFinancialExecution[]       @relation("NurixExcelFinancialExecutionApprover")
  createdNurixExcelFinancialReceipts     NurixExcelFinancialReceipt[]         @relation("NurixExcelFinancialReceiptCreator")

  @@unique([tenantId, loginNormalized])

/// Immutable issue record for money paid to an employee before payroll. The
/// residual is updated only by a settlement/reversal transaction and never by
/// a generic HR deduction.
model HrEmployeeAdvance {
  id                  String                  @id @default(uuid()) @db.Uuid
  tenantId            String                  @db.Uuid
  companyId           String                  @db.Uuid
  employeeId          String                  @db.Uuid
  advanceNumber       String                  @db.VarChar(80)
  businessDate        DateTime                @db.Date
  originalAmount      Decimal                 @db.Decimal(18, 4)
  settledAmount       Decimal                 @default(0) @db.Decimal(18, 4)
  remainingAmount     Decimal                 @db.Decimal(18, 4)
  status              HrEmployeeAdvanceStatus @default(ISSUED)
  nextSettlementDate  DateTime?               @db.Date
  notes               String?                 @db.VarChar(2000)
  issueJournalEntryId String                  @db.Uuid
  createdByUserId     String                  @db.Uuid
  createdAt           DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                @updatedAt @db.Timestamptz(6)

  company             Company                             @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  employee            HrEmployee                          @relation(fields: [employeeId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  issueJournalEntry   FinanceJournalEntry                 @relation("HrEmployeeAdvanceIssueJournal", fields: [issueJournalEntryId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  allocations         HrEmployeeAdvancePayoutAllocation[]
  settlements         HrEmployeeAdvanceSettlement[]
  deferrals           HrEmployeeAdvanceDeferral[]
  payrollApplications HrPayrollAdvanceApplication[]

  @@unique([id, tenantId, companyId])
  @@unique([companyId, advanceNumber])
  @@unique([issueJournalEntryId, tenantId, companyId])
  @@index([tenantId, companyId, employeeId, status, businessDate, id])
  @@index([tenantId, companyId, status, businessDate, id])
}

/// Supports a split payment from multiple company vaults/methods while keeping
/// one advance and one balanced journal entry.
model HrEmployeeAdvancePayoutAllocation {
  id            String                    @id @default(uuid()) @db.Uuid
  tenantId      String                    @db.Uuid
  companyId     String                    @db.Uuid
  advanceId     String                    @db.Uuid
  vaultId       String                    @db.Uuid
  amount        Decimal                   @db.Decimal(18, 4)
  paymentMethod FinanceVaultPaymentMethod
  createdAt     DateTime                  @default(now()) @db.Timestamptz(6)

  company Company           @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  advance HrEmployeeAdvance @relation(fields: [advanceId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  vault   FinanceVault      @relation(fields: [vaultId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([advanceId, vaultId, paymentMethod])
  @@index([tenantId, companyId, vaultId, createdAt])
}

/// Reserved now for a later payroll/manual-receipt settlement flow. Each row
/// will point to the actual posting rather than changing the issue itself.
model HrEmployeeAdvanceSettlement {
  id             String                            @id @default(uuid()) @db.Uuid
  tenantId       String                            @db.Uuid
  companyId      String                            @db.Uuid
  advanceId      String                            @db.Uuid
  source         HrEmployeeAdvanceSettlementSource
  businessDate   DateTime                          @db.Date
  amount         Decimal                           @db.Decimal(18, 4)
  journalEntryId String?                           @db.Uuid
  createdAt      DateTime                          @default(now()) @db.Timestamptz(6)

  company      Company              @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  advance      HrEmployeeAdvance    @relation(fields: [advanceId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  journalEntry FinanceJournalEntry? @relation(fields: [journalEntryId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, advanceId, businessDate, id])
  @@index([tenantId, companyId, journalEntryId])
}

/// A controlled repayment-date change for an outstanding advance. It is a
/// collection plan only and never creates a journal entry or an HR deduction.
model HrEmployeeAdvanceDeferral {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  companyId       String   @db.Uuid
  advanceId       String   @db.Uuid
  businessDate    DateTime @db.Date
  deferredUntil   DateTime @db.Date
  reason          String   @db.VarChar(1000)
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  company Company           @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  advance HrEmployeeAdvance @relation(fields: [advanceId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, advanceId, businessDate, id])
  @@index([tenantId, companyId, deferredUntil])
}

/// A free-text administrative deduction. It is applied only by a future,
/// approved payroll run; creating, deferring, or cancelling it never posts.
model HrEmployeeAdministrativeDeduction {
  id                 String                                  @id @default(uuid()) @db.Uuid
  tenantId           String                                  @db.Uuid
  companyId          String                                  @db.Uuid
  employeeId         String                                  @db.Uuid
  deductionNumber    String                                  @db.VarChar(80)
  businessDate       DateTime                                @db.Date
  originalAmount     Decimal                                 @db.Decimal(18, 4)
  appliedAmount      Decimal                                 @default(0) @db.Decimal(18, 4)
  remainingAmount    Decimal                                 @db.Decimal(18, 4)
  status             HrEmployeeAdministrativeDeductionStatus @default(OPEN)
  plannedPayrollDate DateTime?                               @db.Date
  description        String                                  @db.VarChar(1000)
  cancellationReason String?                                 @db.VarChar(1000)
  cancelledAt        DateTime?                               @db.Timestamptz(6)
  createdByUserId    String                                  @db.Uuid
  createdAt          DateTime                                @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                                @updatedAt @db.Timestamptz(6)

  company             Company                                       @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  employee            HrEmployee                                    @relation(fields: [employeeId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  actions             HrEmployeeAdministrativeDeductionAction[]
  payrollApplications HrPayrollAdministrativeDeductionApplication[]

  @@unique([id, tenantId, companyId])
  @@unique([companyId, deductionNumber])
  @@index([tenantId, companyId, employeeId, status, businessDate, id])
  @@index([tenantId, companyId, status, plannedPayrollDate])
  @@index([tenantId, companyId, status, businessDate, id], map: "HrEmpDed_status_date_id_idx")
}

/// Immutable history for a deduction. Payroll will append APPLY/REVERSE rows;
/// planning actions never create a financial posting.
model HrEmployeeAdministrativeDeductionAction {
  id                 String                                      @id @default(uuid()) @db.Uuid
  tenantId           String                                      @db.Uuid
  companyId          String                                      @db.Uuid
  deductionId        String                                      @db.Uuid
  actionType         HrEmployeeAdministrativeDeductionActionType
  businessDate       DateTime                                    @db.Date
  amount             Decimal?                                    @db.Decimal(18, 4)

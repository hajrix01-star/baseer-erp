generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum CompanyStatus {
  ACTIVE
  ARCHIVED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum IdempotencyReceiptStatus {
  IN_PROGRESS
  COMPLETED
}

enum FileMetadataStatus {
  RESERVED
  SUPERSEDED
}

enum FinanceAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum FinanceAccountStatus {
  ACTIVE
  ARCHIVED
}

enum FinanceCategoryKind {
  PURCHASE
  EXPENSE
  SALE
}

enum FinanceCategoryStatus {
  ACTIVE
  ARCHIVED
}

enum FinanceSupplierStatus {
  ACTIVE
  ARCHIVED
}

enum FinanceSupplierType {
  PURCHASE
  EXPENSE
}

enum FinanceFiscalPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum FinanceVaultType {
  CASH
  BANK
  APP
}

enum FinanceVaultPaymentMethod {
  CASH
  BANK_TRANSFER
  BANK_CARD
  BANK_PAYMENT
  APP
}

enum FinanceVaultStatus {
  ACTIVE
  ARCHIVED
}

enum FinanceSupplierDueStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum FinanceSupplierDuePaymentStatus {
  POSTED
  REVERSED
}

enum FinanceJournalEntryStatus {
  POSTED
  REVERSED
}

enum FinanceOperationalDayStatus {
  OPEN
  CLOSED
  PARTIAL
}

enum FinanceOperationalDaySource {
  MANUAL
  HOLIDAY
  MIGRATION
}

enum FinanceDailySalesClosingScope {
  MORNING
  EVENING
  ALL
}

enum FinanceDailySalesClosingStatus {
  POSTED
  REVERSED
}

enum FinanceDailySalesDataStatus {
  RECORDED
  PENDING
  CLOSED
}

enum FinanceRecurringExpenseStatus {
  ACTIVE
  ARCHIVED
}

enum FinanceOutflowDocumentKind {
  PURCHASE
  EXPENSE
}

enum FinanceOutflowDocumentStatus {
  POSTED
  CANCELLED
}

enum FinanceOutflowSettlementKind {
  PAID
  PAYABLE
}

enum FinanceInclusiveLoanStatus {
  ACTIVE
  SETTLED
  ARCHIVED
}

enum FinanceInclusiveLoanPaymentStatus {
  POSTED
  REVERSED
}

enum HrEmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  ARCHIVED
}

enum HrEmployeeServiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum HrEmployeeFinancialMovementType {
  SERVICE_COST
  PAYROLL_ACCRUAL
  PAYROLL_PAYMENT
  ADVANCE_ISSUED
  ADVANCE_SETTLEMENT
}

/// An employee advance is an asset until it is repaid or settled through an
/// approved payroll. It is deliberately not a disciplinary deduction.
enum HrEmployeeAdvanceStatus {
  ISSUED
  PARTIALLY_SETTLED
  SETTLED
  REVERSED
}

enum HrEmployeeAdvanceSettlementSource {
  PAYROLL
  MANUAL_RECEIPT
}

/// A payroll-only deduction that never represents repayment of an advance.
enum HrEmployeeAdministrativeDeductionStatus {
  OPEN
  PARTIALLY_APPLIED
  APPLIED
  DEFERRED
  CANCELLED
}

enum AiProviderKind {
  OPENAI_COMPATIBLE
  ANTHROPIC
  GOOGLE_GENERATIVE_AI
}

enum AiProviderConfigurationStatus {
  ACTIVE
  DISABLED
}

enum AiCompanyIdentityStatus {
  ACTIVE
  ARCHIVED
}

enum AiExecutionOutcome {
  SUCCEEDED
  FAILED
  BLOCKED
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(160)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  users                     User[]
  companies                 Company[]
  roles                     Role[]
  sessions                  AppSession[]
  audits                    AuditEvent[]
  idempotencyReceipts       IdempotencyReceipt[]
  documentSerialCounters    DocumentSerialCounter[]
  fileMetadata              FileMetadata[]
  administrationAssignments TenantAdministrationAssignment[]
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  tenantId          String     @db.Uuid
  loginNormalized   String     @db.VarChar(254)
  nameAr            String     @db.VarChar(160)
  nameEn            String     @db.VarChar(160)
  preferredLanguage String     @default("ar") @db.VarChar(2)
  avatarKind        String     @default("INITIALS") @db.VarChar(16)
  passwordHash      String     @db.VarChar(255)
  status            UserStatus @default(ACTIVE)
  sessionVersion    Int        @default(0)
  createdAt         DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @db.Timestamptz(6)

  tenant                          Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships                     CompanyMembership[]
  sessions                        AppSession[]
  auditEvents                     AuditEvent[]
  idempotencyReceipts             IdempotencyReceipt[]
  createdFileMetadata             FileMetadata[]                   @relation("FileMetadataCreator")
  createdJournalEntries           FinanceJournalEntry[]
  tenantAdministrationAssignments TenantAdministrationAssignment[]

  @@unique([tenantId, loginNormalized])
  @@unique([id, tenantId])
  @@index([tenantId, status])
}

model Company {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  nameAr           String        @db.VarChar(160)
  nameEn           String        @db.VarChar(160)
  businessTimezone String        @default("Asia/Riyadh") @db.VarChar(64)
  status           CompanyStatus @default(ACTIVE)
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)

  tenant                       Tenant                                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships                  CompanyMembership[]
  audits                       AuditEvent[]
  idempotencyReceipts          IdempotencyReceipt[]
  documentSerialCounters       DocumentSerialCounter[]
  fileMetadata                 FileMetadata[]
  financeProfile               CompanyFinanceProfile?
  financeAccounts              FinanceAccount[]
  financeCategories            FinanceCategory[]
  financeSuppliers             FinanceSupplier[]
  financeFiscalPeriods         FinanceFiscalPeriod[]
  financeVaults                FinanceVault[]
  financeSupplierDues          FinanceSupplierDue[]
  financeSupplierDuePayments   FinanceSupplierDuePayment[]
  financeJournalEntries        FinanceJournalEntry[]
  financeJournalLines          FinanceJournalLine[]
  recurringExpenseProfiles     FinanceRecurringExpenseProfile[]
  recurringExpenseCoverages    FinanceRecurringExpenseCoverage[]
  inclusiveLoans               FinanceInclusiveLoan[]
  inclusiveLoanPayments        FinanceInclusiveLoanPayment[]
  inclusiveLoanInstallments    FinanceInclusiveLoanInstallmentPlan[]
  operationalDays              FinanceOperationalDay[]
  dailySalesClosings           FinanceDailySalesClosing[]
  dailySalesAllocations        FinanceDailySalesAllocation[]
  dailyFinancialSummaries      FinanceDailyFinancialSummary[]
  dailySalesChannelSummaries   FinanceDailySalesChannelSummary[]
  outflowDocuments             FinanceOutflowDocument[]
  outflowBatches               FinanceOutflowBatch[]
  hrEmployees                  HrEmployee[]
  hrEmployeeServices           HrEmployeeService[]
  hrEmployeeFinancialMovements HrEmployeeFinancialMovement[]
  hrEmployeeAdvances           HrEmployeeAdvance[]
  hrEmployeeAdvanceAllocations HrEmployeeAdvancePayoutAllocation[]
  hrEmployeeAdvanceSettlements HrEmployeeAdvanceSettlement[]
  hrEmployeeAdvanceDeferrals   HrEmployeeAdvanceDeferral[]
  hrEmployeeAdministrativeDeductions HrEmployeeAdministrativeDeduction[]
  aiCompanyIdentities          AiCompanyIdentity[]
  aiExecutionReceipts          AiExecutionReceipt[]
  branding                     CompanyBranding?

  @@unique([id, tenantId])
  @@index([tenantId, status])
}

model TenantAdministrationAssignment {
  tenantId                 String    @db.Uuid
  userId                   String    @db.Uuid
  isOwner                  Boolean   @default(false)
  ownerActivationTokenHash String?   @db.VarChar(255)
  ownerActivationExpiresAt DateTime? @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([tenantId, userId])
  @@index([tenantId, isOwner])
}

model CompanyBranding {
  tenantId           String   @db.Uuid
  companyId          String   @unique @db.Uuid
  logoFileMetadataId String?  @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  company Company @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([tenantId, companyId])
  @@unique([companyId, tenantId])
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  code      String   @db.VarChar(80)
  nameAr    String   @db.VarChar(160)
  nameEn    String   @db.VarChar(160)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  grants      RolePermission[]
  memberships CompanyMembership[]

  @@unique([tenantId, code])
  @@unique([id, tenantId])
}

model RolePermission {
  tenantId       String @db.Uuid
  roleId         String @db.Uuid
  permissionCode String @db.VarChar(120)

  role Role @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@index([tenantId, permissionCode])
}

model CompanyMembership {
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  companyId String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user    User    @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)
  company Company @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  role    Role    @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([userId, companyId])
  @@index([tenantId, companyId])
  @@index([tenantId, roleId])
}

model AppSession {
  id               String        @id @default(uuid()) @db.Uuid
  tenantId         String        @db.Uuid
  userId           String        @db.Uuid
  refreshTokenHash String        @db.VarChar(255)
  sessionVersion   Int
  status           SessionStatus @default(ACTIVE)
  expiresAt        DateTime      @db.Timestamptz(6)
  revokedAt        DateTime?     @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, userId, status])
  @@index([expiresAt])
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  companyId   String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(120)
  entityType  String   @db.VarChar(120)
  entityId    String   @db.VarChar(120)
  requestId   String   @db.VarChar(120)
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company? @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actor   User?    @relation(fields: [actorUserId, tenantId], references: [id, tenantId], onDelete: NoAction)

  @@index([tenantId, companyId, createdAt])
  @@index([tenantId, actorUserId, createdAt])
}

model IdempotencyReceipt {
  id              String                   @id @default(uuid()) @db.Uuid
  tenantId        String                   @db.Uuid
  companyId       String                   @db.Uuid
  actorUserId     String                   @db.Uuid
  operation       String                   @db.VarChar(160)
  idempotencyKey  String                   @db.VarChar(255)
  requestHash     String                   @db.Char(64)
  status          IdempotencyReceiptStatus @default(IN_PROGRESS)
  responseStatus  Int?
  responseHeaders Json?
  responseBody    Json?
  createdAt       DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(6)
  expiresAt       DateTime                 @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actor   User    @relation(fields: [actorUserId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([tenantId, companyId, actorUserId, operation, idempotencyKey])
  @@index([tenantId, companyId, expiresAt])
}

model DocumentSerialCounter {
  tenantId     String   @db.Uuid
  companyId    String   @db.Uuid
  series       String   @db.VarChar(80)
  businessDate DateTime @db.Date
  lastValue    BigInt   @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@id([tenantId, companyId, series, businessDate])
}

model FileMetadata {
  id                     String             @id @db.Uuid
  tenantId               String             @db.Uuid
  companyId              String             @db.Uuid
  sourceType             String             @db.VarChar(80)
  sourceId               String             @db.Uuid
  purpose                String             @db.VarChar(80)
  version                Int
  status                 FileMetadataStatus @default(RESERVED)
  displayName            String             @db.VarChar(240)
  declaredMimeType       String             @db.VarChar(127)
  declaredByteSize       BigInt
  declaredSha256         String             @db.Char(64)
  storageReference       String             @unique @db.VarChar(255)
  replacesFileMetadataId String?            @db.Uuid
  supersededAt           DateTime?          @db.Timestamptz(6)
  createdByUserId        String             @db.Uuid
  createdAt              DateTime           @default(now()) @db.Timestamptz(6)

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company      Company        @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy    User           @relation("FileMetadataCreator", fields: [createdByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  replaces     FileMetadata?  @relation("FileMetadataVersionLineage", fields: [replacesFileMetadataId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  supersededBy FileMetadata[] @relation("FileMetadataVersionLineage")

  @@unique([id, tenantId, companyId])
  @@unique([tenantId, companyId, sourceType, sourceId, purpose, version])
  @@index([tenantId, companyId, sourceType, sourceId, purpose, status])
  @@index([tenantId, companyId, declaredSha256])
}

model CompanyFinanceProfile {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @db.Uuid
  companyId            String   @unique @db.Uuid
  baseSeedVersion      Int      @default(1)
  accountingMode       String   @default("management_cash") @db.VarChar(40)
  vatAccountingEnabled Boolean  @default(false)
  vatRateBasisPoints   Int      @default(1500)
  initializedAt        DateTime @default(now()) @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)

  company Company @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@unique([companyId, tenantId])
  @@index([tenantId, companyId])
}

model FinanceAccount {
  id        String               @id @default(uuid()) @db.Uuid
  tenantId  String               @db.Uuid
  companyId String               @db.Uuid
  code      String               @db.VarChar(80)
  nameAr    String               @db.VarChar(160)
  nameEn    String               @db.VarChar(160)
  type      FinanceAccountType
  systemKey String?              @db.VarChar(80)
  isSystem  Boolean              @default(false)
  status    FinanceAccountStatus @default(ACTIVE)
  createdAt DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt DateTime             @updatedAt @db.Timestamptz(6)

  company      Company              @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  categories   FinanceCategory[]
  vaults       FinanceVault[]
  journalLines FinanceJournalLine[]

  @@unique([id, tenantId, companyId])
  @@unique([companyId, code])
  @@unique([companyId, systemKey])
  @@index([tenantId, companyId, status])
}

model FinanceCategory {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @db.Uuid
  companyId           String                @db.Uuid
  parentId            String?               @db.Uuid
  accountId           String?               @db.Uuid
  suggestedSupplierId String?               @db.Uuid
  code                String                @db.VarChar(80)
  nameAr              String                @db.VarChar(160)
  nameEn              String                @db.VarChar(160)
  kind                FinanceCategoryKind
  status              FinanceCategoryStatus @default(ACTIVE)
  isPosting           Boolean               @default(true)
  sortOrder           Int                   @default(0)
  createdAt           DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(6)

  company                  Company                          @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  account                  FinanceAccount?                  @relation(fields: [accountId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  parent                   FinanceCategory?                 @relation("FinanceCategoryTree", fields: [parentId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  children                 FinanceCategory[]                @relation("FinanceCategoryTree")
  suggestedSupplier        FinanceSupplier?                 @relation("FinanceCategorySuggestedSupplier", fields: [suggestedSupplierId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  suppliers                FinanceSupplier[]
  dues                     FinanceSupplierDue[]
  recurringExpenseProfiles FinanceRecurringExpenseProfile[]
  dailySalesClosings       FinanceDailySalesClosing[]
  outflowDocuments         FinanceOutflowDocument[]
  hrEmployeeServices       HrEmployeeService[]

  @@unique([id, tenantId, companyId])
  @@unique([companyId, code])
  @@index([tenantId, companyId, status, sortOrder])
  @@index([companyId, parentId])
  @@index([tenantId, companyId, suggestedSupplierId])
}

model FinanceSupplier {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @db.Uuid
  companyId       String                @db.Uuid
  categoryId      String?               @db.Uuid
  supplierType    FinanceSupplierType
  nameAr          String                @db.VarChar(160)
  nameEn          String?               @db.VarChar(160)
  phone           String?               @db.VarChar(30)
  taxNumber       String?               @db.VarChar(32)
  isTaxRegistered Boolean               @default(false)
  isFavorite      Boolean               @default(false)
  status          FinanceSupplierStatus @default(ACTIVE)
  createdAt       DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(6)

  company                  Company                          @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  category                 FinanceCategory?                 @relation(fields: [categoryId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  suggestedForCategories   FinanceCategory[]                @relation("FinanceCategorySuggestedSupplier")
  provenance               SupplierCopyProvenance?
  dues                     FinanceSupplierDue[]
  recurringExpenseProfiles FinanceRecurringExpenseProfile[]
  dailySalesClosings       FinanceDailySalesClosing[]
  outflowDocuments         FinanceOutflowDocument[]
  hrEmployeeServices       HrEmployeeService[]

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, status])
  @@index([tenantId, companyId, supplierType, status])
  @@index([tenantId, companyId, isFavorite, status])
  @@index([companyId, taxNumber])
}

model SupplierCopyProvenance {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  companyId        String   @db.Uuid
  targetSupplierId String   @unique @db.Uuid
  sourceCompanyId  String?  @db.Uuid
  sourceSupplierId String?  @db.Uuid
  sourceKind       String   @db.VarChar(40)
  sourceReference  String?  @db.VarChar(160)
  copiedByUserId   String?  @db.Uuid
  copiedAt         DateTime @default(now()) @db.Timestamptz(6)

  targetSupplier FinanceSupplier @relation(fields: [targetSupplierId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([targetSupplierId, tenantId, companyId])
  @@index([tenantId, companyId, sourceKind])
  @@index([tenantId, sourceCompanyId, sourceSupplierId])
}

model FinanceFiscalPeriod {
  id          String                    @id @default(uuid()) @db.Uuid
  tenantId    String                    @db.Uuid
  companyId   String                    @db.Uuid
  nameAr      String                    @db.VarChar(160)
  nameEn      String                    @db.VarChar(160)
  startDate   DateTime                  @db.Date
  endDate     DateTime                  @db.Date
  status      FinanceFiscalPeriodStatus @default(OPEN)
  closedAt    DateTime?                 @db.Timestamptz(6)
  closeReason String?                   @db.VarChar(500)
  lockedAt    DateTime?                 @db.Timestamptz(6)
  createdAt   DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                  @updatedAt @db.Timestamptz(6)

  company        Company               @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  journalEntries FinanceJournalEntry[]

  @@unique([id, tenantId, companyId])
  @@unique([companyId, startDate, endDate])
  @@index([tenantId, companyId, status, startDate, endDate])
}

model FinanceVault {
  id                   String                      @id @default(uuid()) @db.Uuid
  tenantId             String                      @db.Uuid
  companyId            String                      @db.Uuid
  accountId            String                      @db.Uuid
  nameAr               String                      @db.VarChar(160)
  nameEn               String                      @db.VarChar(160)
  type                 FinanceVaultType
  paymentMethod        FinanceVaultPaymentMethod
  paymentMethods       FinanceVaultPaymentMethod[] @default([])
  status               FinanceVaultStatus          @default(ACTIVE)
  isSalesChannel       Boolean                     @default(false)
  isPaymentDestination Boolean                     @default(true)
  sortOrder            Int                         @default(0)
  createdAt            DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                    @updatedAt @db.Timestamptz(6)

  company                    Company                               @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  account                    FinanceAccount                        @relation(fields: [accountId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  supplierDuePayments        FinanceSupplierDuePayment[]
  inclusiveLoanPayments      FinanceInclusiveLoanPayment[]
  inclusiveLoanInstallments  FinanceInclusiveLoanInstallmentPlan[]
  dailySalesAllocations      FinanceDailySalesAllocation[]
  dailyCashObservations      FinanceDailySalesClosing[]            @relation("FinanceDailySalesCashObservationVault")
  dailyCashHandovers         FinanceDailySalesClosing[]            @relation("FinanceDailySalesCashHandoverVault")
  dailySalesChannelSummaries FinanceDailySalesChannelSummary[]
  outflowAllocations         FinanceOutflowAllocation[]
  recurringExpenseDefaults   FinanceRecurringExpenseProfile[]
  employeeAdvanceAllocations HrEmployeeAdvancePayoutAllocation[]

  @@unique([id, tenantId, companyId])
  @@unique([companyId, nameAr])
  @@unique([companyId, accountId])
  @@index([tenantId, companyId, status, sortOrder])
}

model FinanceSupplierDue {
  id                   String                   @id @default(uuid()) @db.Uuid
  tenantId             String                   @db.Uuid
  companyId            String                   @db.Uuid
  supplierId           String                   @db.Uuid
  categoryId           String?                  @db.Uuid
  sourceDocumentNumber String                   @db.VarChar(160)
  originalBusinessDate DateTime                 @db.Date
  dueDate              DateTime?                @db.Date
  originalAmount       Decimal                  @db.Decimal(18, 4)
  paidAmount           Decimal                  @default(0) @db.Decimal(18, 4)
  remainingAmount      Decimal                  @db.Decimal(18, 4)

/// A run is immutable evidence of the source boundary used by a report.
/// Expiry only controls operational availability; it never permits rewriting.
enum ReportRunStatus {
  READY
  EXPIRED
}

enum DecisionDataQualityStatus {
  READY
  NO_DATA
  INCOMPLETE
  STALE

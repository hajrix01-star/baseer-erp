  payrollMonth                  DateTime           @db.Date
  businessDate                  DateTime           @db.Date
  status                        HrPayrollRunStatus @default(DRAFT)
  employeeCount                 Int                @default(0)
  grossAmount                   Decimal            @default(0) @db.Decimal(18, 4)
  advanceSettlementAmount       Decimal            @default(0) @db.Decimal(18, 4)
  administrativeDeductionAmount Decimal            @default(0) @db.Decimal(18, 4)
  netPayableAmount              Decimal            @default(0) @db.Decimal(18, 4)
  paidAmount                    Decimal            @default(0) @db.Decimal(18, 4)
  notes                         String?            @db.VarChar(2000)
  accrualJournalEntryId         String?            @db.Uuid
  approvedAt                    DateTime?          @db.Timestamptz(6)
  reversedAt                    DateTime?          @db.Timestamptz(6)
  reversalReason                String?            @db.VarChar(1000)
  createdByUserId               String             @db.Uuid
  createdAt                     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt                     DateTime           @updatedAt @db.Timestamptz(6)


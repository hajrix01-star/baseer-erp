  company Company                              @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  section OperationsSection                    @relation(fields: [sectionId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  lines   OperationsInternalRegistrationLine[]

  @@unique([id, tenantId, companyId])
  @@unique([companyId, registrationNumber])
  @@index([tenantId, companyId, businessDate])
  @@index([tenantId, companyId, sectionId, businessDate])
}

model OperationsInternalRegistrationLine {
  id                           String   @id @default(uuid()) @db.Uuid
  tenantId                     String   @db.Uuid
  companyId                    String   @db.Uuid
  registrationId               String   @db.Uuid
  lineNumber                   Int
  menuProductItemId            String   @db.Uuid
  unitId                       String   @db.Uuid
  quantity                     Decimal  @db.Decimal(24, 8)
  productNameArSnapshot        String   @db.VarChar(160)
  productNameEnSnapshot        String?  @db.VarChar(160)
  unitNameArSnapshot           String   @db.VarChar(80)
  unitNameEnSnapshot           String?  @db.VarChar(80)
  // Financial snapshot is deliberately stored server-side only; the staff
  // workstation contract remains price-free.
  menuSaleUnitPriceSnapshot    Decimal? @db.Decimal(18, 4)
  lineTotalSnapshot            Decimal? @db.Decimal(18, 4)
  recipeVersionId              String?  @db.Uuid
  recipeOutputQuantitySnapshot Decimal? @db.Decimal(24, 8)

  company       Company                                     @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  registration  OperationsInternalRegistration              @relation(fields: [registrationId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  menuProduct   OperationsItem                              @relation("OperationsInternalRegistrationProduct", fields: [menuProductItemId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  unit          OperationsUnit                              @relation(fields: [unitId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  recipeVersion OperationsRecipeVersion?                    @relation("OperationsInternalRegistrationLineRecipe", fields: [recipeVersionId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  consumptions  OperationsInternalRegistrationConsumption[]

  @@unique([id, tenantId, companyId])
  @@unique([registrationId, lineNumber])
  @@index([tenantId, companyId, menuProductItemId])
  @@index([tenantId, companyId, recipeVersionId])
}

// Immutable component-level consumption generated from a saved internal
// registration. It makes recipe and conversion snapshots explicit without
// exposing raw-material cost to the staff workstation.
model OperationsInternalRegistrationConsumption {
  id                                 String   @id @default(uuid()) @db.Uuid
  tenantId                           String   @db.Uuid
  companyId                          String   @db.Uuid
  registrationLineId                 String   @db.Uuid
  recipeVersionId                    String   @db.Uuid
  recipeLineId                       String   @db.Uuid
  rawMaterialItemId                  String   @db.Uuid
  unitId                             String   @db.Uuid
  baseUnitId                         String   @db.Uuid
  conversionVersionId                String?  @db.Uuid
  recipeQuantitySnapshot             Decimal  @db.Decimal(24, 8)
  recipeResolvedBaseQuantitySnapshot Decimal  @db.Decimal(24, 8)
  consumedBaseQuantity               Decimal  @db.Decimal(24, 8)
  weightedUnitCostSnapshot           Decimal  @db.Decimal(26, 12)
  consumedValue                      Decimal  @db.Decimal(18, 4)
  createdAt                          DateTime @default(now()) @db.Timestamptz(6)

  company           Company                            @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  registrationLine  OperationsInternalRegistrationLine @relation(fields: [registrationLineId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  recipeVersion     OperationsRecipeVersion            @relation("OperationsInternalRegistrationConsumptionRecipe", fields: [recipeVersionId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  recipeLine        OperationsRecipeLine               @relation(fields: [recipeLineId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  rawMaterial       OperationsItem                     @relation("OperationsInternalConsumptionMaterial", fields: [rawMaterialItemId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  unit              OperationsUnit                     @relation("OperationsInternalConsumptionUnit", fields: [unitId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  baseUnit          OperationsUnit                     @relation("OperationsInternalConsumptionBaseUnit", fields: [baseUnitId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  conversionVersion OperationsItemConversionVersion?   @relation(fields: [conversionVersionId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  inventoryMovement OperationsInventoryMovement?

  @@unique([id, tenantId, companyId])
  @@unique([registrationLineId, recipeLineId])
  @@index([tenantId, companyId, rawMaterialItemId], map: "OperationsInternalConsumption_material_idx")
  @@index([tenantId, companyId, recipeVersionId], map: "OperationsInternalConsumption_recipe_idx")
}


  notes                  String?                        @db.VarChar(2000)
  status                 FinanceDailySalesClosingStatus @default(POSTED)
  journalEntryId         String                         @unique @db.Uuid
  sourceSystem           String?                        @db.VarChar(80)
  sourceReference        String?                        @db.VarChar(160)
  sourceChecksum         String?                        @db.VarChar(128)
  createdByUserId        String                         @db.Uuid
  createdAt              DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                       @updatedAt @db.Timestamptz(6)

  company              Company                       @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  journalEntry         FinanceJournalEntry           @relation("FinanceDailySalesClosingJournal", fields: [journalEntryId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  cashObservationVault FinanceVault?                 @relation("FinanceDailySalesCashObservationVault", fields: [cashObservationVaultId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  cashHandoverVault    FinanceVault?                 @relation("FinanceDailySalesCashHandoverVault", fields: [cashHandoverVaultId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  allocations          FinanceDailySalesAllocation[]
  financeCategory      FinanceCategory?              @relation(fields: [financeCategoryId, tenantId, companyId], references: [id, tenantId, companyId])
  financeCategoryId    String?                       @db.Uuid
  financeSupplier      FinanceSupplier?              @relation(fields: [financeSupplierId, tenantId, companyId], references: [id, tenantId, companyId])
  financeSupplierId    String?                       @db.Uuid

  @@unique([id, tenantId, companyId])
  @@unique([journalEntryId, tenantId, companyId])
  @@unique([companyId, businessDate, scope])
  @@index([tenantId, companyId, businessDate, status])
  @@index([tenantId, companyId, businessDate, status, cashHandoverVaultId], map: "FinanceDailySalesClosing_tenant_company_date_handover_idx")
  @@index([tenantId, companyId, businessDate, id], map: "FinanceDailySalesClosing_tenant_company_date_id_idx")
}

model FinanceDailySalesAllocation {

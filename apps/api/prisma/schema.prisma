  id                       String                                    @id @default(uuid()) @db.Uuid
  tenantId                 String                                    @db.Uuid
  companyId                String                                    @db.Uuid
  employeeId               String                                    @db.Uuid
  settlementNumber         String                                    @db.VarChar(80)
  status                   HrFinalSettlementStatus                   @default(DRAFT)
  terminationDate          DateTime                                  @db.Date
  terminationReason        HrFinalSettlementReason
  reasonEvidenceReference  String                                    @db.VarChar(240)
  reasonEvidenceNote       String?                                   @db.VarChar(2000)
  reasonVerificationStatus HrFinalSettlementReasonVerificationStatus @default(PENDING)
  reasonVerifiedAt         DateTime?                                 @db.Timestamptz(6)
  reasonVerifiedByUserId   String?                                   @db.Uuid
  reasonVerificationNote   String?                                   @db.VarChar(2000)
  calculationPolicyVersion String                                    @db.VarChar(40)
  serviceDays              Int
  eosWage                  Decimal                                   @db.Decimal(18, 4)
  fullAwardAmount          Decimal                                   @db.Decimal(18, 4)
  entitlementFactor        Decimal                                   @db.Decimal(10, 8)
  eosAmount                Decimal                                   @db.Decimal(18, 4)
  otherCreditsAmount       Decimal                                   @default(0) @db.Decimal(18, 4)
  recoveryAmount           Decimal                                   @default(0) @db.Decimal(18, 4)
  netPayableAmount         Decimal                                   @db.Decimal(18, 4)
  paidAmount               Decimal                                   @default(0) @db.Decimal(18, 4)
  snapshotJson             Json
  snapshotSha256           String                                    @db.Char(64)
  accrualJournalEntryId    String?                                   @db.Uuid
  approvedAt               DateTime?                                 @db.Timestamptz(6)
  /// Immutable approver of the posted EOS accrual. Kept separately from the
  /// journal actor so segregation-of-duties checks survive later reads.
  approvedByUserId         String?                                   @db.Uuid
  reversedAt               DateTime?                                 @db.Timestamptz(6)
  /// Immutable actor who reversed the unpaid approved settlement.
  reversedByUserId         String?                                   @db.Uuid
  reversalReason           String?                                   @db.VarChar(1000)
  createdByUserId          String                                    @db.Uuid
  createdAt                DateTime                                  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                                  @updatedAt @db.Timestamptz(6)
  company                  Company                                   @relation(fields: [companyId, tenantId], references: [id, tenantId], onDelete: Restrict)
  employee                 HrEmployee                                @relation(fields: [employeeId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  accrualJournal           FinanceJournalEntry?                      @relation("HrFinalSettlementAccrualJournal", fields: [accrualJournalEntryId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)
  recoveries               HrFinalSettlementRecovery[]
  payments                 HrFinalSettlementPayment[]

  @@unique([id, tenantId, companyId])
  @@unique([companyId, settlementNumber])
  @@unique([accrualJournalEntryId, tenantId, companyId])
  @@index([tenantId, companyId, employeeId, status, terminationDate])
  @@index([tenantId, companyId, createdAt, id])
}

model HrFinalSettlementRecovery {

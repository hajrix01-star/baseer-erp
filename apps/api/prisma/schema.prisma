  asset   OperationsAssetWarrantyAsset @relation(fields: [assetId, tenantId, companyId], references: [id, tenantId, companyId], onDelete: Restrict)

  @@unique([id, tenantId, companyId])
  @@index([tenantId, companyId, assetId])
}

model FinanceOutflowBatch {

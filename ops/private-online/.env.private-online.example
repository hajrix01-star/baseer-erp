# Copy this file to .env.private-online. Do not commit the copied file.
# Values below are placeholders, never production credentials.
BASEER_PUBLIC_DOMAIN=replace-with-your-available-domain.example
# Copy the three BASEER_* application image values verbatim from the
# GitHub Actions release-manifest artifact for the approved source commit.
# Do not use a tag (including a commit tag) in this production environment.
# The values below are intentionally non-runnable examples: replace every
# placeholder digest with the exact 64-hex digest before deployment.
BASEER_API_IMAGE=ghcr.io/replace-with-owner/baseer-erp-api@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
BASEER_MIGRATE_IMAGE=ghcr.io/replace-with-owner/baseer-erp-migrate@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
BASEER_WEB_IMAGE=ghcr.io/replace-with-owner/baseer-erp-web@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
# Pin infrastructure images as well; record their approved vendor digests in
# the deployment evidence. They are not built by this repository's CI.
BASEER_POSTGRES_IMAGE=postgres@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
BASEER_CADDY_IMAGE=caddy@sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
BASEER_DB_NAME=baseer_erp
BASEER_DB_APP_USER=baseer_app
BASEER_SYSTEM_TENANT_CODE=baseer-private-system
BASEER_DB_BOOTSTRAP_PASSWORD=replace-with-a-unique-long-secret
BASEER_DB_APP_PASSWORD=replace-with-a-different-unique-long-secret
IDENTITY_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Canonical base64 encoding of exactly 32 random bytes. This encrypts saved
# AI provider credentials; keep it private and unchanged after first use.
AI_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
# Required by attendance PIN lookup/encryption and signed branch QR codes.
ATTENDANCE_PIN_PEPPER=replace-with-a-different-random-secret-of-at-least-32-characters
ATTENDANCE_QR_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
# Keep the privacy-retention job enabled on one API instance. It removes only
# attendance coordinates after fourteen days; attendance events remain intact.
BASEER_ATTENDANCE_LOCATION_RETENTION_SCHEDULER_ENABLED=true
BASEER_BACKUP_TARGET_LABEL=hostinger-daily-server-backup
# Leave both switches false until the archive-worker/restore rehearsal is
# accepted. The directory is created under BASEER_STORAGE_HOST_PATH by the
# server operator; it is not a public download directory.
BASEER_BACKUP_WORKER_ENABLED=false
BASEER_BACKUP_SCHEDULER_ENABLED=false
# BASEER_ARCHIVE_APPLICATION_VERSION=private-online-v1
# BASEER_ARCHIVE_SCHEMA_VERSION=<approved Prisma schema/migration version>
# BASEER_ARCHIVE_KEK_KEYRING_V1={"activeKeyId":"v1","keys":{"v1":"<base64-32-byte-key>"}}
# An absolute path on the same private server. Create its hr/, logos/, inbound/,
# and backup-archives/ children before starting Compose; Docker's runtime user (uid 1000)
# must be able to read and write them. Never point this at a public web root.
BASEER_STORAGE_HOST_PATH=/srv/baseer/storage
# Canonical base64 encoding of exactly 32 random bytes; keep it outside Git.
BASEER_EMPLOYEE_DOCUMENT_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
# Pinned official ClamAV image for the internal scanner network. Record the
# reviewed immutable digest in the host-only environment; no scanner URL is
# exposed or configured from this file.
BASEER_CLAMAV_IMAGE=clamav/clamav@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
# WhatsApp invoice originals are opt-in and use the same scanner endpoint.
# Before switching this to true, create whatsapp-invoices/ below
# BASEER_STORAGE_HOST_PATH with the API runtime's read/write access. The key is
# an independent canonical base64 encoding of exactly 32 random bytes; never
# rotate or replace it without a documented asset-key migration.
BASEER_WAI_ASSET_STORAGE_ENABLED=false
# BASEER_WAI_ASSET_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
BASEER_WAI_ASSET_ENCRYPTION_KEY_VERSION=1
# Personal pilot only. Leave false until WAI storage is enabled, the phone is
# ready to pair, and the pilot runbook has been completed. This is a different
# key from the asset-storage key and must remain in the host-only environment.
BASEER_WAI_BAILEYS_PILOT_ENABLED=false
# BASEER_WAI_SESSION_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Google Business pilot (ARZ only). Keep this switch false during configuration.
# Add the dedicated client ID, client secret, redirect URI and provider-vault key
# to the host-only .env.private-online file; never commit them here. The UUID is
# the Baseer company UUID for ARZ, not a Google account or location identifier.
BASEER_MARKETING_GOOGLE_BUSINESS_PILOT_ENABLED=false
# BASEER_MARKETING_GOOGLE_BUSINESS_PILOT_COMPANY_ID=

# Optional Gmail inbound evidence. Keep false until every variable below is
# configured; when true, the callback must use BASEER_PUBLIC_DOMAIN over HTTPS.
BASEER_GMAIL_OAUTH_ENABLED=false
# BASEER_GMAIL_OAUTH_CLIENT_ID=
# BASEER_GMAIL_OAUTH_CLIENT_SECRET=
# BASEER_GMAIL_OAUTH_REDIRECT_URI=https://replace-with-your-available-domain.example/v1/inbound-evidence/gmail/callback
# BASEER_INBOUND_EVIDENCE_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
# BASEER_INBOUND_EVIDENCE_STORAGE_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

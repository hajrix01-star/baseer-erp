# Copy this file to .env.private-online. Do not commit the copied file.
# Values below are placeholders, never production credentials.
BASEER_PUBLIC_DOMAIN=replace-with-your-available-domain.example
BASEER_RELEASE_TAG=private-online-v1
BASEER_DB_NAME=baseer_erp
BASEER_DB_APP_USER=baseer_app
BASEER_DB_BOOTSTRAP_PASSWORD=replace-with-a-unique-long-secret
BASEER_DB_APP_PASSWORD=replace-with-a-different-unique-long-secret
IDENTITY_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BASEER_BACKUP_TARGET_LABEL=hostinger-daily-server-backup

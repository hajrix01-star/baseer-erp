{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "prisma": false,
  "workspaces": {
    "apps/web": {
      "entry": ["src/main.tsx", "vite.config.ts"],
      "project": ["src/**/*.{ts,tsx}", "!src/**/*.d.ts"]
    },
    "apps/api": {
      "entry": ["src/main.ts", "src/**/*verification.ts"],
      "project": ["src/**/*.ts", "!src/generated/**"]
    },
    "packages/contracts": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  }
}
